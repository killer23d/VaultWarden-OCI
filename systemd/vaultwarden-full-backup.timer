[Unit]
Description=VaultWarden Full Backup Timer Sunday 03:00
# Prevent this timer firing mid-shutdown and interrupting a live
# SQLite WAL checkpoint.
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure.service

[Timer]
# Weekly full backup every Sunday at 03:00.
# Weekday-prefixed form: "Sun *-*-* 03:00:00" is valid systemd calendar syntax.
OnCalendar=Sun *-*-* 03:00:00
# Set to false: a missed weekly full backup is not worth triggering a
# boot-time I/O storm. When Persistent=true and multiple timers fire at
# once after downtime, the Conflicts= rejection on the service units
# triggers spurious OnFailure= notifications for jobs that were not broken.
# Only the daily DB backup warrants persistent catch-up (see db-backup.timer).
Persistent=false
# Ensure Docker is healthy before any boot-triggered catch-up fires.
# Without this, Persistent=true causes an immediate activation on reboot
# which may race against the Docker daemon still starting up.
OnBootSec=2min
# Extended RandomizedDelaySec to 300 s (5 min) for the heaviest job (full
# backup) to give maximum spread after an unclean reboot burst.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
