[Unit]
Description=VaultWarden Full Backup Timer Sunday 03:00
# SY-2: Prevent this timer firing mid-shutdown and interrupting a live
# SQLite WAL checkpoint.
Conflicts=shutdown.target

[Timer]
OnCalendar=Sun *-*-* 03:00:00
Persistent=true
# P2-H: Extended RandomizedDelaySec to 300 s (5 min) for the heaviest
# job (full backup) to give maximum spread after an unclean reboot burst.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
