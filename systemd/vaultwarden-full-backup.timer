[Unit]
Description=VaultWarden Full Backup Timer Sunday 03:00
# Prevent this timer firing mid-shutdown and interrupting a live
# SQLite WAL checkpoint.
After=
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# Weekday-prefixed form: "Sun *-*-* 03:00:00" is valid systemd calendar syntax.
OnCalendar=Sun *-*-* 03:00:00
# Predictable calendar-only scheduling: do not use OnBootSec on calendar timers.
# OnBootSec can fire immediately during `systemctl enable --now` on already-booted
# systems and create noisy install-time backup/maintenance bursts.
# A missed weekly full backup waits for the next Sunday window; manual DR/new-VM
# restores should start backup jobs only after the operator confirms readiness.
Persistent=false
# Extended RandomizedDelaySec to 300 s (5 min) for the heaviest job (full backup)
# while preserving the weekly calendar window.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
