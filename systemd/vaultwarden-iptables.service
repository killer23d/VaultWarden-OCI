# Re-apply VaultWarden NAT and DOCKER-USER rules after Docker starts.
# Docker rebuilds DOCKER-USER on boot, so this unit keeps the firewall policy
# in place. Use `sudo ./setup.sh systemd install` to install it.

[Unit]
Description=VaultWarden iptables NAT and DOCKER-USER rules
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# NOTE: SSH and web brute-force iptables bans are managed by crowdsec-firewall-bouncer, not this service.

# Resolve the project root relative to this unit's installed location.
# utilities/setup-iptables.sh uses SCRIPT_DIR to locate docker-compose.yml,
# so WorkingDirectory must point to the repo root. The script is installed
# flat to /opt/vaultwarden-scripts/ by 'sudo ./setup.sh systemd install'.
WorkingDirectory=/opt/vaultwarden-scripts
ExecStart=/opt/vaultwarden-scripts/setup-firewall.sh --phase iptables
ExecStop=/bin/true

# On failure wait 10 s then retry up to 3 times, in case Docker is still
# initialising its bridge networks during a race at boot.
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Tighten the unit's own privileges — the script itself re-execs via sudo
# if not already root, so we allow that escalation path here.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/xtables.lock

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-iptables

[Install]
WantedBy=multi-user.target
