# Reconcile runtime OCI/Docker firewall state after Docker starts.
# Docker owns bridge forwarding, isolation, and container NAT. This unit only
# removes the OCI FORWARD reject and obsolete VaultWarden exceptions.

[Unit]
Description=VaultWarden Docker firewall runtime reconciliation
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=network-online.target docker.service
Wants=docker.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# iptables uses the host-wide xtables lock under /run. Prepare it before the
# strict filesystem sandbox, matching the existing firewall updater contract.
ExecStartPre=+/usr/bin/touch /run/xtables.lock
ExecStartPre=+/usr/bin/chown root:root /run/xtables.lock
ExecStartPre=+/usr/bin/chmod 0600 /run/xtables.lock
ExecStart=/bin/bash /opt/vaultwarden-scripts/utilities/setup-firewall.sh --phase iptables --auto
ExecStop=/bin/true

# Exit 75 remains the shared operation-lock contention signal. Treat it as a
# service failure here so boot reconciliation retries instead of being skipped.
Restart=on-failure
RestartSec=10s

# The reconciliation script needs only runtime lock/snapshot writes. It does
# not install packages, save persistent firewall state, or write the project tree.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=vaultwarden-oci vaultwarden-iptables
RuntimeDirectoryMode=0750
Environment=TMPDIR=/run/vaultwarden-iptables
ReadWritePaths=/run/xtables.lock /run/lock /run/vaultwarden-oci /run/vaultwarden-iptables

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-iptables

[Install]
WantedBy=multi-user.target
