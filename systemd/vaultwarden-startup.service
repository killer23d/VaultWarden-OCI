[Unit]
Description=VaultWarden-OCI startup - recreate runtime secrets and reconcile containers
Requires=docker.service
After=local-fs.target docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=@PROJECT_STATE_DIR@

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/bin/bash @PROJECT_ROOT@/startup.sh --skip-pull
# Restart is intentionally omitted for this oneshot unit.
# After startup.sh succeeds, RemainAfterExit=yes marks the unit active;
# Docker container recovery is handled by vaultwarden-health.timer
# running maintenance.sh health --fix.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
