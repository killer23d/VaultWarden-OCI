[Unit]
Description=VaultWarden DNS Update Timer hourly
# Prevent this timer firing mid-shutdown.
After=
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# Use explicit hourly form to avoid ambiguity across docs/distributions.
OnCalendar=*-*-* *:00:00
# Calendar-only scheduling avoids immediate DNS update jobs during systemd unit
# installation. The next update naturally runs at the next hourly boundary.
Persistent=false
# RandomizedDelaySec spreads routine DNS updates and prevents simultaneous
# --update-dns invocations competing for the operations lock.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
