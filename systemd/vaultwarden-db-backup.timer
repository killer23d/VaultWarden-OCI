[Unit]
Description=VaultWarden DB Backup Timer daily 04:00
# Prevent this timer firing mid-shutdown and interrupting a live
# SQLite WAL checkpoint.
After=
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service


[Timer]
# Use a single explicit timestamp expression; do not combine shorthand
# calendar aliases with an explicit time in the same OnCalendar directive.
OnCalendar=*-*-* 04:00:00
# Predictable calendar-only scheduling: do not use OnBootSec or persistent
# catch-up on this timer. Either can fire immediately during `systemctl enable
# --now` on an already-booted host and collide with maintenance/full backups.
# A missed DB backup waits for the next 04:00 window; the operator can run a
# manual backup after DR/new-VM restore once storage and services are ready.
Persistent=false
# RandomizedDelaySec spreads routine jobs inside the daily backup window.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
