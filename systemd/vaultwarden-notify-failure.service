[Unit]
Description=VaultWarden Failure Notification
# Shared notifier unit triggered by OnFailure=vaultwarden-notify-failure.service.
# Guard: if the env file is absent systemd logs a clear condition-not-met
# message rather than a cryptic EnvironmentFile load failure.
ConditionPathExists=/etc/vaultwarden/vaultwarden.env

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# W3-C4 FIX: Pass the failed unit name via the systemd specifier %n (unit name).
# %N gives the unescaped unit name. The inline script reads $FAILED_UNIT.
# Previously hardcoded to "unknown-unit"; now set by systemd at trigger time.
Environment=FAILED_UNIT=%N
ExecStart=/bin/bash -c '\
  set -euo pipefail; \
  STATE_DIR="${PROJECT_STATE_DIR:?PROJECT_STATE_DIR not set — check /etc/vaultwarden/vaultwarden.env}"; \
  COOLDOWN_DIR="${STATE_DIR}/.vw-health-alert"; \
  mkdir -p "$COOLDOWN_DIR" 2>/dev/null || true; \
  SAFE_UNIT=$(printf "%%s" "$FAILED_UNIT" | tr -cs "[:alnum:]-" "_"); \
  COOLDOWN_FILE="${COOLDOWN_DIR}/notify_failure_${SAFE_UNIT}.cooldown"; \
  LOCK_FILE="/run/lock/vw-notify-${SAFE_UNIT}.lock"; \
  ( \
    flock -n 9 || exit 0; \
    NOW=$(date +%%s); \
    LAST=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0); \
    if (( NOW - LAST < 3600 )); then exit 0; fi; \
    printf "%%s\n" "$NOW" > "$COOLDOWN_FILE"; \
    LIB_DIR=/opt/vaultwarden-scripts/lib; \
    source "${LIB_DIR}/common.sh"; \
    init_common_lib notify-failure; \
    body=$(printf "A VaultWarden systemd unit failed at %%s.\nReview failed units with:\n  systemctl --failed\n" \
      "$(date)"); \
    send_email "FAILURE: ${FAILED_UNIT} on %H" "${body}" \
      || { touch "${STATE_DIR}/NOTIFY_FAILED_${FAILED_UNIT}" 2>/dev/null || true; }; \
  ) 9>"$LOCK_FILE" \
'
User=root
SyslogIdentifier=vw-notify
TimeoutStartSec=30
TimeoutStopSec=15
# Sandbox hardening: this unit sources library files and makes outbound SMTP
# connections. Restricting its capabilities reduces the blast radius if the
# inline script is compromised.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# ProtectHome=yes is correct here: this unit does not need to read rclone.conf
# or any other home-directory path. The stricter setting is intentional.
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
# NOTE: PROJECT_STATE_DIR is the directory where cooldown stamps and the
# NOTIFY_FAILED sentinel file are written.  In boot-volume mode this is
# /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/vaultwarden-notify-failure.service.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat vaultwarden-notify-failure.service
ReadWritePaths=/var/lib/vaultwarden /run/lock

[Install]
WantedBy=multi-user.target
