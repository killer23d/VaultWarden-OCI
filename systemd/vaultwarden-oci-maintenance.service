[Unit]
Description=VaultWarden-OCI maintenance diagnostics
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=vaultwarden-oci.service
OnFailure=vaultwarden-oci-notify@%n.service

[Service]
Type=oneshot
RuntimeDirectory=vaultwarden-oci
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/vaultwarden-oci/current/vwctl doctor
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultwarden-oci /run/vaultwarden-oci /var/lib/crowdsec/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-oci-maintenance
