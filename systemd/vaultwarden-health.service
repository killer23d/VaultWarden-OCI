[Unit]
Description=VaultWarden Health Monitor
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/health.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
# NOTE: The working directory and ExecStart path must match your actual install
# directory. If you installed to a different location, update both
# WorkingDirectory and ExecStart (and ConditionPathExists in [Unit]) to match.
# Default install path used by setup.sh is /opt/vaultwarden-scripts.
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup-systemd.sh --install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# If maintenance is running, skip this invocation and let the next timer tick
# execute normally. This avoids false-negative health alerts during deep
# maintenance windows without disabling the timer.
ExecCondition=/bin/bash -c '! test -f /tmp/.vw_maintenance.lock'
# --email is intentionally omitted here. Add it once EMAIL_API_TOKEN or
# SMTP credentials are set in /etc/vaultwarden/vaultwarden.env, otherwise
# the service exits 1 on every run (no credentials → email fails → exit 1).
ExecStart=/opt/vaultwarden-scripts/health.sh --fix
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that any user-home paths referenced in .env
# (e.g. RCLONE_CONFIG) remain readable by the service.
ProtectHome=read-only
# ReadWritePaths:
#   /var/lib/vaultwarden  — health check reads DB / data dir
#   /etc/vaultwarden      — reads env file, age key
#   /run/lock             — flock() lock file (ProtectSystem=strict makes /var/lock read-only)
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
TimeoutStartSec=300
TimeoutStopSec=60
# Exit code contract:
#   0 — all checks passed             → success, no notification
#   1 — one or more warnings          → success (non-critical, no OnFailure= noise)
#   2 — one or more failures          → OnFailure= fires, admin is notified
#   3 — first-run / no backup yet     → success (transient state, expected on new install)
#
# Exit 1 is intentionally treated as success here because health.sh exits 1
# for advisory warnings (disk usage approaching threshold, last backup older
# than soft limit, etc.) that do not require immediate admin action.
# Routing exit 1 through OnFailure= would generate spurious failure alerts
# on every routine health run that contains any non-critical finding.
# Exit 2 (hard failures: container down, DB corrupt, key missing) still
# triggers OnFailure= and delivers an alert.
SuccessExitStatus=0 1 3

[Install]
WantedBy=multi-user.target
