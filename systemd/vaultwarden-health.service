[Unit]
Description=VaultWarden Health Monitor
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
# Update these paths if you install the repo somewhere other than
# /opt/vaultwarden-scripts.
WorkingDirectory=/opt/vaultwarden-scripts
# Start even if /etc/vaultwarden/vaultwarden.env is not installed yet;
# maintenance.sh reports missing required values itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# Skip health checks during maintenance so the timer does not raise false failures.
# Uses /run/lock (not /tmp) so the file is visible across PrivateTmp= namespaces.
ExecCondition=/bin/bash -c '! test -f /run/lock/vaultwarden-maintenance.lock'
# Add --email only after alert delivery is configured.
ExecStart=/opt/vaultwarden-scripts/maintenance.sh health --fix
# This unit intentionally runs as root because the current backup/maintenance
# implementation requires root for storage readiness checks, root-owned secrets,
# Docker/system access, or repair operations. Least privilege is enforced through
# systemd sandboxing such as NoNewPrivileges, ProtectSystem=strict,
# ReadWritePaths, PrivateTmp, and RuntimeDirectory.
# Do not add User=/Group= drop-ins unless the called script has been redesigned
# and validated to be non-root-safe.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that any user-home paths referenced in .env
# (e.g. RCLONE_CONFIG) remain readable by the service.
ProtectHome=read-only
# NOTE: SOPS_AGE_KEY_FILE must reside under /etc/vaultwarden/ (or another
# ReadWritePaths entry). Paths under /home/ are read-only with ProtectHome=read-only.
# /run/lock is needed for the flock() lock file (ProtectSystem=strict makes /var/lock read-only).
#
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/vaultwarden-health.service.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat vaultwarden-health.service
#
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock /run/vaultwarden
# RuntimeDirectory instructs systemd to pre-create /run/vaultwarden/ as a
# root-owned runtime directory before ExecStart runs. Scripts detect
# RUNTIME_DIRECTORY (set automatically by systemd) and prefer lock files under
# /run/vaultwarden/ over /run/lock/ for timer-driven invocations.
RuntimeDirectory=vaultwarden
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
TimeoutStartSec=120
TimeoutStopSec=30
# Exit code contract:
#   exit 0 = all checks passed           -> success, no notification
#   exit 1 = one or more warnings        -> success (non-critical, no OnFailure= noise)
#   exit 2 = one or more failures        -> OnFailure= fires, admin is notified
#   exit 3 = first-run / no backup yet   -> success (transient, expected on new install)
#
# Exit 1 is intentionally treated as success because maintenance.sh --health
# exits 1 for advisory warnings that do not require immediate action.
# Exit 2 (hard failures: container down, DB corrupt, key missing) still
# triggers OnFailure= and delivers an alert.
SuccessExitStatus=0 1 3

[Install]
WantedBy=multi-user.target
