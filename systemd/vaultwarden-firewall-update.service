[Unit]
Description=VaultWarden Firewall Update
After=network-online.target docker.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
# FIX-S01: OnFailure= added — firewall update failures now trigger an email
# notification via the shared template unit, consistent with all other
# VaultWarden service units (maintenance, backup, health, dns-update).
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/maintenance.sh --update-firewall
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-firewall
NoNewPrivileges=yes
PrivateTmp=yes
# SY-1: Sandbox hardening — script can only write to its own directories.
# CAP_NET_ADMIN is required for iptables/nftables rules.
ProtectSystem=strict
ProtectHome=yes
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
# Note: /run/lock is not listed — this unit does not use flock().
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# Timeout prevents indefinite hang if Cloudflare API is unreachable.
# A hung unit blocks the systemd activation queue on an unattended server.
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
