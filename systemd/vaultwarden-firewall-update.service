[Unit]
Description=VaultWarden Firewall Rule Update
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/maintenance.sh update-firewall
# Must run as root because UFW rule management requires elevated privileges.
User=root
Group=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-firewall-update
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that any user-home paths referenced in .env
# remain readable by the service.
ProtectHome=read-only
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/<unit>.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat <unit>
TimeoutStartSec=60
TimeoutStopSec=30
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock /run/vaultwarden
RuntimeDirectory=vaultwarden
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
