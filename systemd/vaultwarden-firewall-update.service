[Unit]
Description=VaultWarden Firewall Rule Update
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=network-online.target
Wants=network-online.target
# firewall-update.sh does not exist as a standalone script. Firewall updates
# are implemented in maintenance.sh via --update-firewall. ConditionPathExists
# guards against running if maintenance.sh has not been installed yet.
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup.sh --phase=systemd --install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/maintenance.sh --update-firewall
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-firewall-update
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that any user-home paths referenced in .env
# remain readable by the service.
ProtectHome=read-only
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
