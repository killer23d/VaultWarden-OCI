[Unit]
Description=VaultWarden Maintenance Timer Mon-Sat 02:05
# SY-2: Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target vaultwarden-db-backup.service
# Issue #57: OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# TIMER-2 / BUG-TM1 FIX: Changed from 02:00:00 to 02:05:00 to prevent lock
# collision with vaultwarden-dns-update.timer (fires at :00 each hour).
# Both services call maintenance.sh which acquires the vaultwarden-operations
# lock. The 5-minute offset ensures dns-update has released the lock before
# maintenance attempts to acquire it.
# NOTE: comment previously contained an embedded 'OnCalendar=' substring
# which caused the P5-SD1 validator in setup-systemd.sh to match this comment
# line instead of the directive below, producing a false-positive WARN.
# Fixed by rewording (TIMER-2) and anchoring the grep pattern (TIMER-1).
OnCalendar=Mon-Sat *-*-* 02:05:00
Persistent=true
# P2-H: RandomizedDelaySec spreads post-reboot catch-up burst.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
