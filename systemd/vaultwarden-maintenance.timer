[Unit]
Description=VaultWarden Maintenance Timer Mon-Sat 02:00
# SY-2: Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target

[Timer]
OnCalendar=Mon-Sat *-*-* 02:00:00
Persistent=true
# P2-H: RandomizedDelaySec spreads post-reboot catch-up burst.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
