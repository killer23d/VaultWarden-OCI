[Unit]
Description=VaultWarden Maintenance Timer Mon-Sat 02:05
# SY-2: Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target
# Issue #57: OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# BUG-TM1 FIX: Changed from 02:00:00 to 02:05:00 to prevent lock collision
# with vaultwarden-dns-update.timer (OnCalendar=hourly fires at :00 each hour).
# Both services call maintenance.sh which acquires /run/lock/vaultwarden-
# operations.lock. The 5-minute offset guarantees the dns-update service has
# completed before maintenance attempts to acquire the same lock.
OnCalendar=Mon-Sat *-*-* 02:05:00
Persistent=true
# P2-H: RandomizedDelaySec spreads post-reboot catch-up burst.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
