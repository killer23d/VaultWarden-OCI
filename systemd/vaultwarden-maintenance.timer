[Unit]
Description=VaultWarden Maintenance Timer Daily 02:05
# Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# Offset from :00 to prevent lock collision with vaultwarden-dns-update.timer.
# Both services acquire the operations lock; the 5-minute offset ensures the
# dns-update run completes before maintenance attempts to acquire it.
#
# Changed from Mon-Sat to daily (*-*-*) so that SQLite WAL vacuum and Docker
# image prune run every day, including Sunday — the day the weekly full backup
# fires at 03:00. Without daily maintenance, WAL files and unused images
# accumulate an extra day every week before that backup.
# Overlap with db-backup (04:00) is prevented by Conflicts= in the
# maintenance *service* unit (not here — a Conflicts= on a timer unit
# deactivates the timer itself, which is incorrect).
OnCalendar=*-*-* 02:05:00
# Set to false: maintenance is not critical to catch-up on reboot. When
# Persistent=true, a reboot after extended downtime causes all timers with
# OnBootSec=2min to fire within a narrow window, competing for disk I/O and
# triggering spurious Conflicts= rejections — which fire OnFailure= on services
# that were not actually broken. A missed maintenance window is acceptable.
Persistent=false
# Ensure Docker is healthy before any boot-triggered catch-up fires.
# Without this, Persistent=true causes an immediate activation on reboot
# which may race against the Docker daemon still starting up.
OnBootSec=2min
# RandomizedDelaySec spreads post-reboot catch-up burst.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
