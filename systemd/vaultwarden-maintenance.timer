[Unit]
Description=VaultWarden Maintenance Timer Daily 02:05
# Do not start maintenance during shutdown.
After=
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
# Run after the hourly boundary so DNS updates can finish first.
# Daily maintenance is safe because the service unit still blocks overlap with
# backup jobs.
OnCalendar=*-*-* 02:05:00
# Predictable calendar-only scheduling: do not use OnBootSec on calendar timers.
# OnBootSec can fire immediately during `systemctl enable --now` on already-booted
# systems and create noisy install-time backup/maintenance bursts.
# A missed maintenance run waits for the next daily window; this is safer for
# DR/new-VM restores than automatic boot catch-up.
Persistent=false
# RandomizedDelaySec spreads routine maintenance within the calendar window.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
