[Unit]
Description=VaultWarden Firewall Update Timer Saturday 04:00
# Prevent this timer firing mid-shutdown.
After=
Conflicts=shutdown.target
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
OnCalendar=Sat *-*-* 04:00:00
# Calendar-only scheduling avoids immediate firewall update jobs during systemd
# unit installation. The next update naturally runs at the Saturday window.
Persistent=false
# RandomizedDelaySec spreads routine firewall updates and prevents simultaneous
# --update-firewall invocations competing for the operations lock.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
