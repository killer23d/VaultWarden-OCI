[Unit]
Description=VaultWarden Weekly Full Backup
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/backup.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/backup.sh --type full --full-verification --rclone --email
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-full-backup
NoNewPrivileges=yes
PrivateTmp=yes
# SY-1: Sandbox hardening — script can only write to its own directories.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/vaultwarden-scripts /var/lib/vaultwarden /etc/vaultwarden
OnFailure=vaultwarden-notify-failure@%n.service
# Full backup verification can run long
TimeoutStartSec=7200
