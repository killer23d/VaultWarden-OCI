[Unit]
Description=VaultWarden Weekly Full Backup
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/backup.sh
OnFailure=vaultwarden-notify-failure.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup.sh --phase=systemd --install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# W3-M5 FIX: Removed ExecStartPre that unconditionally deleted the backup lock.
# That created a race condition with concurrent manual backup.sh invocations.
# The flock in backup.sh main() is the authoritative exclusive guard.
# W3-M6 FIX: Add ExecCondition to skip this unit when maintenance is active,
# matching the same guard that vaultwarden-db-backup.service already has.
ExecCondition=/bin/bash -c '! test -f /tmp/.vw_maintenance.lock'
# NOTE: --email is intentionally omitted. Add it back once EMAIL_PROVIDER
# credentials are configured:  sudo systemctl edit vaultwarden-full-backup.service
# Failures are still reported via OnFailure=vaultwarden-notify-failure.service.
# --full-verification decrypts the archive and performs a zstd+tar structural
# integrity check before the offsite rclone sync.
ExecStart=/opt/vaultwarden-scripts/backup.sh run full --rclone --full-verification
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-full-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that RCLONE_CONFIG paths under /home remain
# readable. rclone only reads rclone.conf; it never writes to /home.
ProtectHome=read-only
# NOTE: SOPS_AGE_KEY_FILE must reside under /etc/vaultwarden/ (or another
# ReadWritePaths entry). Paths under /home/ are read-only with ProtectHome=read-only.
# /run/lock needed for flock() lock file (ProtectSystem=strict makes /var/lock read-only).
#
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/<unit>.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat <unit>
#
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock
TimeoutStartSec=7200
TimeoutStopSec=60
# Exit code contract (matches backup.sh):
#   exit 0 = success (backup created, rclone synced)
#   exit 2 = partial success / rclone-skipped (non-fatal; local backup intact)
#            treated as success so OnFailure= is silent
#   exit 1 = fatal (env load failed, age key missing/corrupt, backup or
#            encryption failed) -- triggers OnFailure=
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
