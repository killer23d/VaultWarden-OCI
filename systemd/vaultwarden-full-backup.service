[Unit]
Description=VaultWarden Weekly Full Backup
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
# Wait for the health service so backups never race container startup.
Wants=vaultwarden-health.service
After=vaultwarden-health.service
ConditionPathExists=/opt/vaultwarden-scripts/backup.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Start even if /etc/vaultwarden/vaultwarden.env is not installed yet; backup.sh
# reports missing required values itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# backup.sh owns the shared operation guard. Expected lock contention exits 75
# and is treated as a clean skip by systemd; real backup/rclone failures still
# fail the service.
ExecStart=/opt/vaultwarden-scripts/backup.sh run full --rclone --full-verification
# This unit intentionally runs as root because the current backup/maintenance
# implementation requires root for storage readiness checks, root-owned secrets,
# Docker/system access, or repair operations. Least privilege is enforced through
# systemd sandboxing such as NoNewPrivileges, ProtectSystem=strict,
# ReadWritePaths, PrivateTmp, and RuntimeDirectory.
# Do not add User=/Group= drop-ins unless the called script has been redesigned
# and validated to be non-root-safe.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-full-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that RCLONE_CONFIG paths under /home remain
# readable. rclone only reads rclone.conf; it never writes to /home.
ProtectHome=read-only
# NOTE: SOPS_AGE_KEY_FILE must reside under /etc/vaultwarden/ (or another
# ReadWritePaths entry). Paths under /home/ are read-only with ProtectHome=read-only.
# /run/lock is needed for flock() lock files and /run/vaultwarden-oci for runtime operation state.
#
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/<unit>.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat <unit>
#
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock /run/vaultwarden-oci
# RuntimeDirectory instructs systemd to pre-create /run/vaultwarden-oci/ as a
# root-owned runtime directory before ExecStart runs.
RuntimeDirectory=vaultwarden-oci
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
TimeoutStartSec=7200
TimeoutStopSec=60
# Exit code contract for scheduled runs:
#   exit 0  = success
#   exit 75 = clean skip because another VaultWarden operation holds the lock
#   any other non-zero exit = real failure and triggers OnFailure=
SuccessExitStatus=0 75

[Install]
WantedBy=multi-user.target
