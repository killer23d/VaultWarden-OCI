[Unit]
Description=VaultWarden Failure Notification for %i
DefaultDependencies=no
# Template notifier triggered by OnFailure=vaultwarden-notify-failure@%n.service.
# The instance name (%i) is the failed unit name escaped by systemd.
ConditionPathExists=/opt/vaultwarden-scripts/utilities/notify-failure.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/utilities/notify-failure.sh %i
User=root
SyslogIdentifier=vw-notify
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
# PROJECT_STATE_DIR defaults to /var/lib/vaultwarden in the helper when unset.
# A separate-volume install adds 10-state-dir.conf to append DATA_VOLUME_MOUNT.
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock

[Install]
WantedBy=multi-user.target
