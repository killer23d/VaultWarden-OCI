[Unit]
Description=VaultWarden Health Check Timer every 5 min
# Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target
After=
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure@%n.service

[Timer]
OnCalendar=*:0/5
# Calendar-only scheduling avoids an immediate health job during systemd unit
# installation. The next check naturally runs at the next 5-minute boundary.
Persistent=false
# RandomizedDelaySec prevents every host from firing exactly on the boundary.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
