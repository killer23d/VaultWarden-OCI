[Unit]
Description=VaultWarden Health Check Timer every 5 min
# Prevent this timer firing mid-shutdown.
Conflicts=shutdown.target
After=
# OnFailure on the timer unit catches calendar parse errors or
# systemd activation failures that would otherwise go unnotified.
OnFailure=vaultwarden-notify-failure.service

[Timer]
OnCalendar=*:0/5
Persistent=true
# Ensure Docker is healthy before any boot-triggered catch-up fires.
# Without this, Persistent=true causes an immediate activation on reboot
# which may race against the Docker daemon still starting up.
OnBootSec=2min
# RandomizedDelaySec prevents a zero-jitter health check firing at every boot.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
