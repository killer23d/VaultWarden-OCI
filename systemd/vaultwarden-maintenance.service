[Unit]
Description=VaultWarden Comprehensive Maintenance
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
# Clear only this service's stale lock file left by a prior crash or hard reboot.
# /run/lock is a tmpfs — a file here after reboot is always stale.
# Scoped to avoid racing with backup.sh or restore.sh that may hold their
# own lock files concurrently (e.g. after Persistent=true catch-up).
ExecStartPre=/bin/bash -c 'rm -f /run/lock/vaultwarden-maintenance.lock'
ExecStart=/opt/vaultwarden-scripts/maintenance.sh --comprehensive
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-maintenance
NoNewPrivileges=yes
PrivateTmp=yes
# SY-1: Sandbox hardening — script can only write to its own directories.
ProtectSystem=strict
ProtectHome=yes
# NOTE: SOPS_AGE_KEY_FILE must reside under /etc/vaultwarden/ (or another
# ReadWritePaths entry). Paths under /home/ are inaccessible with ProtectHome=yes.
# /run/lock is needed for the flock() lock file (ProtectSystem=strict makes /var/lock read-only)
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime (defence-in-depth against a
# compromised script overwriting its siblings).
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock
TimeoutStartSec=1800
# Exit 1 = skipped/nothing-to-do; treat as success so OnFailure= is not fired.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
