[Unit]
Description=VaultWarden Maintenance Tasks
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
# Prevent the maintenance *job* from running while a backup is in progress.
# These Conflicts= directives belong on the service unit (not the timer) so
# that only the job execution is gated — not the timer that schedules it.
# A Conflicts= on a .timer unit would deactivate the timer itself whenever
# the conflicting service runs, causing NEXT='-' until a manual restart.
Conflicts=vaultwarden-db-backup.service vaultwarden-full-backup.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup.sh --phase=systemd --install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/maintenance.sh
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-maintenance
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# read-only (not yes) so that any user-home paths referenced in .env
# (e.g. RCLONE_CONFIG) remain readable by the service.
ProtectHome=read-only
# /run/lock needed for flock() lock file
# /opt/vaultwarden-scripts is intentionally excluded: scripts are read+executed
# only and must not be writable at runtime.
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock
TimeoutStartSec=3600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
