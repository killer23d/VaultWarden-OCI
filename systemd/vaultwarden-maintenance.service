[Unit]
Description=VaultWarden Routine Maintenance (cleanup, optimize, health check)
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup.sh systemd install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# UFW and iptables use host-wide lock files under /run. Create them before
# entering the strict filesystem sandbox while preserving existing lock inodes.
ExecStartPre=+/usr/bin/touch /run/ufw.lock /run/xtables.lock
ExecStartPre=+/usr/bin/chown root:root /run/ufw.lock /run/xtables.lock
ExecStartPre=+/usr/bin/chmod 0600 /run/ufw.lock /run/xtables.lock
# maintenance.sh owns the shared operation guard. Expected lock contention exits 75
# and is treated as a clean skip. Real maintenance failures still use the
# script's normal non-zero exits.
ExecStart=/opt/vaultwarden-scripts/maintenance.sh run --comprehensive --email
User=root
Group=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-maintenance
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# /run/lock is needed for flock() lock files and /run/vaultwarden-oci for runtime operation state.
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/<unit>.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat <unit>
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock /run/vaultwarden-oci
# Optional because the recovery directory exists only after an export.
ReadWritePaths=-/root/vaultwarden-recovery
# Embedded crowdsec -t may update database metadata under /var/lib/crowdsec.
# The path is optional so maintenance still starts on hosts without CrowdSec.
ReadWritePaths=-/var/lib/crowdsec
# Comprehensive maintenance also reconciles UFW rules using these exact paths.
ReadWritePaths=/etc/ufw /run/ufw.lock /run/xtables.lock
# RuntimeDirectory instructs systemd to pre-create /run/vaultwarden-oci/ as a
# root-owned runtime directory before ExecStart runs.
RuntimeDirectory=vaultwarden-oci
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
TimeoutStartSec=1800
TimeoutStopSec=60
# Exit code 75 means a scheduled run skipped cleanly because another operation
# held the shared lock. All other non-zero exits remain failures.
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
