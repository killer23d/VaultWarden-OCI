[Unit]
Description=VaultWarden Routine Maintenance (cleanup, optimize, health check)
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
# Leading dash makes the file optional: the service starts even if
# /etc/vaultwarden/vaultwarden.env does not yet exist (e.g. before
# setup.sh systemd install has run). Missing required vars are caught
# and reported by the script itself.
EnvironmentFile=-/etc/vaultwarden/vaultwarden.env
# Scheduled runs hold the shared operations lock before delegating to
# maintenance.sh. Expected lock contention means another restore/backup/update
# is active, so this timer run exits 75 and is treated as a clean skip.
# Real maintenance failures still use the script's normal non-zero exits.
ExecStart=/bin/bash -c 'umask 117; touch /run/lock/vaultwarden-operations.lock; chgrp vaultwarden /run/lock/vaultwarden-operations.lock 2>/dev/null || true; chmod 0660 /run/lock/vaultwarden-operations.lock 2>/dev/null || true; exec 9>/run/lock/vaultwarden-operations.lock; if ! flock -n 9; then echo "Scheduled maintenance skipped: another VaultWarden operation is active."; exit 75; fi; exec /opt/vaultwarden-scripts/maintenance.sh run --comprehensive --email --skip-ops-lock'
User=root
Group=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-maintenance
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# /run/lock needed for the maintenance lock file.
# The first path in ReadWritePaths is the PROJECT_STATE_DIR.  In boot-volume
# mode this is /var/lib/vaultwarden.  In separate-volume mode, setup.sh installs a drop-in at:
#   /etc/systemd/system/<unit>.d/10-state-dir.conf
# that appends the DATA_VOLUME_MOUNT path to ReadWritePaths.
# The base unit file is never modified. To inspect the merged result:
#   systemctl cat <unit>
ReadWritePaths=/var/lib/vaultwarden /etc/vaultwarden /run/lock /run/vaultwarden
# RuntimeDirectory instructs systemd to pre-create /run/vaultwarden/ as a
# root-owned runtime directory before ExecStart runs.
RuntimeDirectory=vaultwarden
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
TimeoutStartSec=1800
TimeoutStopSec=60
# Exit code 75 means a scheduled run skipped cleanly because another operation
# held the shared lock. All other non-zero exits remain failures.
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
