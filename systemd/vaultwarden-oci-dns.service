[Unit]
Description=VaultWarden-OCI Cloudflare DNS synchronization
Documentation=https://github.com/killer23d/VaultWarden-OCI
Wants=network-online.target
After=network-online.target vaultwarden-oci.service
OnFailure=vaultwarden-oci-notify@%n.service

[Service]
Type=oneshot
RuntimeDirectory=vaultwarden-oci
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/vaultwarden-oci/current/vwctl dns update --timer
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultwarden-oci /run/vaultwarden-oci
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-oci-dns
