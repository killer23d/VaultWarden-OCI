[Unit]
Description=VaultWarden Daily DB Backup
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/vaultwarden-scripts/backup.sh
OnFailure=vaultwarden-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
# Clear any stale lock files left by a prior crash or hard reboot.
ExecStartPre=/bin/bash -c 'rm -f /run/lock/vaultwarden-*.lock'
ExecStart=/opt/vaultwarden-scripts/backup.sh --type db --rclone --email
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-db-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# /run/lock is needed for the flock() lock file (ProtectSystem=strict makes /var/lock read-only)
ReadWritePaths=/opt/vaultwarden-scripts /var/lib/vaultwarden /etc/vaultwarden /run/lock
TimeoutStartSec=3600
# Exit 1 = warning (e.g. rclone not configured); treat as success.
SuccessExitStatus=0 1
