[Unit]
Description=VaultWarden DNS Update
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/vaultwarden-scripts/maintenance.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/vaultwarden-scripts
EnvironmentFile=/etc/vaultwarden/vaultwarden.env
ExecStart=/opt/vaultwarden-scripts/maintenance.sh --update-dns
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vw-dns-update
NoNewPrivileges=yes
TimeoutStartSec=120
