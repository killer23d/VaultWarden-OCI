[Unit]
Description=VaultWarden-OCI encrypted recovery backup
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=vaultwarden-oci.service network-online.target
Wants=network-online.target
OnFailure=vaultwarden-oci-notify@%n.service

[Service]
Type=oneshot
RuntimeDirectory=vaultwarden-oci
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/vaultwarden-oci/current/vwctl backup
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultwarden-oci /run/vaultwarden-oci
# Allow root rclone to refresh OAuth tokens while keeping other home paths read-only.
ReadWritePaths=-/root/.config/rclone
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-oci-backup
