#!/usr/bin/env bash
# Test-only compatibility adapter for BSD stat format probes on GNU/Linux.
#
# Some cross-platform fixtures intentionally exercise BSD-style `stat -f`
# formats when emulating macOS behavior. GNU stat also accepts `-f`, but gives
# it filesystem-report semantics and may return success with unrelated output.
# Translate only the exact BSD metadata formats used by the test suite and
# delegate every other invocation unchanged.
set -euo pipefail

readonly REAL_STAT="${VW_TEST_REAL_STAT:-/usr/bin/stat}"

if [[ ! -x "$REAL_STAT" ]]; then
    printf 'test stat adapter: real stat is unavailable at %s\n' "$REAL_STAT" >&2
    exit 127
fi

if "$REAL_STAT" --version 2>/dev/null | grep -q 'GNU coreutils' \
    && (( $# == 3 )) && [[ "$1" == "-f" ]]; then
    case "$2" in
        '%Lp'|'%OLp') exec "$REAL_STAT" -c '%a' "$3" ;;
        '%u')         exec "$REAL_STAT" -c '%u' "$3" ;;
        '%g')         exec "$REAL_STAT" -c '%g' "$3" ;;
        '%m')         exec "$REAL_STAT" -c '%Y' "$3" ;;
        '%Su')        exec "$REAL_STAT" -c '%U' "$3" ;;
        '%Sg')        exec "$REAL_STAT" -c '%G' "$3" ;;
    esac
fi

exec "$REAL_STAT" "$@"
