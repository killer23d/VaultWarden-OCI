# =============================================================================
# DEVELOPMENT OVERRIDE — DO NOT USE IN PRODUCTION                      O-01
# =============================================================================
# This file overrides docker-compose.yml for local development ONLY.
# It relaxes security constraints (read_only, caps, resource limits) to
# ease local debugging. NEVER copy this file to a production server.
# Production: use docker-compose.yml without any override file.
# =============================================================================

# VaultWarden-OCI Development Override Configuration

# This file provides development-friendly overrides that:
# 1. Enable additional logging and debugging
# 2. Add development email testing capabilities
# 3. Expose additional ports for testing
# 4. Reduce security restrictions for easier development

# =============================================================================
# CHANGES FROM BASE docker-compose.yml.example
# =============================================================================
# - mailhog replaced with mailpit (mailhog abandoned since 2022, has CVEs;
#   mailpit is the community-standard drop-in: same ports, ARM64-native)
# - logging: stanzas added to all services (larger caps than prod for
#   debug verbosity, but still bounded to prevent local disk fill)
# - ALL exposed ports now bind to 127.0.0.1 exclusively (not 0.0.0.0)
#   to prevent accidental public exposure of the Caddy Admin API (2019),
#   Mailpit web UI (8025), and debug SMTP (1025/1026) if the OCI VCN
#   Security List is ever misconfigured.
# =============================================================================

services:
  vaultwarden:
    environment:
      # Development overrides
      LOG_LEVEL: debug
      EXTENDED_LOGGING: true
      # FIX [OV-M1]: SHOW_PASSWORD_HINT and SIGNUPS_ALLOWED are development-only
      # settings. A startup assertion guards against accidental use in production.
      # If ENVIRONMENT=production is set, the container will refuse to start.
      SHOW_PASSWORD_HINT: true
      # Allow signups for testing
      SIGNUPS_ALLOWED: true
      # Reduce security for testing
      PASSWORD_ITERATIONS: 100000
    # FIX [OV-M1]: Entrypoint wrapper aborts startup when ENVIRONMENT=production
    # to prevent this override from silently activating in a prod compose chain.
    entrypoint:
      - sh
      - -c
      - |
        if [ "$${ENVIRONMENT:-development}" = "production" ]; then
          echo "ERROR: docker-compose.override.yml.example must NOT be used in production (ENVIRONMENT=production detected). Aborting."
          exit 1
        fi
        exec /start.sh
    # Expose VaultWarden directly for testing (loopback only)
    ports:
      - "127.0.0.1:8080:80"
    # Development volume mounts
    volumes:
      # Allow live editing of web vault for development
      - ./web-vault-dev:/web-vault:ro
    # Remove resource limits for development
    deploy:
      resources: {}
    # LOG CAP: Larger than prod (debug verbosity). 50m x 5 = 250MB max.
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"

  caddy:
    environment:
      # Development logging — bind admin API to loopback only
      CADDY_ADMIN: 127.0.0.1:2019
    # Expose Caddy ports for testing (loopback only)
    ports:
      - "127.0.0.1:8081:80"
      - "127.0.0.1:8443:443"
      - "127.0.0.1:2019:2019"  # Caddy admin API — unauthenticated, loopback only
    # Remove resource limits for development
    deploy:
      resources: {}
    # LOG CAP: Larger than prod (one line per request + debug). 50m x 5 = 250MB max.
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"

  postfix:
    environment:
      # Development SMTP settings - relaxed TLS
      - POSTFIX_smtp_tls_security_level=may  # Allow fallback for dev
      - POSTFIX_smtpd_tls_security_level=may
      - POSTFIX_debug_peer_level=2  # Enhanced debugging
      - POSTFIX_smtp_sasl_auth_enable=yes
    # Expose SMTP port for testing (loopback only)
    ports:
      - "127.0.0.1:1025:587"  # Submission port — loopback only
    # Development volume mounts
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/postfix:/var/log/postfix
    # Remove resource limits for development
    deploy:
      resources: {}
    # Override health check for development
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "587"]
      interval: 10s
      timeout: 5s
      retries: 2
      start_period: 5s
    # LOG CAP: Debug level generates more output than prod. 10m x 5 = 50MB max.
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

  fail2ban:
    environment:
      # Enhanced development logging
      F2B_LOG_LEVEL: DEBUG
      F2B_LOG_TARGET: STDOUT
    # Allow access to fail2ban logs
    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro
      # Development: Mount current directory for live config editing
      - ${PWD}:/workspace:ro
    # Remove resource limits for development
    deploy:
      resources: {}
    # LOG CAP: DEBUG level is very verbose. 50m x 5 = 250MB max.
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"

  # =============================================================================
  # Email testing service (development only)
  # =============================================================================
  email-tester:
    image: alpine:3.19
    container_name: vaultwarden_email_tester
    restart: "no"  # Don't restart automatically
    environment:
      - TZ=${TZ:-UTC}
      - ADMIN_EMAIL=${ADMIN_EMAIL:-test@localhost}
      - SMTP_FROM=${SMTP_FROM:-dev@localhost}
    command: >
      sh -c "
        apk add --no-cache python3 curl netcat-openbsd &&
        cat > /tmp/test-smtp.py << 'PYEOF'
      import smtplib
      from email.mime.text import MIMEText
      from email.mime.multipart import MIMEMultipart
      import sys
      import os
      from datetime import datetime

      def test_postfix():
          try:
              msg = MIMEMultipart()
              msg['From'] = os.environ.get('SMTP_FROM', 'dev@localhost')
              msg['To'] = os.environ.get('ADMIN_EMAIL', 'test@localhost')
              msg['Subject'] = 'VaultWarden-OCI Development Email Test'

              body = f'''This is a development email test from VaultWarden-OCI.

      If you receive this email, the postfix integration is working correctly.

      Test Details:
      - Sent via: postfix container (boky/postfix)
      - Environment: Development
      - Time: {datetime.now()}
      - Container: email-tester
      '''

              msg.attach(MIMEText(body, 'plain'))

              print('Connecting to postfix:587...')
              server = smtplib.SMTP('postfix', 587, timeout=10)
              server.set_debuglevel(1)
              print('Sending email...')
              server.send_message(msg)
              server.quit()

              print('Email sent successfully via postfix!')
              return True
          except Exception as e:
              print(f'Email test failed: {e}', file=sys.stderr)
              import traceback
              traceback.print_exc()
              return False

      if __name__ == '__main__':
          sys.exit(0 if test_postfix() else 1)
      PYEOF
        chmod +x /tmp/test-smtp.py &&
        echo '' &&
        echo '=====================================' &&
        echo 'Email Tester Ready!' &&
        echo '=====================================' &&
        echo '' &&
        echo 'Usage:' &&
        echo '  docker compose exec email-tester python3 /tmp/test-smtp.py' &&
        echo '' &&
        echo 'Test SMTP connectivity:' &&
        echo '  docker compose exec email-tester nc -zv postfix 587' &&
        echo '' &&
        tail -f /dev/null
      "
    networks:
      - vaultwarden
    depends_on:
      - postfix
    profiles:
      - development
      - email-testing
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # =============================================================================
  # Mailpit - Email capture during development (replaces abandoned mailhog)
  # =============================================================================
  # mailhog/mailhog was last updated in 2022 and has known unfixed CVEs.
  # axllent/mailpit is the actively maintained, ARM64-native drop-in replacement.
  # Port mapping is identical — no workflow changes required.
  # Web UI:  http://localhost:8025
  # SMTP:    localhost:1026
  # FIX [OV-L1]: Version is now sourced from MAILPIT_VERSION env var.
  # Add MAILPIT_VERSION=v1.21.6 to .env.example so the version is visible
  # and manageable rather than silently frozen at the inline default forever.
  # =============================================================================
  mailpit:
    image: axllent/mailpit:${MAILPIT_VERSION:-v1.21.6}
    container_name: vaultwarden_mailpit
    restart: unless-stopped
    ports:
      - "127.0.0.1:8025:8025"   # Web UI (loopback only — unauthenticated by default)
      - "127.0.0.1:1026:1025"   # SMTP server (loopback only)
    networks:
      - vaultwarden
    profiles:
      - development
      - email-capture
    environment:
      - MP_DATA_FILE=/data/mailpit.db   # Persistent SQLite storage
      - MP_UI_AUTH_FILE=""              # No auth for dev (set a file path to enable)
      - TZ=${TZ:-UTC}
    volumes:
      - ./dev-mailpit:/data
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: '0.1'
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

# =============================================================================
# DEVELOPMENT PROFILES
# =============================================================================

# Available profiles for different development scenarios:
#
# docker compose --profile development up -d
#   - Adds email-tester service for SMTP testing
#   - Enhanced logging and debugging
#   - Relaxed security settings
#
# docker compose --profile email-testing up -d
#   - Includes email-tester service
#   - Exposes postfix port for external testing
#   - Adds email testing utilities
#
# docker compose --profile email-capture up -d
#   - Adds Mailpit for email capture and inspection
#   - Useful for testing without sending real emails
#   - Web UI at http://localhost:8025 (SSH tunnel required from remote host)

# =============================================================================
# DEVELOPMENT EMAIL TESTING
# =============================================================================

# 1. Start development environment:
#    docker compose --profile development up -d

# 2. Test email functionality:
#    docker compose exec email-tester python3 /tmp/test-smtp.py

# 3. Check postfix logs:
#    docker compose logs -f postfix

# 4. Test SMTP connectivity:
#    docker compose exec email-tester nc -zv postfix 587

# 5. Monitor all email-related logs:
#    docker compose logs -f postfix fail2ban vaultwarden

# 6. Test fail2ban email integration:
#    docker compose exec fail2ban fail2ban-client set vaultwarden-auth banip 192.168.1.100

# 7. Access services (SSH tunnel required from remote host):
#    - VaultWarden:  http://localhost:8080  (ssh -L 8080:localhost:8080 user@host)
#    - Caddy Admin:  http://localhost:2019  (ssh -L 2019:localhost:2019 user@host)
#    - Mailpit UI:   http://localhost:8025  (ssh -L 8025:localhost:8025 user@host)

# =============================================================================
# POSTFIX DEBUGGING
# =============================================================================

# View postfix queue:
#    docker compose exec postfix mailq

# View postfix configuration:
#    docker compose exec postfix postconf -n

# Test postfix connectivity:
#    docker compose exec postfix nc -zv ${SMTP_HOST} ${SMTP_PORT}

# Send test email via postfix command line:
#    docker compose exec postfix sendmail -v your@email.com
#    (Type message, press Ctrl+D to send)

# =============================================================================
# SECURITY NOTES FOR DEVELOPMENT
# =============================================================================

# WARNING: This override file reduces security for development convenience:
# 1. Exposes additional ports (loopback-only — use SSH port-forwarding to access)
# 2. Relaxes TLS certificate checking
# 3. Enables signups
# 4. Reduces password iterations
# 5. Adds debug logging
#
# NEVER use this configuration in production!
# The vaultwarden service entrypoint will abort if ENVIRONMENT=production is detected.
# Always use separate development and production environments.

# =============================================================================
# CLEANUP COMMANDS
# =============================================================================

# Stop development services:
# docker compose --profile development down

# Remove development volumes:
# docker volume prune

# Clean up mailpit data:
# rm -rf dev-mailpit
