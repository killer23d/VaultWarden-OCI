# VaultWarden-OCI Development Override Configuration
# ENHANCED: Added msmtpd development settings for email testing
# Copy this to docker-compose.override.yml for development/testing

# This file provides development-friendly overrides that:
# 1. Enable additional logging and debugging
# 2. Add development email testing capabilities  
# 3. Expose additional ports for testing
# 4. Reduce security restrictions for easier development
# 5. Add email development/testing features

services:
  vaultwarden:
    environment:
      # Development overrides
      LOG_LEVEL: debug
      EXTENDED_LOGGING: true
      SHOW_PASSWORD_HINT: true
      # Allow signups for testing
      SIGNUPS_ALLOWED: true
      # Reduce security for testing
      PASSWORD_ITERATIONS: 100000
    # Expose VaultWarden directly for testing
    ports:
      - "8080:80"
    # Development volume mounts
    volumes:
      # Allow live editing of web vault for development
      - ./web-vault-dev:/web-vault:ro
    # Remove resource limits for development
    deploy:
      resources: {}

  caddy:
    environment:
      # Development logging
      CADDY_ADMIN: 0.0.0.0:2019
    # Expose Caddy admin API
    ports:
      - "8081:80"
      - "8443:443"
      - "2019:2019"  # Caddy admin API
    # Remove resource limits for development
    deploy:
      resources: {}

  fail2ban:
    environment:
      # Enhanced development logging
      F2B_LOG_LEVEL: DEBUG
      F2B_LOG_TARGET: STDOUT
    # Allow access to fail2ban logs
    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro
      # Development: Mount current directory for live config editing
      - ${PWD}:/workspace:ro
    # Remove resource limits for development
    deploy:
      resources: {}

  # ENHANCED: msmtpd development configuration
  msmtpd:
    environment:
      # Development SMTP settings
      - SMTP_HOST=${SMTP_HOST:-smtp.gmail.com}
      - SMTP_PORT=${SMTP_PORT:-587}
      - SMTP_TLS=${SMTP_SECURITY:-on}
      - SMTP_STARTTLS=${SMTP_STARTTLS:-on}
      - SMTP_TLS_CHECKCERT=${SMTP_TLS_CHECKCERT:-off}  # Relaxed for dev
      - SMTP_AUTH=${SMTP_AUTH:-on}
      - SMTP_USER=${SMTP_USERNAME:-}
      - SMTP_PASSWORD_FILE=/run/secrets/smtp_password
      - SMTP_FROM=${SMTP_FROM:-dev@localhost}
      # Development logging
      - MSMTPD_LOG_LEVEL=debug
      - TZ=${TZ:-UTC}
    # Expose SMTP port for testing
    ports:
      - "1025:1025"  # Expose for external email testing
    # Development volume mounts
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/msmtpd:/var/log
      # Development: Add debug volume
      - ./dev-email-tests:/email-tests:rw
    # Remove resource limits for development
    deploy:
      resources: {}
    # Override health check for development
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "1025"]
      interval: 10s
      timeout: 5s
      retries: 2
      start_period: 5s

  # NEW: Email testing service (development only)
  email-tester:
    image: alpine:3.19
    container_name: vaultwarden_email_tester
    restart: "no"  # Don't restart automatically
    environment:
      - TZ=${TZ:-UTC}
      - ADMIN_EMAIL=${ADMIN_EMAIL:-test@localhost}
    command: >
      sh -c "
        apk add --no-cache python3 py3-pip curl netcat-openbsd &&
        echo 'Email tester ready. Use: docker compose exec email-tester python3 /email-tests/test-smtp.py' &&
        tail -f /dev/null
      "
    volumes:
      - ./dev-email-tests:/email-tests:rw
    networks:
      - vaultwarden
    depends_on:
      - msmtpd
    profiles:
      - development
      - email-testing

  # NEW: Mailhog for email capture during development (optional)
  mailhog:
    image: mailhog/mailhog:${MAILHOG_VERSION:-v1.0.1}
    container_name: vaultwarden_mailhog
    restart: unless-stopped
    ports:
      - "8025:8025"  # Web UI
      - "1026:1025"  # SMTP server (alternate port)
    networks:
      - vaultwarden
    profiles:
      - development
      - email-capture
    # For testing email capture instead of real SMTP
    environment:
      - MH_STORAGE=maildir
      - MH_MAILDIR_PATH=/maildir
    volumes:
      - ./dev-mailhog:/maildir
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: '0.1'

# =============================================================================
# DEVELOPMENT PROFILES
# =============================================================================

# Available profiles for different development scenarios:
# 
# docker compose --profile development up -d
#   - Adds email-tester service for SMTP testing
#   - Enhanced logging and debugging
#   - Relaxed security settings
# 
# docker compose --profile email-testing up -d  
#   - Includes email-tester service
#   - Exposes msmtpd port for external testing
#   - Adds email testing utilities
#
# docker compose --profile email-capture up -d
#   - Adds Mailhog for email capture and inspection
#   - Useful for testing without sending real emails
#   - Web UI at http://localhost:8025

