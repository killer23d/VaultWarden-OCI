# VaultWarden-OCI - Development/Testing Overrides
# Override configuration for development, testing, or optional services

version: '3.8'

services:
  # Development overrides
  vaultwarden:
    environment:
      # Enable more verbose logging for development
      LOG_LEVEL: debug
      EXTENDED_LOGGING: true
      # Allow signups for testing
      SIGNUPS_ALLOWED: true
      # Disable some restrictions for testing
      PASSWORD_HINTS_ALLOWED: true
      SHOW_PASSWORD_HINT: true
    # Mount source for development
    # volumes:
    #   - ./dev-data:/data

  caddy:
    environment:
      # Enable Caddy admin for development
      CADDY_ADMIN: "localhost:2019"
    # Expose admin port for development
    # ports:
    #   - "2019:2019"

  fail2ban:
    environment:
      # More verbose logging for development
      F2B_LOG_LEVEL: DEBUG
      # Shorter ban times for testing
      F2B_BANTIME: 300

  # Optional: Add development/testing services
  # Uncomment and modify as needed

