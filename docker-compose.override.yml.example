# =============================================================================
# DEVELOPMENT USAGE EXAMPLES
# =============================================================================

# 1. Start development environment:
#    docker compose --profile development up -d

# 2. Test email functionality:
#    docker compose exec email-tester python3 /email-tests/test-smtp.py

# 3. Test fail2ban email integration:
#    docker compose exec vaultwarden_fail2ban fail2ban-client set vaultwarden-auth banip 192.168.1.100

# 4. Monitor email logs:
#    docker compose logs -f vaultwarden_msmtpd

# 5. Test host script email:
#    ./test-email-simple.sh --verbose

# 6. Access services:
#    - VaultWarden: http://localhost:8080
#    - Caddy Admin: http://localhost:2019
#    - Mailhog UI: http://localhost:8025 (if using email-capture profile)

# =============================================================================
# SECURITY NOTES FOR DEVELOPMENT
# =============================================================================

# WARNING: This override file reduces security for development convenience:
# 1. Exposes additional ports
# 2. Relaxes TLS certificate checking
# 3. Enables signups
# 4. Reduces password iterations
# 5. Adds debug logging
# 
# NEVER use this configuration in production!
# Always use separate development and production environments.

# =============================================================================
# CLEANUP COMMANDS
# =============================================================================

# Stop development services:
# docker compose --profile development down

# Remove development volumes:
# docker volume prune

# Clean up email test files:
# rm -rf dev-email-tests dev-mailhog
