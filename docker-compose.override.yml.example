  #     WATCHTOWER_NOTIFICATION_EMAIL_FROM: watchtower@${DOMAIN}
  #     WATCHTOWER_NOTIFICATION_EMAIL_TO: ${ADMIN_EMAIL}
  #   volumes:
  #     - /var/run/docker.sock:/var/run/docker.sock
  #   networks:
  #     - vaultwarden

  # backup:
  #   container_name: vaultwarden_backup
  #   image: alpine:latest
  #   restart: "no"
  #   environment:
  #     TZ: ${TZ:-UTC}
