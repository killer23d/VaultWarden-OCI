  #     - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/backup/data:ro
  #     - ${PWD}/backups:/backup/output
  #   networks:
  #     - vaultwarden
  #   command: |
  #     sh -c "
  #       apk add --no-cache dcron sqlite &&
  #       echo 'Backup service ready' &&
  #       tail -f /dev/null
