 EOF_SNAPSHOT
 extract_func "$HEALTH" _postfix_sidecar_configured >> "$snapshot_probe"
@@ -1413,15 +1413,35 @@ cat > "$TMP/bin/docker" <<'EOF_DOCKER'
 count=0
 [[ -f "${DOCKER_COUNT:?}" ]] && count="$(cat "$DOCKER_COUNT")"
 printf '%s\n' "$(( count + 1 ))" >"$DOCKER_COUNT"
