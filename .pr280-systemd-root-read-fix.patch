-find "$ENV_DIR" "$UNIT_DIR" "$OPT_DIR" -type f -print0 | sort -z | xargs -0 sha256sum > "$TMP/after.sha"
+hash_fixture_tree "$TMP/after.sha"
 cmp -s "$TMP/before.sha" "$TMP/after.sha" || fail 'second installation was not content-idempotent'
