-printf 'fixture-key\n' > "$ENV_DIR/age-key.txt"
-chmod 0600 "$ENV_DIR/age-key.txt"
-if (( EUID != 0 )); then sudo -n "$(type -P chown)" root:root "$ENV_DIR/age-key.txt"; else chown root:root "$ENV_DIR/age-key.txt"; fi
