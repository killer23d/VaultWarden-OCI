# ⚠️  DEPRECATED — DO NOT USE
#
# This file was the config template for the legacy `crowdsec-cloudflare-bouncer`
# (cs-cloudflare-bouncer), which is no longer actively maintained by CrowdSec
# due to Cloudflare API rate-limit changes that affected firewall rule management.
#
# ── Migration path ────────────────────────────────────────────────────────────
# Use the new Cloudflare Workers-based bouncer instead:
#   New config template: crowdsec/crowdsec-cloudflare-worker-bouncer.yaml.example
#   New binary:          crowdsec-cloudflare-worker-bouncer
#   New repo:            https://github.com/crowdsecurity/cs-cloudflare-worker-bouncer
#   CrowdSec docs:       https://docs.crowdsec.net/u/bouncers/cloudflare-workers
#
# Re-run the setup script to install and configure the new bouncer:
#   sudo ./utilities/setup-crowdsec.sh --force
#
# ─────────────────────────────────────────────────────────────────────────────
# Original template (preserved for reference only — do not deploy):
# ─────────────────────────────────────────────────────────────────────────────

crowdsec_config:
  lapi_url: http://127.0.0.1:8080/
  lapi_key: CHANGE_ME_BOUNCER_KEY

cloudflare_config:
  - id: TOKEN_CF_ACCOUNT_ID
    token: TOKEN_CROWDSEC_CF_FIREWALL_TOKEN
    ip_list_prefix: crowdsec
    default_action: block
    zones:
      - TOKEN_CF_ZONE_ID

log_level: info
log_mode: stdout
