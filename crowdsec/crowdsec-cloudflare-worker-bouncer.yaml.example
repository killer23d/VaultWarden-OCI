# crowdsec/crowdsec-cloudflare-worker-bouncer.yaml.example
#
# Template config for the CrowdSec Cloudflare Workers bouncer
# (crowdsec-cloudflare-worker-bouncer) v0.0.17+.
# This file is read by utilities/setup-crowdsec.sh and rendered into:
#   /etc/crowdsec/bouncers/crowdsec-cloudflare-worker-bouncer.yaml
#
# Placeholders replaced by the setup script:
#   TOKEN_CF_ZONE_ID              <- CLOUDFLARE_ZONE_ID from .env
#   TOKEN_CF_ACCOUNT_ID           <- CF_ACCOUNT_ID from .env
#   TOKEN_CF_WORKER_BOUNCER_TOKEN <- CF_WORKER_BOUNCER_TOKEN secret
#   CHANGE_ME_BOUNCER_KEY         <- auto-generated CrowdSec LAPI key
#   TOKEN_CF_ROUTES_PATTERN       <- wildcard route derived from DOMAIN (.env)
#                                    e.g. DOMAIN=https://vault.example.com
#                                    → *example.com/*
#
# -------------------------------------------------------------------------
# CLOUDFLARE FREE PLAN NOTES
# -------------------------------------------------------------------------
# KV write quota: 1,000 writes/day (free plan)
# Community blocklists can easily contain 10K-100K IPs, which would
# exhaust your daily quota on the first sync.  The only_include_decisions_from
# guard below restricts synced decisions to those generated locally by
# your CrowdSec engine and cscli.  This keeps KV writes well within the
# free-plan limit while still blocking real attackers targeting your host.
# Set CF_FREE_PLAN=false in .env (and re-run setup-crowdsec.sh) to remove
# the restriction if you upgrade to a paid Workers plan.
#
# Worker request quota: 100,000 requests/day (free plan)
# Each inbound HTTP request to your zone triggers one Worker invocation.
# A typical self-hosted Vaultwarden instance is orders of magnitude below
# this limit.
#
# -------------------------------------------------------------------------
# REQUIRED TOKEN PERMISSIONS
# -------------------------------------------------------------------------
# Use 'My Profile -> API Tokens', NOT the legacy Global API Key.
# Scope the token to the specific zone (not All zones) to avoid
# the bouncer -g flag iterating over unrelated zones in your account.
#
#   Account: Workers KV Storage : Edit
#   Account: Workers Scripts    : Edit
#   Account: Account Settings   : Read
#   Account: Turnstile          : Edit
#   Account: D1                 : Edit
#   User:    User Details       : Read
#   Zone:    DNS                : Read  (scope to specific zone)
#   Zone:    Workers Routes     : Edit  (scope to specific zone)
#   Zone:    Zone               : Read  (scope to specific zone)
#
# -------------------------------------------------------------------------

# -- CrowdSec LAPI connection ----------------------------------------------
crowdsec_config:
  lapi_key: CHANGE_ME_BOUNCER_KEY
  lapi_url: http://127.0.0.1:8080/
  update_frequency: 10s
  include_scenarios_containing: []
  exclude_scenarios_containing: []
  only_include_decisions_from: ["cscli", "crowdsec"]
  insecure_skip_verify: false

# -- Cloudflare account/zone structure -------------------------------------
# Schema for crowdsec-cloudflare-worker-bouncer v0.0.17+.
# The token field is required at the account level.
# actions must be a list; supported values: ban, captcha
cloudflare_config:
  accounts:
    - id: TOKEN_CF_ACCOUNT_ID
      token: TOKEN_CF_WORKER_BOUNCER_TOKEN
      account_name: TOKEN_CF_ACCOUNT_EMAIL
      zones:
        - zone_id: TOKEN_CF_ZONE_ID
          # actions: list of enforcement actions. Supported: ban, captcha
          # Use 'ban' for hard block (HTTP 403).
          # Use 'captcha' if you have Turnstile configured.
          actions:
            - ban
          default_action: ban
          # routes_to_protect: wildcard pattern derived from DOMAIN in .env.
          # An empty list [] is treated as "protect no routes" by the bouncer
          # binary — NOT "protect all routes" — so an explicit pattern is
          # required. setup-crowdsec.sh substitutes TOKEN_CF_ROUTES_PATTERN
          # with *<bare-domain>/* at render time (e.g. *example.com/*).
          routes_to_protect:
            - "TOKEN_CF_ROUTES_PATTERN"

log_level: info
log_media: stdout
