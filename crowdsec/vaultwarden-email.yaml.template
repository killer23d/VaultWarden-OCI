# Managed by VaultWarden-OCI: CrowdSec email notification
#
# Source template rendered to /etc/crowdsec/notifications/vaultwarden-email.yaml.
# Do not edit the installed file directly. Edit ADMIN_EMAIL or SMTP_FROM with
# sudo make edit-env, then re-run:
#   sudo ./utilities/setup-crowdsec.sh
# ADMIN_EMAIL and SMTP_FROM must each contain exactly one @ and no whitespace.
# The rendered YAML is parsed in CI and validated with crowdsec -t before install.
type: email
name: vaultwarden_email
log_level: info
group_wait: __GROUP_WAIT__
group_threshold: __GROUP_THRESHOLD__
max_retry: 3
timeout: 20s
connect_timeout: 10s
send_timeout: 10s
format: |
  <pre style="white-space: pre-wrap; font-family: monospace;">
  CrowdSec security event notification (up to 10 alerts and 5 decisions per alert).
  {{ range $alertIndex, $alert := . -}}
  {{ if lt $alertIndex 10 -}}
  Source: {{ if $alert.Source }}{{ $alert.Source.Value | html }}{{ else }}unknown{{ end }}
  Scenario: {{ $alert.Scenario | html }}
  Machine ID: {{ $alert.MachineID | html }}
  {{ range $decisionIndex, $decision := $alert.Decisions -}}
  {{ if lt $decisionIndex 5 -}}
  Decision type: {{ $decision.Type | html }}
  Decision duration: {{ $decision.Duration | html }}
  {{ end -}}
  {{ end -}}
  ---
  {{ end -}}
  {{ end }}
  </pre>
smtp_host: 127.0.0.1
smtp_port: 587
auth_type: none
encryption_type: none
sender_name: CrowdSec
sender_email: __SMTP_FROM__
email_subject: "CrowdSec security event"
receiver_emails:
  - __ADMIN_EMAIL__
