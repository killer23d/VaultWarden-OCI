[Unit]
Description=VaultWarden-OCI V2 lifecycle
Documentation=https://github.com/killer23d/VaultWarden-OCI
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=vaultwarden-oci-notify@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/vaultwarden-oci/current/vwctl start
ExecStop=/opt/vaultwarden-oci/current/vwctl stop
TimeoutStartSec=300
TimeoutStopSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultwarden-oci /run/vaultwarden-oci
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-oci

[Install]
WantedBy=vaultwarden-oci.target
