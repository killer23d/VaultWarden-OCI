[Unit]
Description=VaultWarden-OCI V2 health check
Documentation=https://github.com/killer23d/VaultWarden-OCI
After=vaultwarden-oci.service
OnFailure=vaultwarden-oci-notify@%n.service

[Service]
Type=oneshot
ExecStart=/opt/vaultwarden-oci/current/vwctl status
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultwarden-oci /run/vaultwarden-oci
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaultwarden-oci-health
