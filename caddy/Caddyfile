{
    # Global ACME DNS configuration
    acme_dns cloudflare

    # Global server configuration with automatic Cloudflare IP management
    servers {
        # Trust Cloudflare IPs automatically (updated by caddy-cloudflare-ip module)
        trusted_proxies cloudflare
        # Use the correct Cloudflare connecting IP header
        client_ip_headers Cf-Connecting-Ip X-Forwarded-For
    }
}

{$DOMAIN} {
    # ENHANCED: Improved log retention for forensic analysis with predictable rotation
    log {
        output file /logs/access.log {
            roll_size 50MB
            roll_keep 20
            roll_keep_for 30d
            roll_local_time true
        }
        format json {
            time_format "2006-01-02T15:04:05.000Z07:00"
            message_key "msg"
            level_key "level"
            time_key "timestamp"
            name_key "logger"
            caller_key "caller"
            stacktrace_key "stacktrace"
        }
        level INFO
    }

    # CRITICAL FIX 1: Removed invalid rate_limit block (this was already fixed in your new version)

    # Enhanced security headers with forensic considerations
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
        X-Request-ID {uuid}
        X-Forwarded-Proto https
        -Server
        -X-Powered-By
    }

    # Admin panel protection with enhanced logging
    @admin path /admin*
    handle @admin {
        log {
            output file /logs/admin_access.log {
                roll_size 25MB
                roll_keep 30
                roll_keep_for 90d
                roll_local_time true
            }
            format json {
                time_format "2006-01-02T15:04:05.000Z07:00"
                message_key "admin_access"
            }
            level INFO
        }
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
            X-Admin-Access "true"
        }
        basic_auth {
            admin {file /run/secrets/admin_basic_auth_hash}
        }

        # CRITICAL FIX: Use service name 'vaultwarden' not 'vaultwarden_app' for DNS
        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }

    # ENHANCED: Authentication endpoint monitoring for forensic analysis
    @auth_endpoints path /api/accounts/prelogin* /identity/accounts/prelogin* /identity/connect/token*
    handle @auth_endpoints {
        log {
            output file /logs/auth_attempts.log {
                roll_size 25MB
                roll_keep 30
                roll_keep_for 90d
                roll_local_time true
            }
            format json {
                time_format "2006-01-02T15:04:05.000Z07:00"
                message_key "auth_attempt"
            }
            level INFO
        }

        # CRITICAL FIX: Use service name 'vaultwarden' not 'vaultwarden_app' for DNS
        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up X-Auth-Endpoint "true"
        }
    }

    # Main application with enhanced security monitoring
    handle {
        @malicious_ua 
            header User-Agent *sqlmap* *nikto* *nmap* *acunetix* *dirbuster* *gobuster* *wfuzz*
        handle @malicious_ua {
            log {
                output file /logs/security_blocks.log {
                    roll_size 10MB
                    roll_keep 50
                    roll_keep_for 180d
                    roll_local_time true
                }
                format json {
                    time_format "2006-01-02T15:04:05.000Z07:00"
                    message_key "security_block"
                }
                level WARN
            }
            respond "Access Denied - Security Policy Violation" 403
        }

        # WebSocket support for live sync (uncomment if WEBSOCKET_ENABLED=true in .env)
        # @websocket {
        #     header Connection *Upgrade*
        #     header Upgrade websocket
        #     path /notifications/hub*
        # }
        # handle @websocket {
        #     CRITICAL FIX: Use service name 'vaultwarden' not 'vaultwarden_app' for DNS
        #     reverse_proxy vaultwarden:3012 {
        #         header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
        #         header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        #     }
        # }

        # CRITICAL FIX: Use service name 'vaultwarden' not 'vaultwarden_app' for DNS
        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }
}

# Redirect www subdomain with logging
www.{$DOMAIN} {
    log {
        output file /logs/redirects.log {
            roll_size 10MB
            roll_keep 10
            roll_local_time true
        }
        format json
        level INFO
    }
    redir https://{$DOMAIN}{uri} 301
}

# ENHANCED: Security catch-all with comprehensive logging
:80, :443 {
    log {
        output file /logs/security_catchall.log {
            roll_size 25MB
            roll_keep 40
            roll_keep_for 180d
            roll_local_time true
        }
        format json {
            time_format "2006-01-02T15:04:05.000Z07:00"
            message_key "unauthorized_access"
        }
        level WARN
    }
    respond "Not Found" 404
}
