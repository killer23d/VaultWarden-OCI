{
	# Global options
	# TLS_PROVIDER selects the certificate issuance method:
	#
	#   cloudflare  (default)
	#     DNS-01 challenge via Cloudflare API.
	#     Requires CLOUDFLARE_API_TOKEN secret and the
	#     ghcr.io/caddybuilds/caddy-cloudflare image.
	#     Port 80 is still published but not needed for ACME.
	#
	#   acme_http
	#     HTTP-01 challenge via port 80 (no DNS provider needed).
	#     Use this when migrating away from Cloudflare or when
	#     the Cloudflare API token is unavailable.
	#     Domain MUST resolve to this server's public IP.
	#     CLOUDFLARE_API_TOKEN is not required in this mode.
	#
	# Set in .env:  TLS_PROVIDER=cloudflare  (or acme_http)

	# Trust Cloudflare proxy IPs — real client IP extracted from Cf-Connecting-Ip.
	# {client_ip} resolves to the visitor's IP; {remote_ip} is the Cloudflare edge node.
	servers {
		trusted_proxies cloudflare
		client_ip_headers Cf-Connecting-Ip
		protocols tls1.2
		timeouts {
			read_body   10s
			read_header 10s
			write       30s
			idle        120s
		}
	}

	order rate_limit before basicauth

	# ==========================================================================
	# Global named log writers — single FileWriter per log file
	# ==========================================================================
	log access_log {
		include http.log.access.access
		output file /var/log/caddy/access.log {
			roll_size     50MB
			roll_keep     20
			roll_keep_for 30d
			roll_compression zstd
		}
		format json {
			time_format "2006-01-02T15:04:05.000Z07:00"
			message_key "msg"
			level_key   "level"
			time_key    "ts"
			name_key    "logger"
			caller_key  "caller"
		}
		level INFO
	}

	log security_log {
		include http.log.access.security
		output file /var/log/caddy/security.log {
			roll_size     10MB
			roll_keep     50
			roll_keep_for 180d
			roll_compression zstd
		}
		format json {
			time_format "2006-01-02T15:04:05.000Z07:00"
			message_key "msg"
			level_key   "level"
			time_key    "ts"
			name_key    "logger"
		}
		level WARN
	}
}

# ================================
# TLS Provider Snippets
# ================================

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

(tls_http) {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge false
		}
	}
}

# ================================
# Shared reverse_proxy snippet
# Strips Vaultwarden's own XFO and CSP so Caddy controls exactly one copy.
# ================================
(proxy_vaultwarden) {
	reverse_proxy vaultwarden:80 {
		header_up   Host             {host}
		header_up   CF-Connecting-IP {client_ip}
		header_up   X-Real-IP        {client_ip}
		header_up   X-Forwarded-For  {client_ip}
		header_up   X-Request-ID     {uuid}
		header_down -X-Frame-Options
		header_down -Content-Security-Policy
	}
}

# ================================
# Internal Health Check Endpoint
# ================================
http://127.0.0.1:8080 {
	log {
		output discard
	}
	respond /alive 200
}

# ================================
# Main Site
# ================================
{$DOMAIN_NAME} {
	log access_log

	import tls_{$TLS_PROVIDER:cloudflare}

	# 1. Security headers applied to every response.
	# XFO and CSP are NOT here — they are set per-handle below
	# so the 2FA connector handles can omit them entirely.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-XSS-Protection          "0"
		Referrer-Policy           "same-origin"
		Cross-Origin-Opener-Policy    "same-origin"
		Cross-Origin-Resource-Policy  "same-origin"
		Cross-Origin-Embedder-Policy  "credentialless"
		X-DNS-Prefetch-Control    "off"
		Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=(), usb=(), clipboard-read=()"
		X-Request-ID              {uuid}
		-Server
		-X-Powered-By
	}

	encode zstd gzip

	# 2. Public Health Check
	@health path /alive
	handle @health {
		import proxy_vaultwarden
	}

	# 3. WebSocket routing
	handle /notifications/hub {
		reverse_proxy vaultwarden:80 {
			header_up   Host             {host}
			header_up   Connection       {>Connection}
			header_up   Upgrade          {>Upgrade}
			header_up   CF-Connecting-IP {client_ip}
			header_up   X-Real-IP        {client_ip}
			header_up   X-Forwarded-For  {client_ip}
			header_up   X-Request-ID     {uuid}
			header_down -X-Frame-Options
			header_down -Content-Security-Policy
		}
	}

	# 3b. 2FA Connector endpoints
	# Vaultwarden's XFO and CSP are stripped via header_down in proxy_vaultwarden.
	# No header{} block here means Caddy adds nothing — result: zero XFO/CSP headers.
	@twofactor path /duo-redirect-connector.html /webauthn-connector.html
	handle @twofactor {
		import proxy_vaultwarden
	}

	# 4. Admin Panel
	@admin path /admin*
	handle @admin {
		rate_limit {
			zone admin_zone {
				key   {http.vars.client_ip}
				events 5
				window 5m
			}
		}
		@admin_blocked not client_ip {$ADMIN_ALLOW_CIDR:127.0.0.1/32} 127.0.0.1
		respond @admin_blocked 403

		header {
			X-Frame-Options         "SAMEORIGIN"
			# 'unsafe-inline' removed from script-src: Vaultwarden admin panel templates
			# use external scripts only. If a future VW update adds inline scripts and
			# breaks admin UI, restore 'unsafe-inline' temporarily and file an issue.
			Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; form-action 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self';"
		}

		request_body {
			max_size 2MB
		}

		basic_auth {
			{env.ADMIN_USERNAME} {env.ADMIN_HASH}
		}

		import proxy_vaultwarden
	}

	# 5. Auth Endpoints
	@auth_endpoints path /api/accounts/prelogin* /identity/connect/token*
	handle @auth_endpoints {
		rate_limit {
			zone auth_zone {
				key   {http.vars.client_ip}
				events 10
				window 1m
			}
		}
		header {
			X-Frame-Options         "SAMEORIGIN"
			Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://haveibeenpwned.com; font-src 'self' data:; connect-src 'self' https://api.pwnedpasswords.com https://api.2fa.directory https://app.simplelogin.io/api/ https://app.addy.io/api/ https://api.fastmail.com/ https://api.forwardemail.net wss://{$DOMAIN_NAME}{$PUSH_CSP}; manifest-src 'self'; form-action 'self'; object-src 'none'; child-src 'self' https://*.duosecurity.com https://*.duofederal.com; frame-src 'self' https://*.duosecurity.com https://*.duofederal.com; frame-ancestors 'self' chrome-extension://nngceckbapebfimnlniiiahkandclblb chrome-extension://jbkfoedolllekgbhcbcoahefnbanhhlh moz-extension://*; base-uri 'self';"
		}
		request_body {
			max_size 512KB
		}
		reverse_proxy vaultwarden:80 {
			header_up   Host             {host}
			header_up   CF-Connecting-IP {client_ip}
			header_up   X-Real-IP        {client_ip}
			header_up   X-Forwarded-For  {client_ip}
			header_up   X-Request-ID     {uuid}
			header_up   X-Auth-Endpoint  "true"
			header_down -X-Frame-Options
			header_down -Content-Security-Policy
		}
	}

	# 5b. General API rate limit — prevents enumeration across all /api/* paths
	@api_general path /api/*
	handle @api_general {
		rate_limit {
			zone api_zone {
				key   {http.vars.client_ip}
				events 120
				window 1m
			}
		}
		import proxy_vaultwarden
	}

	# 6. Default — all other paths get XFO + CSP from Caddy (Vaultwarden's copy stripped)
	handle {
		header {
			X-Frame-Options         "SAMEORIGIN"
			Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://haveibeenpwned.com; font-src 'self' data:; connect-src 'self' https://api.pwnedpasswords.com https://api.2fa.directory https://app.simplelogin.io/api/ https://app.addy.io/api/ https://api.fastmail.com/ https://api.forwardemail.net wss://{$DOMAIN_NAME}{$PUSH_CSP}; manifest-src 'self'; form-action 'self'; object-src 'none'; child-src 'self' https://*.duosecurity.com https://*.duofederal.com; frame-src 'self' https://*.duosecurity.com https://*.duofederal.com; frame-ancestors 'self' chrome-extension://nngceckbapebfimnlniiiahkandclblb chrome-extension://jbkfoedolllekgbhcbcoahefnbanhhlh moz-extension://*; base-uri 'self';"
		}
		import proxy_vaultwarden
	}
}

# ================================
# Catch-all :80 and :443
# ================================
:80, :443 {
	log {
		output discard
	}
	@not_domain {
		not host {$DOMAIN_NAME}
	}
	respond @not_domain 444
}
