{
    # Global ACME DNS configuration
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

    # Global server configuration
    servers {
        trusted_proxies cloudflare
        client_ip_headers Cf-Connecting-Ip
    }
}

{$DOMAIN_NAME} {
    # 1. SINGLE CENTRALIZED LOG
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MB
            roll_keep 20
            roll_keep_for 30d
        }
        format json {
            time_format "2006-01-02T15:04:05.000Z07:00"
            message_key "msg"
            level_key "level"
            time_key "timestamp"
            name_key "logger"
            caller_key "caller"
            stacktrace_key "stacktrace"
        }
        level INFO
    }

    # 2. Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
        X-Request-ID {uuid}
        X-Forwarded-Proto https
        -Server
        -X-Powered-By
    }

    # 3. Health Check Endpoint (unauthenticated, for monitoring)
    @health path /alive
    handle @health {
        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }

    # 4. Admin Panel Protection
    @admin path /admin*
    handle @admin {
        # Rate limit: 10 requests per minute per IP
        rate_limit {
            zone admin_zone {
                key {http.request.remote.host}
                events 10
                window 1m
            }
        }

        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
            X-Admin-Access "true"
        }

        basic_auth {
            admin {env.ADMIN_BASIC_AUTH_HASH}
        }

        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }

    # 5. Auth Endpoints (Monitoring)
    @auth_endpoints path /api/accounts/prelogin* /identity/accounts/prelogin* /identity/connect/token*
    handle @auth_endpoints {
        # Rate limit: 5 requests per minute per IP
        rate_limit {
            zone auth_zone {
                key {http.request.remote.host}
                events 5
                window 1m
            }
        }

        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up X-Auth-Endpoint "true"
        }
    }

    # 6. Malicious User Agents
    @malicious_ua {
        header User-Agent *sqlmap* *nikto* *nmap* *acunetix* *dirbuster* *gobuster* *wfuzz*
    }
    handle @malicious_ua {
        respond "Access Denied - Security Policy Violation" 403
    }

    # 7. Default App Handler
    handle {
        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }
}

# Redirects
www.{$DOMAIN_NAME} {
    log {
        output file /var/log/caddy/access.log
        format json
    }
    redir https://{$DOMAIN_NAME}{uri} 301
}

# Catch-alls
:80, :443 {
    log {
        output file /var/log/caddy/access.log
        format json
    }
    respond "Not Found" 404
}
