{
    # Global ACME DNS configuration
    # SECURITY: Token loaded from Docker secret via environment variable
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

    # Global server configuration
    servers {
        trusted_proxies cloudflare
        client_ip_headers Cf-Connecting-Ip
    }
}

# ================================
# Internal Health Check Endpoint
# ================================
:8080 {
    handle /alive {
        reverse_proxy vaultwarden:80
    }
}

# ================================
# Main Site
# ================================
{$DOMAIN_NAME} {

    # 1. Centralized JSON Access Logging (OPTIMIZED for small deployment)
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MB
            roll_keep 5           # REDUCED from 20 to 5 (adequate for fail2ban)
            roll_keep_for 7d      # REDUCED from 30d to 7d (saves disk space)
        }
        format json {
            time_format "2006-01-02T15:04:05.000Z07:00"
            message_key "msg"
            level_key "level"
            time_key "timestamp"
            name_key "logger"
            caller_key "caller"
            stacktrace_key "stacktrace"
        }
        level INFO
    }

    # 2. Enhanced Security Headers (HARDENED)
    header {
        # HSTS with preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Classic security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Modern isolation headers (Spectre mitigation)
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        X-DNS-Prefetch-Control "off"
        
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
        
        # Permissions Policy (restrict dangerous features)
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
        
        # Request tracking and protocol
        X-Request-ID {uuid}
        X-Forwarded-Proto https

        # Remove server identification (security by obscurity)
        -Server
        -X-Powered-By
    }

    # 3. Public Health Check
    @health path /alive
    handle @health {
        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }

    # 4. Admin Panel Protection
    # NOTE: Rate limiting handled by Cloudflare WAF Rule (see deployment docs)
    @admin path /admin*
    handle @admin {
        # Stricter CSP for admin panel
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; object-src 'none'; base-uri 'self';"
            X-Admin-Access "true"
        }

        # BEST PRACTICE: basicauth directive with htpasswd-formatted environment variable
        # Expected format in env var: "admin:$2a$14$hash..."
        basicauth {
            {env.ADMIN_BASIC_AUTH_HASH}
        }

        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }

    # 5. Auth Endpoints (Monitoring)
    # NOTE: Rate limiting handled by Cloudflare WAF Rule
    # Cloudflare WAF Rule #2: 10 requests per 5 minutes to /identity/connect/token*
    @auth_endpoints path /api/accounts/prelogin* /identity/accounts/prelogin* /identity/connect/token*
    handle @auth_endpoints {
        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up X-Auth-Endpoint "true"
        }
    }

    # 6. Malicious User-Agent Blocking (ENHANCED)
    @malicious_ua {
        header User-Agent *sqlmap* *nikto* *nmap* *acunetix* *dirbuster* *gobuster* *wfuzz* *masscan* *zgrab*
    }
    handle @malicious_ua {
        respond "Access Denied - Security Policy Violation" 403
    }

    # 7. Default Reverse Proxy
    handle {
        reverse_proxy vaultwarden:80 {
            header_up Host {host}
            header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
            header_up X-Request-ID {http.request.header.X-Request-ID}
        }
    }
}

# ================================
# Redirect www → apex
# ================================
www.{$DOMAIN_NAME} {
    log {
        output file /var/log/caddy/access.log
        format json
    }
    redir https://{$DOMAIN_NAME}{uri} 301
}

# ================================
# Catch-all :80 and :443
# ================================
:80, :443 {
    log {
        output file /var/log/caddy/access.log
        format json
    }
    respond "Not Found" 404
}
