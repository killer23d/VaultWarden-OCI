{
	# Global options
	# TLS_PROVIDER selects the certificate issuance method:
	#
	#   cloudflare  (default)
	#     DNS-01 challenge via Cloudflare API.
	#     Requires CLOUDFLARE_API_TOKEN secret and the
	#     ghcr.io/caddybuilds/caddy-cloudflare image.
	#     Port 80 is still published but not needed for ACME.
	#
	#   acme_http
	#     HTTP-01 challenge via port 80 (no DNS provider needed).
	#     Use this when migrating away from Cloudflare or when
	#     the Cloudflare API token is unavailable.
	#     Domain MUST resolve to this server's public IP.
	#     CLOUDFLARE_API_TOKEN is not required in this mode.
	#
	# Set in .env:  TLS_PROVIDER=cloudflare  (or acme_http)

	# Trust Cloudflare proxy IPs — real client IP extracted from Cf-Connecting-Ip.
	# {client_ip} resolves to the visitor's IP; {remote_ip} is the Cloudflare edge node.
	servers {
		trusted_proxies cloudflare
		client_ip_headers Cf-Connecting-Ip
		timeouts {
			read_body   10s
			read_header 10s
			write       30s
			idle        120s
		}
	}

	# ==========================================================================
	# Global named log writers — single FileWriter per log file
	# ==========================================================================
	log access_log {
		include http.log.access.access
		output file /var/log/caddy/access.log {
			roll_size     50MB
			roll_keep     20
			roll_keep_for 30d
			roll_compression zstd
		}
		format json {
			time_format "2006-01-02T15:04:05.000Z07:00"
			message_key "msg"
			level_key   "level"
			time_key    "ts"
			name_key    "logger"
			caller_key  "caller"
		}
		level INFO
	}

	log security_log {
		include http.log.access.security
		output file /var/log/caddy/security.log {
			roll_size     10MB
			roll_keep     50
			roll_keep_for 180d
			roll_compression zstd
		}
		format json {
			time_format "2006-01-02T15:04:05.000Z07:00"
			message_key "msg"
			level_key   "level"
			time_key    "ts"
			name_key    "logger"
		}
		level WARN
	}
}

# ================================
# TLS Provider Snippets
# ================================
#
# Import the correct snippet inside your site block with:
#   import tls_{$TLS_PROVIDER:cloudflare}
#
# cloudflare — DNS-01 via Cloudflare API token (default).
# acme_http  — HTTP-01 via port 80. No DNS provider credential needed.

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

(tls_http) {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge false
		}
	}
}

# ================================
# Internal Health Check Endpoint
# ================================
http://127.0.0.1:8080 {
	log {
		output discard
	}
	respond /alive 200
}

# ================================
# Main Site
# ================================
{$DOMAIN_NAME} {
	log access_log

	import tls_{$TLS_PROVIDER:cloudflare}

	# 1. Enhanced Security Headers
	header {
		Strict-Transport-Security          "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options             "nosniff"
		X-Frame-Options                    "DENY"
		X-XSS-Protection                   "1; mode=block"
		Referrer-Policy                    "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy         "same-origin"
		Cross-Origin-Resource-Policy       "same-origin"
		Cross-Origin-Embedder-Policy       "credentialless"
		X-DNS-Prefetch-Control             "off"
		Content-Security-Policy            "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN_NAME}{$PUSH_CSP}; frame-src 'self'; object-src 'none'; base-uri 'self';"
		Permissions-Policy                 "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		X-Request-ID                       {uuid}
		-Server
		-X-Powered-By
	}

	encode zstd gzip

	# 2. Public Health Check
	@health path /alive
	handle @health {
		reverse_proxy vaultwarden:80 {
			header_up Host             {host}
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP        {client_ip}
			header_up X-Forwarded-For  {client_ip}
			header_up X-Request-ID     {uuid}
		}
	}

	# 3. WebSocket routing
	handle /notifications/hub {
		reverse_proxy vaultwarden:80 {
			header_up Host             {host}
			header_up Connection       {>Connection}
			header_up Upgrade          {>Upgrade}
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP        {client_ip}
			header_up X-Forwarded-For  {client_ip}
			header_up X-Request-ID     {uuid}
		}
	}

	# 4. Admin Panel Protection
	# Uses {client_ip} (real visitor IP via Cf-Connecting-Ip) instead of
	# {remote_ip} (Cloudflare edge node IP) so ADMIN_ALLOW_CIDR matches correctly.
	@admin path /admin*
	handle @admin {
		@admin_blocked not client_ip {$ADMIN_ALLOW_CIDR:127.0.0.1/32} 127.0.0.1
		respond @admin_blocked 403

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN_NAME}{$PUSH_CSP}; frame-src 'self'; object-src 'none'; base-uri 'self';"
		}

		request_body {
			max_size 2MB
		}

		basic_auth {
			{env.ADMIN_USERNAME} {env.ADMIN_HASH}
		}

		reverse_proxy vaultwarden:80 {
			header_up Host             {host}
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP        {client_ip}
			header_up X-Forwarded-For  {client_ip}
			header_up X-Request-ID     {uuid}
		}
	}

	# 5. Auth Endpoints
	@auth_endpoints path /api/accounts/prelogin* /identity/connect/token*
	handle @auth_endpoints {
		request_body {
			max_size 512KB
		}
		reverse_proxy vaultwarden:80 {
			header_up Host             {host}
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP        {client_ip}
			header_up X-Forwarded-For  {client_ip}
			header_up X-Request-ID     {uuid}
			header_up X-Auth-Endpoint  "true"
		}
	}

	# 6. Default Reverse Proxy
	handle {
		reverse_proxy vaultwarden:80 {
			header_up Host             {host}
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP        {client_ip}
			header_up X-Forwarded-For  {client_ip}
			header_up X-Request-ID     {uuid}
		}
	}
}

# ================================
# Redirect www -> apex
# ================================
www.{$DOMAIN_NAME} {
	log {
		output discard
	}
	redir https://{$DOMAIN_NAME}{uri} 301
}

# ================================
# Catch-all :80 and :443
# ================================
:80, :443 {
	log {
		output discard
	}
	respond "Not Found" 404
}
