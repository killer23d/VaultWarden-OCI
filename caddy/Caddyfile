{
        # Global ACME DNS configuration via Cloudflare
        acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

        # Dynamically trust Cloudflare proxy IPs (caddy-cloudflare-ip module).
        # Enables {client_ip} to resolve to the real visitor IP from CF headers.
        servers {
                trusted_proxies cloudflare
                client_ip_headers Cf-Connecting-Ip
        }
}

# ================================
# Internal Health Check Endpoint
# ================================
# FIX [P3-M3]: Bind to loopback only — prevents unauthenticated access
# from any other container on the shared Docker internal network.
127.0.0.1:8080 {
        log {
                output file /var/log/caddy/access.log {
                        roll_size 50MB
                        roll_keep 20
                        roll_keep_for 30d
                }
                format json {
                        time_format "2006-01-02T15:04:05.000Z07:00"
                        message_key "msg"
                        level_key   "level"
                        time_key    "ts"
                        name_key    "logger"
                        caller_key  "caller"
                }
                level INFO
        }

        handle /alive {
                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                }
        }
}

# ================================
# Main Site
# ================================
{$DOMAIN_NAME} {
        log {
                output file /var/log/caddy/access.log {
                        roll_size 50MB
                        roll_keep 20
                        roll_keep_for 30d
                }
                format json {
                        time_format "2006-01-02T15:04:05.000Z07:00"
                        message_key "msg"
                        level_key   "level"
                        time_key    "ts"
                        name_key    "logger"
                        caller_key  "caller"
                }
                level INFO
        }

        # 1. Enhanced Security Headers (HARDENED)
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                X-XSS-Protection "1; mode=block"
                Referrer-Policy "strict-origin-when-cross-origin"
                Cross-Origin-Opener-Policy "same-origin"
                Cross-Origin-Resource-Policy "same-origin"
                # credentialless instead of require-corp — preserves Spectre isolation
                # while allowing cross-origin no-credential fetches for WebAuthn/passkeys.
                Cross-Origin-Embedder-Policy "credentialless"
                X-DNS-Prefetch-Control "off"
                # FIX [CF-1]: PUSH_CSP set by entrypoint.sh — empty string when
                # PUSH_ENABLED!=true, Bitwarden push endpoints when true.
                Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN_NAME}{$PUSH_CSP}; frame-src 'self'; object-src 'none'; base-uri 'self';"
                Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
                X-Request-ID {uuid}
                -Server
                -X-Powered-By
        }

        # 2. Public Health Check
        @health path /alive
        handle @health {
                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                }
        }

        # 3. WebSocket routing for notifications hub
        # FIX [M-14]: Port 3012 removed in VaultWarden >= 1.30.0.
        # All WebSocket real-time sync goes through main HTTP port 80.
        handle /notifications/hub {
                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up Connection {>Connection}
                        header_up Upgrade {>Upgrade}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                }
        }

        # 4. Admin Panel Protection
        # FIX [P3-C2]: UA blocklist removed — trivially bypassed. Use
        # Cloudflare WAF Managed Ruleset for scanner/bot detection instead.
        @admin path /admin*
        handle @admin {
                log {
                        output file /var/log/caddy/admin_access.log {
                                roll_size 25MB
                                roll_keep 30
                                roll_keep_for 90d
                        }
                        format json {
                                time_format "2006-01-02T15:04:05.000Z07:00"
                                message_key "msg"
                                level_key   "level"
                                time_key    "ts"
                                name_key    "logger"
                        }
                        level INFO
                }

                # NOTE: 'unsafe-inline' required by VaultWarden admin UI inline <script> blocks.
                # Risk accepted: admin panel is protected by basic_auth + Cloudflare firewall rules.
                header {
                        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN_NAME}{$PUSH_CSP}; frame-src 'self'; object-src 'none'; base-uri 'self';"
                }

                basic_auth {
                        {env.ADMIN_USERNAME} {env.ADMIN_HASH}
                }

                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                }
        }

        # 5. Auth Endpoints — dedicated log for Fail2Ban parsing
        # FIX: Removed /identity/accounts/prelogin* — does not exist in VaultWarden.
        # Only /api/accounts/prelogin and /identity/connect/token are valid.
        @auth_endpoints path /api/accounts/prelogin* /identity/connect/token*
        handle @auth_endpoints {
                log {
                        output file /var/log/caddy/auth_attempts.log {
                                roll_size 25MB
                                roll_keep 30
                                roll_keep_for 90d
                        }
                        format json {
                                time_format "2006-01-02T15:04:05.000Z07:00"
                                message_key "msg"
                                level_key   "level"
                                time_key    "ts"
                                name_key    "logger"
                        }
                        level INFO
                }

                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                        header_up X-Auth-Endpoint "true"
                }
        }

        # 6. Default Reverse Proxy
        handle {
                reverse_proxy vaultwarden:80 {
                        header_up Host {host}
                        header_up CF-Connecting-IP {client_ip}
                        header_up X-Real-IP {client_ip}
                        header_up X-Forwarded-For {client_ip}
                        header_up X-Request-ID {uuid}
                }
        }
}

# ================================
# Redirect www → apex
# ================================
# Uses {$DOMAIN_NAME} env var for the redirect target (safe: expanded at runtime).
www.{$DOMAIN_NAME} {
        log {
                output file /var/log/caddy/access.log {
                        roll_size 50MB
                        roll_keep 20
                        roll_keep_for 30d
                }
                format json {
                        time_format "2006-01-02T15:04:05.000Z07:00"
                        message_key "msg"
                        level_key   "level"
                        time_key    "ts"
                        name_key    "logger"
                }
                level INFO
        }

        @has_domain expression `{$DOMAIN_NAME} != ""`
        handle @has_domain {
                redir https://{$DOMAIN_NAME}{uri} 301
        }
        handle {
                abort
        }
}

# ================================
# Catch-all :80 and :443
# ================================
# SECURITY NOTE: Restrict TCP 80/443 to Cloudflare IP ranges at UFW/OCI
# Security List level to prevent direct-IP access entirely.
# Ref: https://www.cloudflare.com/ips/
:80, :443 {
        log {
                output file /var/log/caddy/security.log {
                        roll_size 10MB
                        roll_keep 50
                        roll_keep_for 180d
                }
                format json {
                        time_format "2006-01-02T15:04:05.000Z07:00"
                        message_key "msg"
                        level_key   "level"
                        time_key    "ts"
                        name_key    "logger"
                }
                level WARN
        }

        respond "Not Found" 404
}
