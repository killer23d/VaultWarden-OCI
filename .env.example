# VaultWarden-OCI-NG Environment Configuration
# Enhanced: Supports all new features and bokysan/docker-postfix email integration
# Copy to .env and configure for your deployment

# =============================================================================
# CORE CONFIGURATION (REQUIRED)
# =============================================================================

# Your VaultWarden domain (MUST include https://)
DOMAIN=https://vault.example.com

# For Caddy (no protocol)
DOMAIN_NAME=vault.example.com

# Administrator email address for notifications
ADMIN_EMAIL=admin@example.com

# Cloudflare Zone ID for DNS and firewall management
CLOUDFLARE_ZONE_ID=your_zone_id_here

# =============================================================================
# USER AND DIRECTORY CONFIGURATION
# =============================================================================

# User and group IDs for container permissions
PUID=1000
PGID=1000

# Project state directory (data, logs, configs)
PROJECT_STATE_DIR=/var/lib/vaultwarden

# Timezone
TZ=UTC

# SSH port (if using custom port for security)
SSH_PORT=22

# SSH log path for Fail2Ban (platform-specific)
# Debian/Ubuntu: /var/log/auth.log
# RHEL/CentOS/Oracle Linux (OCI): /var/log/secure
SSH_LOG_PATH=/var/log/secure

# =============================================================================
# CONTAINER VERSIONS (PRODUCTION: Keep pinned, DEV: Can use latest)
# =============================================================================

# VaultWarden version (set to 'latest' for the latest image, or specify like 1.30.5)
VAULTWARDEN_VERSION=1.34.3

# Caddy version (set to 'latest' for the latest image, or specify like 2.8.4-cloudflare)
CADDY_VERSION=2.10.2

# Fail2Ban version (set to 'latest' for the latest image, or specify like 1.1.0)
FAIL2BAN_VERSION=1.1.0

# Postfix version for email relay (set to 'latest' for the latest image)
POSTFIX_VERSION=4.4.0

# Optional service versions
# WATCHTOWER_VERSION=1.7.1
# ALPINE_VERSION=3.19

# =============================================================================
# VAULTWARDEN APPLICATION SETTINGS
# =============================================================================

# User registration settings
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
SENDS_ALLOWED=true
WEB_VAULT_ENABLED=true

# Security settings
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false
DISABLE_ADMIN_TOKEN=false
DISABLE_ICON_DOWNLOAD=false

# Icon cache settings
ICON_CACHE_TTL=2592000
ICON_CACHE_NEGTTL=259200

# Organization settings
ORG_CREATION_USERS=
ORG_EVENTS_ENABLED=false
EVENTS_DAYS_RETAIN=365

# Maintenance settings
TRASH_AUTO_DELETE_DAYS=30
INCOMPLETE_2FA_TIME_LIMIT=3

# Database settings
DATABASE_MAX_CONNS=10
DATABASE_TIMEOUT=30

# =============================================================================
# EMAIL/SMTP CONFIGURATION (ENHANCED - bokysan/docker-postfix)
# =============================================================================

# Primary SMTP settings (used by VaultWarden and as relay configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD is configured via secrets (./edit-secrets.sh)
SMTP_FROM=noreply@vault.example.com
SMTP_FROM_NAME=VaultWarden
SMTP_TIMEOUT=15

# Postfix container configuration (bokysan/docker-postfix)
# Documentation: https://github.com/bokysan/docker-postfix

# Required: Domains allowed to send mail (space or comma separated)
ALLOWED_SENDER_DOMAINS="vault.example.com example.com"

# Postfix hostname (FQDN recommended)
POSTFIX_MYHOSTNAME=postfix.vault.example.com

# TLS security level for SMTP connections
# Options: encrypt (required), may (opportunistic), none (disabled)
POSTFIX_SMTP_TLS_SECURITY_LEVEL=encrypt

# Maximum message size in bytes (default: 10MB)
POSTFIX_MESSAGE_SIZE_LIMIT=10240000

# NOTE: RELAYHOST, RELAYHOST_USERNAME, and RELAYHOST_PASSWORD are automatically
# built from SMTP_HOST, SMTP_PORT, SMTP_USERNAME, and SMTP_PASSWORD in docker-compose.yml
# Do not set these manually unless you need different relay credentials than VaultWarden

# Advanced Postfix Configuration (Optional)
# Any postfix parameter can be set using format: POSTFIX_<lowercase_parameter_name>
# Examples:
# POSTFIX_smtp_sasl_auth_enable=yes
# POSTFIX_smtp_sasl_security_options=noanonymous
# POSTFIX_smtp_sasl_password_maps=lmdb:/etc/postfix/sasl_passwd
# POSTFIX_smtp_use_tls=yes
# POSTFIX_smtp_tls_note_starttls_offer=yes
# POSTFIX_smtp_tls_CAfile=/etc/ssl/certs/ca-certificates.crt

# =============================================================================
# PUSH NOTIFICATIONS CONFIGURATION (OPTIONAL)
# =============================================================================

# Push notification settings (get from bitwarden.com/host)
PUSH_ENABLED=true
PUSH_RELAY_URI=https://push.bitwarden.com
PUSH_IDENTITY_URI=https://identity.bitwarden.com

# =============================================================================
# FAIL2BAN CONFIGURATION (ENHANCED - Now uses postfix for email)
# =============================================================================

# Fail2Ban logging and behavior
F2B_LOG_TARGET=STDOUT
F2B_LOG_LEVEL=INFO
F2B_DB_PURGE_AGE=1d
F2B_MAX_RETRY=3

# Email notifications for Fail2Ban (via postfix container)
F2B_DEST_MAIL="${ADMIN_EMAIL}"
F2B_SENDER="fail2ban@${DOMAIN}"
F2B_ACTION="%(action_mwl)s"

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup verification mode (quick_check or integrity_check)
BACKUP_VERIFICATION_MODE=quick_check

# Rclone configuration for offsite backups
RCLONE_REMOTE_NAME=CHANGE_ME_RCLONE_REMOTE

# Backup retention settings (used by cron jobs)
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# =============================================================================
# WATCHTOWER CONFIGURATION (AUTO-UPDATES)
# =============================================================================

# Watchtower settings (use with --profile watchtower)
# WATCHTOWER_POLL_INTERVAL=3600
# WATCHTOWER_NOTIFICATIONS=email
# WATCHTOWER_FROM_EMAIL=watchtower@${DOMAIN}

# =============================================================================
# DEVELOPMENT OVERRIDES (ONLY FOR DEVELOPMENT)
# =============================================================================

# Development mode settings (only use with docker-compose.override.yml)
# DEVELOPMENT_MODE=true
# DEV_SIGNUPS_ALLOWED=true
# DEV_LOG_LEVEL=debug
# DEV_ADMIN_TOKEN=development_admin_token_change_me

# =============================================================================
# ADVANCED CONFIGURATION (OPTIONAL)
# =============================================================================

# Network configuration
# DOCKER_NETWORK_SUBNET=172.30.0.0/16
# DOCKER_NETWORK_GATEWAY=172.30.0.1

# Performance tuning
# WEB_VAULT_FOLDER=web-vault/
# ATTACHMENTS_FOLDER=attachments
# ICON_CACHE_FOLDER=icon_cache
# SENDS_FOLDER=sends
# TMP_FOLDER=tmp
# RSA_KEY_FILENAME=rsa_key

# Custom headers (for proxy setups)
# IP_HEADER=CF-Connecting-IP
# ICON_REDIRECT_CODE=302

# =============================================================================
# TEMPLATE REPLACEMENT NOTES
# =============================================================================

# IMPORTANT: After copying this file to .env, you MUST:
# 1. Set your actual DOMAIN
# 2. Set your actual ADMIN_EMAIL  
# 3. Get your CLOUDFLARE_ZONE_ID from Cloudflare dashboard
# 4. Configure SMTP settings if you want email notifications
# 5. Run: ./edit-secrets.sh --init to setup encrypted secrets
# 6. Configure secrets with Cloudflare API tokens and other sensitive data

# CLOUDFLARE SETUP REQUIRED:
# - DNS API Token: Zone:DNS:Edit + Zone:Zone:Read permissions
# - Firewall API Token: Zone:Firewall Services:Edit permission  
# - Both tokens should be scoped to your specific zone

# EMAIL CONFIGURATION NOTES (ENHANCED - bokysan/docker-postfix):
# - Email now uses bokysan/docker-postfix container (replaces msmtpd)
# - Full-featured postfix server with relay capabilities
# - Relay configuration automatically built from SMTP_* variables
# - Password/credentials are managed via encrypted secrets
# - Supports TLS encryption with configurable security levels
# - Set ALLOWED_SENDER_DOMAINS to your valid sender domains
# - Set POSTFIX_MYHOSTNAME to match your mail server FQDN
# - Any postfix parameter can be configured using POSTFIX_<lowercase_name>
# - Test email functionality: ./test-email-simple.sh

# BOKYSAN/DOCKER-POSTFIX ENVIRONMENT VARIABLES:
# Official documentation: https://github.com/bokysan/docker-postfix
# 
# Core variables:
# - ALLOWED_SENDER_DOMAINS: Domains allowed to send (required)
# - RELAYHOST: SMTP relay host (built from SMTP_HOST:SMTP_PORT)
# - RELAYHOST_USERNAME: Relay username (from SMTP_USERNAME)
# - RELAYHOST_PASSWORD: Relay password (from SMTP_PASSWORD)
# - POSTFIX_myhostname: Postfix hostname
# - POSTFIX_message_size_limit: Max message size in bytes
# - POSTFIX_smtp_tls_security_level: TLS level (encrypt/may/none)
#
# All postfix main.cf parameters can be set using:
# POSTFIX_<lowercase_parameter_name>=value

# SECURITY NOTES:
# - Never put sensitive data (passwords, tokens) in this .env file
# - Use ./edit-secrets.sh to manage sensitive configuration
# - All secrets are encrypted with Age+SOPS for security
# - This .env file can be safely committed to version control
# - SMTP_PASSWORD should be stored in secrets, not in .env

# PRODUCTION DEPLOYMENT:
# 1. Keep container versions pinned for stability
# 2. Set SIGNUPS_ALLOWED=false for security
# 3. Configure email notifications for monitoring
# 4. Setup automated backups with: sudo ./cron-setup.sh --install
# 5. Enable comprehensive monitoring with: make health --comprehensive
# 6. Test email migration with: ./test-email-simple.sh

# DEVELOPMENT DEPLOYMENT:
# 1. Copy docker-compose.override.yml.example to docker-compose.override.yml
# 2. Uncomment DEVELOPMENT_MODE=true above
# 3. Use: make dev-setup for quick development setup
# 4. Access services at http://localhost with relaxed security settings

# EMAIL MIGRATION NOTES (msmtpd -> bokysan/docker-postfix):
# - This version replaces msmtpd with full-featured postfix
# - Migration provides better reliability and more features
# - Benefits: full SMTP server, better compatibility, enhanced logging
# - Increased resource allocation: 128MB limit (vs 32MB for msmtpd)
# - Uses official bokysan/docker-postfix environment variables
# - Automatic relay configuration from existing SMTP_* variables
# - Test migration: ./test-email-simple.sh --verbose
