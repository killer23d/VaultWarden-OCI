# ==========================================================
# VaultWarden-OCI-NG Environment Configuration
# ==========================================================
# CORE CONFIGURATION (REQUIRED)
# ==========================================================
DOMAIN=vault.example.com
ADMIN_EMAIL=admin@example.com
COMPOSE_PROJECT_NAME=vaultwarden
PROJECT_STATE_DIR=/var/lib/vaultwarden

# ==========================================================
# USER & PERMISSIONS
# ==========================================================
PUID=1000
PGID=1000

# ==========================================================
# HOST CONFIGURATION
# ==========================================================
SSH_PORT=22

# ==========================================================
# CONTAINER VERSIONS (Pin for production)
# ==========================================================
VAULTWARDEN_VERSION=1.31.0
CADDY_VERSION=2.8.4
FAIL2BAN_VERSION=1.1.0
DDCLIENT_VERSION=1.15.1

# ==========================================================
# OPTIONAL: WEBSOCKET CONFIGURATION
# ==========================================================
# To enable WebSocket for live client sync (push notifications), uncomment
# the following line AND the corresponding reverse_proxy line in caddy/Caddyfile.
#WEBSOCKET_ENABLED=true

# ==========================================================
# BACKUP CONFIGURATION
# ==========================================================
DB_BACKUP_RETENTION_DAYS=14
FULL_BACKUP_RETENTION_DAYS=30
EMERGENCY_BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION=age
BACKUP_VERIFICATION_MODE=quick_check
RCLONE_REMOTE_NAME=CHANGE_ME

# ==========================================================
# CLOUDFLARE & DYNAMIC DNS (REQUIRED)
# ==========================================================
CLOUDFLARE_ZONE_ID=CHANGE_ME

# ==========================================================
# RESOURCE LIMITS (Revised for 6GB ARM instance stability)
# ==========================================================
# Memory limits
VAULTWARDEN_MEMORY_LIMIT=1.5g
VAULTWARDEN_MEMORY_RESERVATION=256m
CADDY_MEMORY_LIMIT=256m
CADDY_MEMORY_RESERVATION=64m
FAIL2BAN_MEMORY_LIMIT=128m
FAIL2BAN_MEMORY_RESERVATION=64m
DDCLIENT_MEMORY_LIMIT=64m
DDCLIENT_MEMORY_RESERVATION=16m

# CPU limits
VAULTWARDEN_CPU_LIMIT=1.0
VAULTWARDEN_CPU_RESERVATION=0.2
CADDY_CPU_LIMIT=0.5
CADDY_CPU_RESERVATION=0.1
FAIL2BAN_CPU_LIMIT=0.2
FAIL2BAN_CPU_RESERVATION=0.05
DDCLIENT_CPU_LIMIT=0.1
DDCLIENT_CPU_RESERVATION=0.01

# ==========================================================
# OPTIONAL: SMTP CONFIGURATION
# ==========================================================
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=vaultwarden@example.com
