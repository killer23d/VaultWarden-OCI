# VaultWarden-OCI-NG Environment Configuration
# Enhanced: Supports multi-provider email (MailerSend, SendGrid, Mailgun, SMTP, host MTA)
# Copy to .env and configure for your deployment

# =============================================================================
# CORE CONFIGURATION (REQUIRED)
# =============================================================================

# Your VaultWarden domain (MUST include https://)
DOMAIN=https://vault.example.com

# For Caddy (no protocol)
DOMAIN_NAME=vault.example.com

# Administrator email address for notifications
ADMIN_EMAIL=admin@example.com

# Cloudflare Zone ID for DNS and firewall management
CLOUDFLARE_ZONE_ID=your_zone_id_here

# =============================================================================
# USER AND DIRECTORY CONFIGURATION
# =============================================================================

# User and group IDs for container permissions
PUID=1000
PGID=1000

# Project state directory (data, logs, configs)
PROJECT_STATE_DIR=/var/lib/vaultwarden

# Timezone
TZ=UTC

# SSH port (if using custom port for security)
SSH_PORT=22

# SSH log path for Fail2Ban (platform-specific)
# Debian/Ubuntu: /var/log/auth.log
# RHEL/CentOS/Oracle Linux (OCI): /var/log/secure
SSH_LOG_PATH=/var/log/secure

# =============================================================================
# CONTAINER VERSIONS
# =============================================================================

VAULTWARDEN_VERSION=1.35.4
CADDY_VERSION=2.11.1
FAIL2BAN_VERSION=1.1.0-r3
POSTFIX_VERSION=4.3.0

# Optional service versions
# WATCHTOWER_VERSION=1.7.1
# ALPINE_VERSION=3.19

# =============================================================================
# VAULTWARDEN APPLICATION SETTINGS
# =============================================================================

# User registration settings
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
SENDS_ALLOWED=true
WEB_VAULT_ENABLED=true

# Security settings
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false
DISABLE_ADMIN_TOKEN=false
DISABLE_ICON_DOWNLOAD=false

# Icon cache settings
ICON_CACHE_TTL=2592000
ICON_CACHE_NEGTTL=259200

# Organization settings
ORG_CREATION_USERS=
ORG_EVENTS_ENABLED=false
EVENTS_DAYS_RETAIN=365

# Maintenance settings
TRASH_AUTO_DELETE_DAYS=30
INCOMPLETE_2FA_TIME_LIMIT=3

# Database settings
DATABASE_MAX_CONNS=10
DATABASE_TIMEOUT=30

# =============================================================================
# EMAIL CONFIGURATION
#
# lib/email.sh implements a three-tier delivery chain with automatic fallback:
#
#   Tier 1 — HTTP API  (EMAIL_PROVIDER + <PROVIDER>_API_TOKEN, via curl)
#   Tier 2 — SMTP relay  (curl smtps/starttls — no local daemon required)
#   Tier 3 — Host MTA  (Postfix sidecar container on 127.0.0.1:587)
#
# EMAIL_MODE controls which tier(s) are attempted:
#   auto  — try in order: Tier 1 → Tier 2 → Tier 3 (recommended)
#   api   — Tier 1 only; fail loudly if token not set
#   smtp  — Tier 2 only (curl smtps/starttls)
#   host  — Tier 3 only (Postfix sidecar / mail binary)
#
# EMAIL_PROVIDER selects the HTTP API driver for Tier 1:
#   mailersend | sendgrid | mailgun | postmark | resend
#   (only relevant when EMAIL_MODE=auto or EMAIL_MODE=api)
#
# API TOKEN RESOLUTION:
#   lib/email.sh automatically resolves <PROVIDER_UPPER>_API_TOKEN to the
#   internal EMAIL_API_TOKEN. Set only the provider-specific name in secrets:
#     EMAIL_PROVIDER=mailersend  →  set MAILERSEND_API_TOKEN in secrets
#     EMAIL_PROVIDER=sendgrid    →  set SENDGRID_API_TOKEN in secrets
#     EMAIL_PROVIDER=mailgun     →  set MAILGUN_API_TOKEN in secrets
#     EMAIL_PROVIDER=postmark    →  set POSTMARK_API_TOKEN in secrets
#     EMAIL_PROVIDER=resend      →  set RESEND_API_TOKEN in secrets
#   EMAIL_API_TOKEN does not need to be set separately.
#
# Sensitive values (API tokens, SMTP password) go in secrets, not here.
# See docs/EMAIL.md for the full delivery chain reference.
# See docs/CONFIGURATION.md for the complete variable reference.
# =============================================================================

EMAIL_MODE=auto
EMAIL_PROVIDER=mailersend

# Provider API token — stored in secrets via ./edit-secrets.sh --rotate email_api_token
# Leave ALL of these blank here. The token lives in the encrypted secrets file, not .env.
#
# Uncomment the line that matches your EMAIL_PROVIDER above, leave it blank (value in secrets).
# When you switch EMAIL_PROVIDER, also re-run: ./edit-secrets.sh --rotate email_api_token
# Only one provider is active at a time; all others should remain commented out.
#
MAILERSEND_API_TOKEN=
# SENDGRID_API_TOKEN=
# MAILGUN_API_TOKEN=
# POSTMARK_API_TOKEN=
# RESEND_API_TOKEN=

# SMTP relay fallback — Tier 2 (curl smtps/starttls — no daemon required)
# Used when EMAIL_MODE=auto and Tier 1 (API) fails, or EMAIL_MODE=smtp.
# These variables are the single authoritative SMTP namespace for this stack.
# docker-compose.yml maps them directly into the VaultWarden container
# environment (SMTP_HOST: ${SMTP_HOST:-} etc.) and into the Postfix sidecar
# relay config (RELAYHOST=${SMTP_HOST}:${SMTP_PORT}). No duplicate VW_SMTP_*
# variables are needed — Compose expands ${VAR} in the YAML file itself.

# ---------------------------------------------------------------------------
# SMTP — External relay credentials (consumed by Postfix sidecar only)
# VaultWarden itself talks to the Postfix sidecar at host "postfix", port 587,
# security "off", with NO username/password. Postfix relays outbound using
# the values below. Do NOT put these values in VaultWarden's admin UI SMTP
# settings — use the VaultWarden SMTP block below instead.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD stored in secrets via: ./edit-secrets.sh --rotate smtp_password
SMTP_FROM=noreply@vault.example.com
SMTP_FROM_NAME=VaultWarden
SMTP_TIMEOUT=30
# ---------------------------------------------------------------------------
# VaultWarden SMTP settings — points at Postfix sidecar, NOT external relay.
# These are injected into the vaultwarden container environment and become
# the default values shown in the admin UI on first boot.
# Admin UI: SMTP Host=postfix, Port=587, Security=Off, User/Pass=empty
# ---------------------------------------------------------------------------
VW_SMTP_HOST=postfix
VW_SMTP_PORT=587
VW_SMTP_SECURITY=off

# Postfix MTA sidecar — Tier 3 (boky/postfix — last-resort fallback)
# Also consumed by the postfix Docker service for relay configuration.
# ALLOWED_SENDER_DOMAINS is critical: leave blank = open relay. Set to your domain.
ALLOWED_SENDER_DOMAINS=example.com
POSTFIX_MYHOSTNAME=postfix
POSTFIX_SMTP_TLS_SECURITY_LEVEL=encrypt
POSTFIX_MESSAGE_SIZE_LIMIT=10240000

# Fail2Ban email notifications (uses the same delivery chain)
# FIX: Docker Compose does NOT expand ${VAR} syntax in .env files — these would
# be sent to the literal string "${ADMIN_EMAIL}" / "fail2ban@${DOMAIN_NAME}".
# Values MUST be literal. Update these to match ADMIN_EMAIL and DOMAIN_NAME above.
F2B_LOG_TARGET=STDOUT
F2B_LOG_LEVEL=INFO
F2B_DB_PURGE_AGE=1d
F2B_MAX_RETRY=3
F2B_DEST_MAIL=admin@example.com
F2B_SENDER=fail2ban@vault.example.com
F2B_ACTION="%(action_mwl)s"

# =============================================================================
# PUSH NOTIFICATIONS CONFIGURATION (OPTIONAL)
# =============================================================================

# Push notification settings (get from bitwarden.com/host)
# WARNING: PUSH_ENABLED=true requires vaultwarden_app on caddy_external network
# (see docker-compose.yml.example networks section for vaultwarden service).
# Set to true ONLY after:
#   1. Adding caddy_external to vaultwarden networks: block in docker-compose.yml
#   2. Running: ./edit-secrets.sh --rotate push_installation_id
#   3. Running: ./edit-secrets.sh --rotate push_installation_key
PUSH_ENABLED=false
PUSH_RELAY_URI=https://push.bitwarden.com
PUSH_IDENTITY_URI=https://identity.bitwarden.com

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup verification mode (quick_check or integrity_check)
BACKUP_VERIFICATION_MODE=quick_check

# Rclone configuration for offsite backups
RCLONE_REMOTE_NAME=CHANGE_ME_RCLONE_REMOTE

# Backup retention settings
# NOTE: BACKUP_SCHEDULE and BACKUP_RETENTION_DAYS are reference values only.
# The actual schedule is controlled by the systemd timer unit: vaultwarden-backup.timer
# To change the schedule: sudo systemctl edit vaultwarden-backup.timer
# (or legacy: cron-setup.sh hardcodes its own schedule)
BACKUP_SCHEDULE="0 4 * * *"
BACKUP_RETENTION_DAYS=30

# =============================================================================
# WATCHTOWER CONFIGURATION (AUTO-UPDATES)
# =============================================================================

# Watchtower settings (use with --profile watchtower)
# WATCHTOWER_POLL_INTERVAL=3600
# WATCHTOWER_NOTIFICATIONS=email
# WATCHTOWER_FROM_EMAIL=watchtower@vault.example.com

# =============================================================================
# DEVELOPMENT OVERRIDES (ONLY FOR DEVELOPMENT)
# =============================================================================

# Development mode settings (only use with docker-compose.override.yml)
# Copy docker-compose.override.yml.example → docker-compose.override.yml
# to activate the development stack (Mailpit, debug logging, relaxed security).
# Run: make dev-setup   — copies both .env.example and the override file.
# NEVER use docker-compose.override.yml in production.
# DEVELOPMENT_MODE=true
# DEV_SIGNUPS_ALLOWED=true
# DEV_LOG_LEVEL=debug
# DEV_ADMIN_TOKEN=development_admin_token_change_me

# MAILPIT_VERSION moved to DEVELOPMENT OVERRIDES — it is only
# consumed by docker-compose.override.yml and should not appear in the
# production configuration block.
# The override file uses ${MAILPIT_VERSION:-v1.21.6} as a safety net.
# MAILPIT_VERSION=v1.21.6

# =============================================================================
# ADVANCED CONFIGURATION (OPTIONAL)
# =============================================================================

# Network configuration
# DOCKER_NETWORK_SUBNET=172.30.0.0/16
# DOCKER_NETWORK_GATEWAY=172.30.0.1

# Custom headers (for proxy setups)
# IP_HEADER=CF-Connecting-IP
# ICON_REDIRECT_CODE=302

# =============================================================================
# TEMPLATE REPLACEMENT NOTES
# =============================================================================

# IMPORTANT: After copying this file to .env, you MUST:
# 1. Set your actual DOMAIN
# 2. Set your actual ADMIN_EMAIL
# 3. Get your CLOUDFLARE_ZONE_ID from Cloudflare dashboard
# 4. Set your email provider API token via secrets (key name must match EMAIL_PROVIDER):
#    ./edit-secrets.sh --rotate email_api_token
#    e.g. EMAIL_PROVIDER=mailersend  → stores MAILERSEND_API_TOKEN in secrets
#         EMAIL_PROVIDER=sendgrid   → stores SENDGRID_API_TOKEN in secrets
#         EMAIL_PROVIDER=mailgun    → stores MAILGUN_API_TOKEN in secrets
#         EMAIL_PROVIDER=postmark   → stores POSTMARK_API_TOKEN in secrets
#         EMAIL_PROVIDER=resend     → stores RESEND_API_TOKEN in secrets
# 5. Run: ./edit-secrets.sh --init to setup encrypted secrets
# 6. Configure secrets with Cloudflare API tokens and other sensitive data
# 7. Update F2B_DEST_MAIL and F2B_SENDER to match your ADMIN_EMAIL and DOMAIN_NAME
#    (Docker Compose does not expand ${VAR} references in .env files)
# 8. Set ALLOWED_SENDER_DOMAINS to your bare domain (prevents open relay abuse)

# SECURITY NOTES:
# - Never put sensitive tokens or passwords (SMTP_PASSWORD, API tokens) in .env
# - Use ./edit-secrets.sh to manage sensitive configuration (Age+SOPS encrypted)
# - This .env file can be safely committed to version control
# - Sensitive values for systemd units go in /etc/vaultwarden/vaultwarden.env
#   (root:root 600, installed by systemd-setup.sh --install)

# PRODUCTION DEPLOYMENT:
# 1. Keep container versions pinned for stability
# 2. Set SIGNUPS_ALLOWED=false for security
# 3. Configure email notifications for monitoring
# 4. Setup scheduled jobs with: sudo ./systemd-setup.sh --install
#    (or legacy: sudo ./cron-setup.sh --install)
# 5. Enable comprehensive monitoring with: make health COMPREHENSIVE=true
# 6. Test email configuration with: ./maintenance.sh --test-email

# EMAIL MIGRATION NOTES (Postfix sidecar → lib/email.sh multi-provider chain):
# - lib/email.sh implements API → SMTP → host-MTA fallback in pure bash + curl
# - No mail daemon container required; no msmtpd; no sidecar
# - Set EMAIL_PROVIDER=mailersend + MAILERSEND_API_TOKEN in secrets for primary
# - SMTP fallback uses curl --url smtps://HOST:PORT (no local MTA needed)
# - Host MTA (Postfix) remains as last-resort if both API and SMTP are unavailable
# - To force a specific path: set EMAIL_MODE=api | smtp | host
