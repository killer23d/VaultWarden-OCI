# VaultWarden-OCI — production-first environment example
# Copy to .env. Store secrets with SOPS/Age via ./edit-secrets.sh rotate <name>.
# Full reference and advanced options: docs/CONFIGURATION.md

# === Core identity and runtime ===
DOMAIN=https://vault.example.com
ADMIN_EMAIL=admin@example.com
PUID=1000
PGID=1000
TZ=UTC
PROJECT_STATE_DIR=/var/lib/vaultwarden
SOPS_AGE_KEY_FILE=/etc/vaultwarden/age-key.txt

# === Supported production ingress ===
# Default: Cloudflare DNS-01 with Caddy. Direct acme_http is advanced/fallback only.
TLS_PROVIDER=cloudflare
ADMIN_ALLOW_CIDR=127.0.0.1/32
IP_HEADER=CF-Connecting-IP
CLOUDFLARE_PROXY_ENABLED=true
CF_ACCOUNT_EMAIL=

# === Vaultwarden access and security defaults ===
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
SENDS_ALLOWED=true
WEB_VAULT_ENABLED=true
WEBSOCKET_ENABLED=true
ADMIN_TOKEN=USE_SECRETS_NOT_ENV
DISABLE_ADMIN_TOKEN=false
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false
INCOMPLETE_2FA_TIME_LIMIT=3
LOG_LEVEL=warn
EXTENDED_LOGGING=true
DISABLE_ICON_DOWNLOAD=false
ICON_CACHE_TTL=2592000
ICON_CACHE_NEGTTL=259200
ORG_CREATION_USERS=
ORG_EVENTS_ENABLED=false
EVENTS_DAYS_RETAIN=365
TRASH_AUTO_DELETE_DAYS=30
WEB_VAULT_FOLDER=web-vault/
DATABASE_MAX_CONNS=10
DATABASE_TIMEOUT=30

# === Container image pins ===
# .env.example is authoritative for current default pins.
VAULTWARDEN_VERSION=1.36.0
CADDY_VERSION=2.11.4
POSTFIX_VERSION=5.1.0
BUSYBOX_VERSION=1.36.1

# === Postfix-first email delivery ===
# Normal path: Vaultwarden -> Postfix sidecar -> external SMTP relay.
# API providers (mailersend/sendgrid/mailgun/postmark/resend) are advanced alternatives.
EMAIL_MODE=smtp
EMAIL_PROVIDER=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_FROM=noreply@vault.example.com
SMTP_FROM_NAME=VaultWarden
SMTP_TIMEOUT=30
VW_SMTP_HOST=postfix
VW_SMTP_PORT=587
VW_SMTP_SECURITY=off
VW_SMTP_AUTH_MECHANISM=none
VW_SMTP_EXPLICIT_TLS=false
ALLOWED_SENDER_DOMAINS=example.com
POSTFIX_MYHOSTNAME=postfix
POSTFIX_SMTP_TLS_SECURITY_LEVEL=encrypt
POSTFIX_MESSAGE_SIZE_LIMIT=10240000
MAILGUN_REGION=us

# === CrowdSec host service + Cloudflare edge enforcement ===
SSH_PORT=22
SSH_LOG_PATH=/var/log/auth.log
CF_FREE_PLAN=true
CF_AUTONOMOUS_MODE=false
CROWDSEC_VERSION=1.7.8
CF_WORKER_BOUNCER_VERSION=v0.0.18
FIREWALL_BOUNCER_VERSION=0.0.34

# === Backups and rclone offsite copy ===
BACKUP_DIR=
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_VERIFICATION_MODE=quick_check
REQUIRE_AUTHENTICATED_INTEGRITY=true
RCLONE_REMOTE_NAME=CHANGE_ME_RCLONE_REMOTE
RCLONE_CONFIG=
RCLONE_REMOTE_PATH=BW-Backup
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_DB_DAYS=14
BACKUP_RETENTION_FULL_DAYS=30
BACKUP_RETENTION_EMERGENCY_DAYS=90

# Restore key override for non-interactive recovery only; leave blank normally.
RESTORE_AGE_KEY_FILE=

# Optional dedicated data volume. Leave blank for boot-volume installs.
# See docs/VOLUME-MIGRATION.md before adopting or moving production data.
DATA_VOLUME_DEVICE=
DATA_VOLUME_MOUNT=/mnt/vw-data

# Auto-fix guardrails consumed by maintenance.sh health --fix.
MAX_AUTO_RESTARTS=3
RESTART_COUNT_WINDOW_HOURS=6

# Required SOPS secret keys for the golden path:
#   caddy_cloudflare_dns_token, cf_worker_bouncer_token, cloudflare_zone_id,
#   cf_account_id, smtp_password, admin_token/admin_basic_auth_hash,
#   file_integrity_hmac_key
# Optional/advanced secrets: email_api_token, push_installation_id, push_installation_key.
