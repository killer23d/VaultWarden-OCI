# ==========================================================
# VaultWarden-OCI Environment Configuration Template
# This file is copied to .env by setup.sh
# ==========================================================
# CORE CONFIGURATION (REQUIRED - setup.sh will populate these)
# ==========================================================
DOMAIN=vault.example.com
ADMIN_EMAIL=admin@example.com
COMPOSE_PROJECT_NAME=vaultwarden
PROJECT_STATE_DIR=/var/lib/vaultwarden

# ==========================================================
# USER & PERMISSIONS (setup.sh will populate these)
# ==========================================================
PUID=1000
PGID=1000

# ==========================================================
# HOST CONFIGURATION
# ==========================================================
SSH_PORT=22
TZ=UTC

# ==========================================================
# CONTAINER VERSIONS (Pin for production stability)
# Comment out to use 'latest' - setup.sh will uncomment if not using --use-latest
# ==========================================================
#VAULTWARDEN_VERSION=1.31.0
#CADDY_VERSION=2.8.4
#FAIL2BAN_VERSION=1.1.0

# ==========================================================
# VAULTWARDEN CONFIGURATION
# ==========================================================
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
SENDS_ALLOWED=true
WEB_VAULT_ENABLED=true
WEBSOCKET_ENABLED=false
PUSH_ENABLED=false

# ==========================================================
# OPTIONAL: SMTP CONFIGURATION
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_FROM=noreply@vault.example.com
SMTP_FROM_NAME=VaultWarden

# ==========================================================
# CLOUDFLARE (REQUIRED - You must configure this manually)
# ==========================================================
CLOUDFLARE_ZONE_ID=your_zone_id_here

# ==========================================================
# BACKUP CONFIGURATION
# ==========================================================
DB_BACKUP_RETENTION_DAYS=14
FULL_BACKUP_RETENTION_DAYS=30
EMERGENCY_BACKUP_RETENTION_DAYS=90
BACKUP_VERIFICATION_MODE=quick_check
RCLONE_REMOTE_NAME=CHANGE_ME

# ==========================================================
# RESOURCE LIMITS (Tuned for 1 OCPU, 6GB RAM OCI Flex)
# FIXED: Reduced total CPU limits from 1.0 to 0.8 for 20% headroom
# ==========================================================
# Memory limits
VAULTWARDEN_MEMORY_LIMIT=1.5g
VAULTWARDEN_MEMORY_RESERVATION=256m
CADDY_MEMORY_LIMIT=256m
CADDY_MEMORY_RESERVATION=64m
FAIL2BAN_MEMORY_LIMIT=128m
FAIL2BAN_MEMORY_RESERVATION=64m

# CPU limits (Total: 0.8 OCPU, leaving 0.2 for system headroom)
VAULTWARDEN_CPU_LIMIT=0.6
VAULTWARDEN_CPU_RESERVATION=0.2
CADDY_CPU_LIMIT=0.15
CADDY_CPU_RESERVATION=0.1
FAIL2BAN_CPU_LIMIT=0.05
FAIL2BAN_CPU_RESERVATION=0.05