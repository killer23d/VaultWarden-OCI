# ----------------------------------------------------------------------
# VaultWarden-OCI .gitattributes
# Normalize line endings and improve GitHub language statistics
# ----------------------------------------------------------------------

# ---------------------------
# GitHub Linguist classification
# ---------------------------

# Force language detection for shell and Makefile
*.sh            linguist-language=Shell
Makefile        linguist-language=Makefile

# Do not count documentation and data/config files as repo languages
*.md            linguist-documentation
*.txt           linguist-documentation
LICENSE         linguist-documentation
*.json          linguist-data
*.yml           linguist-data
*.yaml          linguist-data
*.toml          linguist-data
*.ini           linguist-data
*.conf          linguist-data
*.service       linguist-data
*.timer         linguist-data
*.socket        linguist-data
*.target        linguist-data
*.mount         linguist-data
*.path          linguist-data
*.env           linguist-data
*.env.*         linguist-data

# ---------------------------
# Line ending normalization
# ---------------------------

# Shell scripts must always use LF or Linux shebangs will break
*.sh            text eol=lf

# Make / Docker / env / YAML files should also stay LF
Makefile        text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.mk            text eol=lf
*.env           text eol=lf
*.env.*         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.conf          text eol=lf
*.cfg           text eol=lf
*.cnf           text eol=lf
*.json          text eol=lf

# Web/proxy/security/service configs in this repo should stay LF
Caddyfile       text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.socket        text eol=lf
*.target        text eol=lf
*.mount         text eol=lf
*.path          text eol=lf

# Documentation and plain text
*.md            text eol=lf
*.txt           text eol=lf

# ---------------------------
# Binary files - never modify line endings
# ---------------------------

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.tgz           binary
*.bz2           binary
*.7z            binary
*.age           binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary
*.pem           binary
*.crt           binary
*.cer           binary
*.der           binary
*.key           binary
