# Force language detection for VaultWarden-OCI
*.sh linguist-language=Shell
Makefile linguist-language=Makefile
# Prevent documentation and config files from affecting language stats
*.md linguist-documentation
*.json linguist-data
*.yml linguist-data
*.yaml linguist-data
*.txt linguist-documentation
LICENSE linguist-documentation

# BUG-EP1 FIX: Ensure all shell scripts are checked out with LF line endings
# on every platform (prevents CRLF breaking the shebang line on Windows
# clones that might then be copied to Linux hosts via rsync/scp).
# Note: git does not track execute bits via .gitattributes; the +x bit on
# caddy/entrypoint.sh is tracked in the git object store via
# 'git update-index --chmod=+x' and persists across all clones.
*.sh text eol=lf
