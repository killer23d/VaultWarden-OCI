# VaultWarden-OCI - Production Docker Compose Configuration (SECURITY HARDENED)
#
# SECURITY ENHANCEMENTS APPLIED:
# ✅ Cloudflare token loaded via entrypoint (no command-line exposure)
# ✅ Reduced container capabilities (minimal privilege)
# ✅ Optimized resource limits (appropriate for <10 users)
# ✅ Enhanced security headers and modern isolation
# ✅ Cloudflare WAF rate limiting (edge protection)
# ✅ Fail2Ban SSH protection via host networking (FIXED)
# ✅ Postfix capabilities hardened (CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER only)
# ✅ Log rotation limits on all runtime services (disk-fill prevention)
# ✅ Init container uses find -exec chmod (glob-safe, no silent no-op on empty dirs)
# ✅ vaultwarden network marked internal: true (no unnecessary outbound access)
# ✅ caddy_external network for Caddy ACME + Cloudflare API egress only
# ✅ Secret files mode 444 inside mode-700 directory (all Docker Engine versions)
# ✅ fail2ban db directory root:root 755 (crazymax/fail2ban runs as root)
# ✅ BUG-EM1: SMTP_AUTH_MECHANISM=none + SMTP_EXPLICIT_TLS=false added to vaultwarden env
# ✅ BUG-EM2: Postfix host port 127.0.0.1:587 removed (VW uses Docker network, not host)
# ✅ BUG-EM3: WEBSOCKET_ENABLED default hardened to true (was undefined → empty → disabled)

services:
  # =============================================================================
  # Init Container - Permissions Setup
  # =============================================================================
  init-permissions:
    image: busybox:1.36.1
    container_name: vaultwarden_init
    restart: "no"
    user: "0:0"  # Required for chown operations

    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - FOWNER

    security_opt:
      - no-new-privileges:true

    command: sh -c "
      mkdir -p /logs &&
      chown ${PUID}:${PGID} /logs &&
      mkdir -p /logs/vaultwarden /logs/caddy /logs/fail2ban /logs/postfix &&
      chown -R ${PUID}:${PGID} /data /logs 2>/dev/null || true &&
      find /caddy_data -type d -exec chown ${PUID}:${PGID} {} + 2>/dev/null || true &&
      find /caddy_config -type d -exec chown ${PUID}:${PGID} {} + 2>/dev/null || true &&
      find /data -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /data -type f -exec chmod 640 {} + 2>/dev/null || true &&
      find /logs -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /logs -type f -exec chmod 640 {} + 2>/dev/null || true &&
      find /caddy_data -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /caddy_data -type f -exec chmod 640 {} + 2>/dev/null || true &&
      find /caddy_config -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /caddy_config -type f -exec chmod 640 {} + 2>/dev/null || true &&
      mkdir -p /fail2ban_db &&
      chown 0:0 /fail2ban_db &&
      chmod 755 /fail2ban_db &&
      chmod 700 /secrets /secrets/.docker_secrets 2>/dev/null || true &&
      find /secrets/.docker_secrets -type f -exec chmod 444 {} + 2>/dev/null || true &&
      echo 'Init container completed - permissions set to ${PUID}:${PGID}'
      "

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs:/logs
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/caddy_data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/caddy_config
      # FIX: fail2ban db mounted separately as /fail2ban_db so init sets it
      # root:root 755. crazymax/fail2ban runs as root and requires the db
      # directory to be root-owned; the old /fail2ban mount inherited
      # PUID:PGID ownership which blocked SQLite file creation.
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/fail2ban_db
      - ${PWD}/secrets:/secrets

  # =============================================================================
  # VaultWarden - Main Application
  # =============================================================================
  vaultwarden:
    container_name: vaultwarden_app
    # 1.35.4 — SECURITY RELEASE: fixes GHSA-w9f8-m526-h7fh, GHSA-h4hq-rgvh-wh27,
    # GHSA-r32r-j5jq-3w4m (cipher access bypass + collection permission bypasses)
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.35.4}
    restart: unless-stopped
    user: "${PUID}:${PGID}"

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      DOMAIN: ${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: warn
      EXTENDED_LOGGING: true
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      # BUG-EM3 FIX: was ${WEBSOCKET_ENABLED:-true} but WEBSOCKET_ENABLED is not
      # defined in .env.example, causing Compose to warn and substitute empty string
      # which silently disables WebSockets. Hardcoded to true (always-on for this stack).
      WEBSOCKET_ENABLED: "true"
      # FIX [HIGH-PUSH_ENABLED]: default is false here AND in .env.example.
      # PUSH_ENABLED=true with placeholder push_installation_id /
      # push_installation_key values causes VaultWarden to log a push-relay
      # authentication error on every sync cycle. Only set true after rotating
      # both secrets via: ./edit-secrets.sh --rotate push_installation_id
      #                   ./edit-secrets.sh --rotate push_installation_key
      PUSH_ENABLED: ${PUSH_ENABLED:-false}
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-350000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: CF-Connecting-IP

      # ---------------------------------------------------------------------------
      # Email — VaultWarden → Postfix sidecar (same internal network, no egress needed)
      #
      # VW_SMTP_* vars point at the Postfix sidecar on the internal Docker network.
      # SMTP_* vars (without VW_ prefix) are for the Postfix container's external
      # relay config — do NOT mix them here.
      #
      # BUG-EM1 FIX: SMTP_AUTH_MECHANISM and SMTP_EXPLICIT_TLS MUST be set
      # explicitly.  VaultWarden defaults to SMTP_AUTH_MECHANISM=Plain which
      # causes it to attempt SASL AUTH against Postfix.  The Postfix sidecar
      # accepts unauthenticated relay from the internal Docker network only —
      # there is no AUTH exchange.  Without these two vars, VaultWarden either
      # hangs waiting for an AUTH challenge or fails with "authentication required"
      # depending on the Postfix SASL policy, and NO email leaves the application.
      #
      # Admin UI defaults shown on first boot:
      #   Host: postfix | Port: 587 | Security: Off | Auth: None | User/Pass: empty
      # ---------------------------------------------------------------------------
      SMTP_HOST: ${VW_SMTP_HOST:-postfix}
      SMTP_PORT: ${VW_SMTP_PORT:-587}
      SMTP_SECURITY: ${VW_SMTP_SECURITY:-off}
      # BUG-EM1: These two lines are the critical fix.
      # SMTP_AUTH_MECHANISM=none  — do NOT attempt SASL AUTH against Postfix sidecar
      # SMTP_EXPLICIT_TLS=false   — do NOT attempt STARTTLS/TLS on the plain internal link
      SMTP_AUTH_MECHANISM: ${VW_SMTP_AUTH_MECHANISM:-none}
      SMTP_EXPLICIT_TLS: ${VW_SMTP_EXPLICIT_TLS:-false}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}

      # Push notifications (optional)
      # Requires vaultwarden_app on caddy_external network (see networks: block below).
      # vaultwarden_network internal: true blocks push.bitwarden.com — caddy_external
      # provides the minimum egress needed. PUSH_ENABLED stays false until secrets
      # are rotated via ./edit-secrets.sh --rotate push_installation_id / push_installation_key
      PUSH_RELAY_URI: ${PUSH_RELAY_URI:-https://push.bitwarden.com}
      PUSH_IDENTITY_URI: ${PUSH_IDENTITY_URI:-https://identity.bitwarden.com}
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key

      # Database configuration
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      WEB_VAULT_FOLDER: web-vault/

    secrets:
      - admin_token
      # smtp_password removed: VaultWarden → Postfix (plain, no auth).
      # Postfix holds smtp_password for relay auth only.
      - push_installation_id
      - push_installation_key

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs

    networks:
      - vaultwarden     # internal: true — Caddy + Postfix on isolated network
      - caddy_external  # internet egress for push.bitwarden.com only
                        # Remove this line if push notifications are not needed.

    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1/alive"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    tmpfs:
      - /tmp

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.3'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Caddy - Reverse Proxy with SSL Termination
  # =============================================================================
  caddy:
    container_name: vaultwarden_caddy
    # CaddyBuilds/caddy-cloudflare 2.11.1 — released 2026-02-24
    # >= v2.11.0 bundles caddy-cloudflare-ip BY DEFAULT.
    # This module rewrites remote_ip in access.log to the real client IP
    # sourced from Cf-Connecting-Ip, which is mandatory for fail2ban Caddy
    # filters to ban actual attackers instead of Cloudflare edge nodes.
    # DO NOT downgrade below 2.11.0 without verifying the module is present:
    #   docker run --rm ghcr.io/caddybuilds/caddy-cloudflare:<tag> caddy list-modules | grep cloudflare
    #   Expected: http.ip_sources.cloudflare must appear in output
    image: ghcr.io/caddybuilds/caddy-cloudflare:${CADDY_VERSION:-2.11.1}
    restart: unless-stopped
    user: "${PUID}:${PGID}"

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    entrypoint: /scripts/entrypoint.sh

    environment:
      DOMAIN_NAME: ${DOMAIN_NAME}
      TZ: ${TZ:-UTC}

    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash

    volumes:
      - ${PWD}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${PWD}/caddy/entrypoint.sh:/scripts/entrypoint.sh:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy

    ports:
      - "80:80"
      - "443:443"
      - "127.0.0.1:8080:8080"

    networks:
      - vaultwarden      # reaches vaultwarden_app on the isolated internal network
      - caddy_external   # internet egress for ACME DNS-01 challenges + Cloudflare API

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/alive"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - NET_BIND_SERVICE

    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.25'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Postfix - Email Relay (HARDENED - Minimal Capabilities)
  # =============================================================================
  postfix:
    container_name: vaultwarden_postfix
    # boky/postfix 4.3.0 — latest stable
    image: boky/postfix:${POSTFIX_VERSION:-4.3.0}
    restart: unless-stopped

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      - TZ=${TZ:-UTC}
      - ALLOWED_SENDER_DOMAINS=${ALLOWED_SENDER_DOMAINS:-}
      - RELAYHOST=${SMTP_HOST}:${SMTP_PORT}
      - RELAYHOST_USERNAME=${SMTP_USERNAME}
      - RELAYHOST_PASSWORD_FILE=/run/secrets/smtp_password
      - POSTFIX_myhostname=${POSTFIX_MYHOSTNAME:-postfix}
      - POSTFIX_smtp_tls_security_level=${POSTFIX_SMTP_TLS_SECURITY_LEVEL:-encrypt}
      - POSTFIX_message_size_limit=${POSTFIX_MESSAGE_SIZE_LIMIT:-10240000}

    # SECURITY NOTE [MEDIUM-postfix-sasl_passwd]: boky/postfix writes the SMTP
    # relay password to /etc/postfix/sasl_passwd inside the container as part
    # of its entrypoint (Postfix requires a plaintext file for SASL auth).
    # This is an upstream limitation of the Postfix SASL mechanism — the
    # password cannot be kept exclusively in a Docker secret file at runtime.
    # Mitigation: the file is inside the container filesystem (not a bind
    # mount), not accessible from the host without `docker exec`. Restrict
    # access to the Docker socket and do not grant exec permissions to
    # untrusted operators. Inspect with:
    #   docker exec vaultwarden_postfix cat /etc/postfix/sasl_passwd
    secrets:
      - smtp_password

    # BUG-EM2 FIX: Removed host-side ports: - 127.0.0.1:587:587
    # VaultWarden reaches Postfix via the internal Docker network (postfix:587),
    # not via host loopback. Exposing port 587 on the host allowed any process
    # on the machine to relay mail through Postfix unauthenticated — an open
    # relay risk. No external service needs to reach Postfix directly.
    # If you need to test Postfix from the host: docker exec vaultwarden_postfix ...

    networks:
      - vaultwarden

    healthcheck:
      test: ["CMD", "sh", "-c", "nc -z localhost 587 2>/dev/null"]
      interval: 120s
      timeout: 10s
      retries: 5
      start_period: 60s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
      - DAC_OVERRIDE
      - FOWNER

    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.1'
          pids: 50
        reservations:
          memory: 64M
          cpus: '0.02'

  # =============================================================================
  # Fail2Ban - Intrusion Prevention (HOST NETWORKING for SSH Protection)
  # =============================================================================
  fail2ban:
    container_name: vaultwarden_fail2ban
    # crazymax/fail2ban 1.1.0-r3 — iptables-legacy fix (2024-12-25)
    image: crazymax/fail2ban:${FAIL2BAN_VERSION:-1.1.0-r3}
    restart: unless-stopped

    # HOST networking required for SSH iptables manipulation.
    # ACCEPTED RISK (NEW-3): host network_mode expands the attack surface and
    # bypasses Docker network isolation; this is a deliberate tradeoff.
    network_mode: host

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      TZ: ${TZ:-UTC}
      F2B_LOG_TARGET: STDOUT
      F2B_LOG_LEVEL: INFO
      F2B_DB_PURGE_AGE: 1d
      PACKAGES: whois
      F2B_DEST_MAIL: ${ADMIN_EMAIL}
      F2B_SENDER: fail2ban@${DOMAIN_NAME}
      CF_API_TOKEN_FILE: /run/secrets/fail2ban_cloudflare_firewall_token
      CF_ZONE_ID: ${CLOUDFLARE_ZONE_ID}

    secrets:
      - fail2ban_cloudflare_firewall_token

    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      # FIX: db directory is now root:root 755 (set by init container above).
      # crazymax/fail2ban runs as root and must own this directory to create
      # and write fail2ban.sqlite3. Previously inherited PUID:PGID ownership
      # caused "unable to open database file" on every startup.
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro

    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
      - NET_RAW

    healthcheck:
      test: ["CMD", "fail2ban-client", "status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

    security_opt:
      - no-new-privileges:true

    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.15'
        reservations:
          memory: 128M
          cpus: '0.05'

# =============================================================================
# Docker Secrets Configuration
# =============================================================================
secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token
  fail2ban_cloudflare_firewall_token:
    file: ./secrets/.docker_secrets/fail2ban_cloudflare_firewall_token

# =============================================================================
# Network Configuration
# =============================================================================
networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge
    # internal: true — vaultwarden_app and postfix have no internet egress.
    # Caddy reaches vaultwarden_app via this network only (reverse proxy).
    # Push notifications require either removing internal: true here or
    # adding vaultwarden_app to caddy_external (adds egress risk).
    internal: true

  caddy_external:
    name: caddy_external_network
    driver: bridge
    # internal: false (default) — Caddy-only egress network.
    # Required for:
    #   1. ACME DNS-01 challenge: calls acme-v02.api.letsencrypt.org
    #   2. Cloudflare DNS API: places/removes TXT challenge records
    # No other service is attached to this network, so the blast radius
    # of any Caddy compromise is limited to the Cloudflare API token scope.

# =============================================================================
# DEPLOYMENT NOTES - SECURITY HARDENED EDITION
# =============================================================================
#
# VERSION PINS (updated 2026-03-19):
# - VaultWarden 1.35.4  — SECURITY release, upgrade mandatory
# - Caddy 2.11.1        — caddy-cloudflare-ip bundled by default (>= 2.11.0)
# - Fail2Ban 1.1.0-r3   — iptables-legacy fix
# - Postfix 4.3.0       — latest stable
#
# NETWORK ARCHITECTURE:
#
#   [Internet] ──▶ caddy_external_network ──▶ [Caddy :80/:443]
#                                                    │
#                                          vaultwarden_network (internal)
#                                                    │
#                                    ┌───────────────┴────────────────┐
#                               [VaultWarden]                    [Postfix]
#
#   Fail2Ban: host network (iptables access for SSH banning)
#
# EMAIL FLOW (BUG-EM1 context):
#   VaultWarden → postfix:587 (internal network, no TLS, no AUTH)
#     → Postfix sidecar → external SMTP relay (STARTTLS, SASL auth)
#   VaultWarden must use SMTP_AUTH_MECHANISM=none and SMTP_EXPLICIT_TLS=false.
#   The Postfix sidecar holds SMTP credentials for the external relay leg.
#   VaultWarden itself has NO credentials — authentication is Postfix's job.
#
# CADDY EGRESS (caddy_external):
# Only Caddy has internet egress, via caddy_external_network. This is the
# minimum required for ACME DNS-01 certificate issuance and renewal via
# the Cloudflare API. All other containers remain fully isolated.
#
# CADDY VERSION REQUIREMENT:
# This stack requires caddy-cloudflare >= 2.11.0. The caddy-cloudflare-ip
# module (http.ip_sources.cloudflare) is bundled by default from that version.
# Verify after any Caddy image change:
#   docker run --rm ghcr.io/caddybuilds/caddy-cloudflare:2.11.1 caddy list-modules | grep cloudflare
#   Must see: http.ip_sources.cloudflare
#
# FAIL2BAN DB DIRECTORY:
# /var/lib/vaultwarden/fail2ban must be root:root 755 on the host.
# The init container sets this automatically. If fail2ban reports
# "unable to open database file", verify with:
#   ls -la /var/lib/vaultwarden/fail2ban
#   Must show: drwxr-xr-x root root
#
# SECURITY ENHANCEMENTS APPLIED:
# ✅ Command injection protection (awk-based substitution in setup.sh)
# ✅ Docker secrets loaded via entrypoint (not exposed in command args)
# ✅ Reduced container capabilities (minimal privilege principle)
# ✅ Optimized resource limits (appropriate for <10 users on 6GB system)
# ✅ Enhanced security headers (CORS, COOP, CORP, COEP)
# ✅ Cloudflare WAF rate limiting (edge-based attack mitigation)
# ✅ Modern isolation headers (Spectre mitigation)
# ✅ Init container capability restriction (CHOWN + FOWNER only)
# ✅ Fail2Ban host networking for SSH protection
# ✅ Postfix capabilities hardened (6 caps only)
# ✅ WebSocket support enabled by default
# ✅ Log rotation limits on all runtime services
# ✅ Secret dirs chmod 700, secret files chmod 444 (world-read, dir-protected)
# ✅ vaultwarden network internal: true (app/postfix no egress)
# ✅ caddy_external network for Caddy ACME + Cloudflare API only
# ✅ depends_on condition: service_completed_successfully for init-permissions
# ✅ Healthchecks use 127.0.0.1 (IPv4-explicit, no ::1 ambiguity)
# ✅ fail2ban db directory root:root 755 (fixed SQLite open failure)
# ✅ BUG-EM1: SMTP_AUTH_MECHANISM=none prevents VaultWarden SASL AUTH against Postfix
# ✅ BUG-EM2: Postfix host port 587 removed (no open relay on host loopback)
# ✅ BUG-EM3: WEBSOCKET_ENABLED hardcoded true (was undefined in .env → disabled)
#
# CLOUDFLARE RATE LIMITING (REQUIRED):
# Configure these WAF rules in Cloudflare Dashboard:
#
# Rule #1: Authentication Endpoint Protection
#   - Path: /identity/connect/token*, /api/accounts/prelogin*
#   - Limit: 10 requests per 1 minute per IP
#   - Action: Block (429 response)
#
# Rule #2: Admin Panel Protection
#   - Path: /admin*
#   - Limit: 5 requests per 1 minute per IP
#   - Action: Block (429 response)
#
# Rule #3: General API Protection (Optional)
#   - Path: /api/*
#   - Limit: 100 requests per 1 minute per IP
#   - Action: Managed Challenge (CAPTCHA)
#
# RESOURCE ALLOCATION (OPTIMIZED for <10 users on 6GB system):
# - VaultWarden: 512M limit / 128M reservation
# - Caddy:       512M limit / 128M reservation
# - Fail2Ban:    512M limit / 128M reservation
# - Postfix:     256M limit /  64M reservation (+ pids: 50)
# - Total limits: ~1.8GB (leaves 4.2GB for host OS and overhead)
#
# FAIL2BAN HOST NETWORKING IMPLICATIONS:
# - Fail2Ban shares host network namespace
# - Can directly manipulate host iptables for SSH protection
# - SMTP configured for 127.0.0.1:587 (host-mode compatible)
# - Cannot use networks: directive (mutually exclusive with network_mode: host)
#
# POSTFIX SASL PASSWORD NOTE:
# boky/postfix writes the SMTP relay password to /etc/postfix/sasl_passwd
# inside the container (Postfix SASL requirement). Not exposed on the host
# filesystem but readable via `docker exec`. Restrict Docker socket access.
#
# SECRET FILE PERMISSIONS:
# Host-side secret files are mode 444 inside a mode-700 directory.
# Docker Compose file-based secrets are plain bind-mounts — the container
# sees the exact same permission bits. Older Docker Engine versions silently
# ignore uid/gid/mode in the secrets block, so per-service overrides are
# not used. The mode-700 parent directory prevents traversal by unprivileged
# OS users despite the world-readable file bits.
#
# TESTING CHECKLIST:
# □ Verify Caddy obtains cert:    docker logs -f vaultwarden_caddy
#     Watch for: "certificate obtained successfully","identifier":"bw.lazymocha.com"
# □ Verify site loads:            curl -I https://bw.lazymocha.com
# □ Verify fail2ban db:           docker logs vaultwarden_fail2ban | grep -i error
#     Must be silent (no "unable to open database file")
# □ Verify caddy-cloudflare-ip:
#     docker run --rm ghcr.io/caddybuilds/caddy-cloudflare:2.11.1 caddy list-modules | grep cloudflare
#     Must see: http.ip_sources.cloudflare
# □ Verify network isolation:
#     docker network inspect vaultwarden_network | grep Internal  → "Internal": true
#     docker network inspect caddy_external_network | grep Internal → "Internal": false
# □ Verify fail2ban db dir perms: ls -la /var/lib/vaultwarden/fail2ban
#     Must show: drwxr-xr-x root root
# □ Test basic auth:              curl -u admin:password https://bw.lazymocha.com/admin
# □ Verify secrets not exposed:   docker inspect vaultwarden_caddy | grep CLOUDFLARE
# □ Test Postfix mail:            ./maintenance.sh --test-email --verbose
# □ Test SSH ban:                 trigger 3 failed SSH attempts, verify iptables
# □ Confirm fail2ban real IPs:
#     docker exec vaultwarden_fail2ban fail2ban-client status vaultwarden-web-auth
# □ Check resource usage:         docker stats
# □ Verify VaultWarden SMTP:      check admin UI → SMTP settings show auth=none, TLS=off
#     docker logs vaultwarden_app | grep -i smtp
#
# PLATFORM COMPATIBILITY:
# - SSH_LOG_PATH automatically detected by setup.sh
# - Debian/Ubuntu: /var/log/auth.log (default)
# - RHEL/CentOS/OCI: /var/log/secure (auto-detected)
#
# BACKUP ENCRYPTION KEY RECOVERY (CRITICAL):
# ⚠️  MANDATORY: Backup secrets/keys/age-key.txt to offline storage
# ⚠️  If lost, ALL encrypted backups are permanently unrecoverable
# ⚠️  Test key recovery quarterly (see docs/RECOVERY.md)
#
# POSTFIX CAPABILITY NOTES:
# The postfix service grants exactly 6 capabilities (all others dropped):
#   CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER
# DAC_OVERRIDE and FOWNER are required for mail spool access and must
# not be removed. Verify with:
#   docker inspect vaultwarden_postfix | grep -A20 CapAdd
#
# =============================================================================
