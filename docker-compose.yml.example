# VaultWarden-OCI - Production Docker Compose Configuration
# ENHANCED: Added container resource limits for 6GB system
# ENHANCED: Added timezone consistency across all containers
# ENHANCED: Replaced mailutils with msmtpd sidecar for improved email reliability
# FIXED: OCI/Oracle Linux compatibility for SSH log monitoring
# High-fidelity security detection + Built-in email notifications + Resource management

services:
  vaultwarden:
    container_name: vaultwarden_app
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.30.5}
    restart: unless-stopped
    user: "${PUID}:${PGID}"
    environment:
      # Core Configuration
      DOMAIN: https://${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}

      # FIXED: High-fidelity logging for Fail2Ban
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: warn
      EXTENDED_LOGGING: true

      # Security Configuration  
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      WEBSOCKET_ENABLED: ${WEBSOCKET_ENABLED:-false}
      PUSH_ENABLED: ${PUSH_ENABLED:-false}

      # Advanced Security
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-350000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: CF-Connecting-IP

      # Email Configuration (optional)
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_SECURITY: ${SMTP_SECURITY:-starttls}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD_FILE: /run/secrets/smtp_password
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}

      # Push Notifications (optional)
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key

      # Performance
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      WEB_VAULT_FOLDER: web-vault/

    secrets:
      - admin_token
      - smtp_password  
      - push_installation_id
      - push_installation_key
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      # FIXED: Mount logs directory for Fail2Ban access
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs
    depends_on:
      - caddy
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/alive"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    # ENHANCED: Resource limits for 6GB system (balanced allocation)
    deploy:
      resources:
        limits:
          memory: 2G      # Main application, largest allocation
          cpus: '0.6'     # 60% of single CPU
        reservations:
          memory: 1G    # Minimum guaranteed memory
          cpus: '0.2'     # 20% of single CPU minimum

  caddy:
    container_name: vaultwarden_caddy
    image: ghcr.io/caddybuilds/caddy-cloudflare:${CADDY_VERSION:-2.8.4}-cloudflare
    restart: unless-stopped
    user: "${PUID}:${PGID}"
    environment:
      DOMAIN: ${DOMAIN}
      CLOUDFLARE_API_TOKEN_FILE: /run/secrets/caddy_cloudflare_dns_token
      ADMIN_BASIC_AUTH_HASH_FILE: /run/secrets/admin_basic_auth_hash
      TZ: ${TZ:-UTC}
    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash  
    volumes:
      - ${PWD}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy
    ports:
      - "80:80"
      - "443:443"
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "caddy", "validate", "--config", "/etc/caddy/Caddyfile"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    # ENHANCED: Resource limits for reverse proxy
    deploy:
      resources:
        limits:
          memory: 1G      # Reverse proxy with SSL termination
          cpus: '0.3'     # 30% of single CPU
        reservations:
          memory: 256M    # Minimum for SSL operations
          cpus: '0.1'     # 10% of single CPU minimum

  # NEW: Lightweight SMTP relay using msmtpd
  msmtpd:
    container_name: vaultwarden_msmtpd
    image: crazymax/msmtpd:${MSMTPD_VERSION:-1.0.0}
    restart: unless-stopped
    environment:
      - SMTP_HOST=${SMTP_HOST:-}
      - SMTP_PORT=${SMTP_PORT:-587} 
      - SMTP_TLS=${SMTP_SECURITY:-on}
      - SMTP_STARTTLS=${SMTP_STARTTLS:-on}
      - SMTP_TLS_CHECKCERT=${SMTP_TLS_CHECKCERT:-on}
      - SMTP_AUTH=${SMTP_AUTH:-on}
      - SMTP_USER=${SMTP_USERNAME:-}
      - SMTP_PASSWORD_FILE=/run/secrets/smtp_password
      - SMTP_FROM=${SMTP_FROM:-}
      - TZ=${TZ:-UTC}
    secrets:
      - smtp_password
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/msmtpd:/var/log
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "1025"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # ENHANCED: Minimal resource allocation for SMTP relay
    deploy:
      resources:
        limits:
          memory: 32M     # Very lightweight SMTP relay
          cpus: '0.05'    # 5% of single CPU
        reservations:
          memory: 8M      # Minimal memory reservation
          cpus: '0.01'    # 1% of single CPU minimum

  fail2ban:
    container_name: vaultwarden_fail2ban
    image: crazymax/fail2ban:${FAIL2BAN_VERSION:-1.1.0}
    restart: unless-stopped
    environment:
      TZ: ${TZ:-UTC}
      F2B_LOG_TARGET: STDOUT
      F2B_LOG_LEVEL: INFO
      F2B_DB_PURGE_AGE: 1d
      # Email configuration via msmtpd sidecar
      F2B_DEST_MAIL: ${ADMIN_EMAIL}
      F2B_SENDER: fail2ban@${DOMAIN}
      # Cloudflare integration
      CF_API_TOKEN_FILE: /run/secrets/fail2ban_cloudflare_firewall_token  
      CF_ZONE_ID: ${CLOUDFLARE_ZONE_ID}
    secrets:
      - fail2ban_cloudflare_firewall_token
    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      # FIXED: Mount VaultWarden logs for high-fidelity parsing
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      # FIXED: Platform-specific SSH log mounting for OCI compatibility
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro
      # REMOVED: Host mailutil mounts (replaced by msmtpd sidecar)
    cap_add:
      - NET_ADMIN
      - NET_RAW
    depends_on:
      - vaultwarden
      - caddy
      - msmtpd  # NEW: Depend on email sidecar
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "fail2ban-client", "status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    security_opt:
      - no-new-privileges:true
    # ENHANCED: Resource limits for security monitoring
    deploy:
      resources:
        limits:
          memory: 1G    # Log parsing and rule processing
          cpus: '0.2'     # 20% of single CPU
        reservations:
          memory: 256M    # Minimum for log processing
          cpus: '0.05'    # 5% of single CPU minimum

secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token
  fail2ban_cloudflare_firewall_token:
    file: ./secrets/.docker_secrets/fail2ban_cloudflare_firewall_token

networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge

# Production deployment notes:
# - Uses pinned versions for stability (override with environment variables)
# - All secrets managed via Docker secrets for enhanced security
# - Comprehensive health checks for all services  
# - Proper dependency management and startup ordering
# - Cloudflare integration for DNS and global IP blocking
# - High-fidelity VaultWarden log parsing for accurate Fail2Ban detection
# - ENHANCED: Email notifications via lightweight msmtpd sidecar (replaces mailutils)
# - Enhanced security with no-new-privileges and capability restrictions
# - Clean configuration focused on core functionality
# - FIXED: OCI/Oracle Linux SSH log compatibility
# 
# ENHANCED FEATURES:
# - Resource limits prevent container resource exhaustion on 6GB system
# - Timezone consistency across all containers for proper log correlation
# - Balanced resource allocation: VaultWarden (2G), Caddy (1G), Fail2Ban (512M), msmtpd (32M)
# - CPU limits ensure fair scheduling and prevent single container monopolization
# - Memory reservations guarantee minimum resources for stable operation
# - Platform-specific SSH log detection for multi-distro compatibility
# - Containerized email solution eliminates host dependencies
# 
# RESOURCE ALLOCATION STRATEGY (for 6GB system):
# - Total container limits: ~3.5GB (leaves 2.5GB for host OS and overhead)
# - VaultWarden: 2GB limit (main application, database operations)
# - Caddy: 1GB limit (SSL termination, reverse proxy, log processing)
# - Fail2Ban: 512MB limit (log parsing, rule processing)
# - msmtpd: 32MB limit (lightweight SMTP relay)
# - Remaining ~2.5GB: Host OS, kernel, Docker daemon, buffers/cache
#
# PLATFORM COMPATIBILITY:
# - SSH_LOG_PATH automatically detects correct SSH log location
# - Debian/Ubuntu: /var/log/auth.log (default fallback)
# - RHEL/CentOS/OCI: /var/log/secure (detected by setup script)
# - Universal container mount point: /var/log/ssh-auth.log
# - Email functionality completely containerized (no host dependencies)
