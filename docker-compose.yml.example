# VaultWarden-OCI - Production Docker Compose Configuration

services:
  # Init container to enforce correct permissions on every startup (set-and-forget)
  # ENHANCED: Now also fixes secrets directory permissions for Docker access
  init-permissions:
    image: busybox:latest
    container_name: vaultwarden_init
    restart: "no"
    user: "0:0"
    command: sh -c "
      chown -R ${PUID}:${PGID} /data /logs /caddy_data /caddy_config /fail2ban && 
      chmod -R 755 /data /logs /caddy_data /caddy_config /fail2ban &&
      chmod 755 /secrets /secrets/.docker_secrets &&
      chmod 644 /secrets/.docker_secrets/*
      "
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/caddy_data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/caddy_config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/fail2ban
      - ${PWD}/secrets:/secrets

  vaultwarden:
    container_name: vaultwarden_app
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.30.5}
    restart: unless-stopped
    user: "${PUID}:${PGID}"
    environment:
      DOMAIN: https://${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: warn
      EXTENDED_LOGGING: true
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      WEBSOCKET_ENABLED: ${WEBSOCKET_ENABLED:-false}
      PUSH_ENABLED: ${PUSH_ENABLED:-false}
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-350000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: CF-Connecting-IP
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_SECURITY: ${SMTP_SECURITY:-starttls}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD_FILE: /run/secrets/smtp_password
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      WEB_VAULT_FOLDER: web-vault/
    secrets:
      - admin_token
      - smtp_password
      - push_installation_id
      - push_installation_key
    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs
    depends_on:
      caddy:
        condition: service_started
      init-permissions:
        condition: service_completed_successfully
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/alive"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: '0.6'
        reservations:
          memory: 1G
          cpus: '0.2'

  caddy:
    container_name: vaultwarden_caddy
    image: ghcr.io/caddybuilds/caddy-cloudflare:${CADDY_VERSION:-2.10.2}
    restart: unless-stopped
    user: "${PUID}:${PGID}"
    command: sh -c 'export CLOUDFLARE_API_TOKEN=$$(cat /run/secrets/caddy_cloudflare_dns_token) && export ADMIN_BASIC_AUTH_HASH=$$(cat /run/secrets/admin_basic_auth_hash) && caddy run --config /etc/caddy/Caddyfile --adapter caddyfile'
    environment:
      DOMAIN: ${DOMAIN}
      ADMIN_BASIC_AUTH_HASH_FILE: /run/secrets/admin_basic_auth_hash
      TZ: ${TZ:-UTC}
    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash
    volumes:
      - ${PWD}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      init-permissions:
        condition: service_completed_successfully
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '0.3'
        reservations:
          memory: 256M
          cpus: '0.1'

  postfix:
    container_name: vaultwarden_postfix
    image: boky/postfix:${POSTFIX_VERSION:-latest}
    restart: unless-stopped
    environment:
      - HOSTNAME=${POSTFIX_HOSTNAME:-postfix}
      - RELAYHOST=${SMTP_HOST:-}
      - RELAYHOST_USERNAME=${SMTP_USERNAME:-}
      - RELAYHOST_PASSWORD=${SMTP_PASSWORD:-}
      - ALLOWED_SENDER_DOMAINS=${ALLOWED_SENDER_DOMAINS:-}
      - RELAYHOST_TLS_LEVEL=${POSTFIX_TLS_LEVEL:-encrypt}
      - MESSAGE_SIZE_LIMIT=${POSTFIX_MESSAGE_SIZE_LIMIT:-10240000}
      - TZ=${TZ:-UTC}
    secrets:
      - source: smtp_password
        target: /run/secrets/smtp_password
    ports:
      - "127.0.0.1:587:587"
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "587"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: '0.1'
        reservations:
          memory: 32M
          cpus: '0.02'

  fail2ban:
    container_name: vaultwarden_fail2ban
    image: crazymax/fail2ban:${FAIL2BAN_VERSION:-1.1.0}
    restart: unless-stopped
    environment:
      TZ: ${TZ:-UTC}
      F2B_LOG_TARGET: STDOUT
      F2B_LOG_LEVEL: INFO
      F2B_DB_PURGE_AGE: 1d
      PACKAGES: whois
      F2B_DEST_MAIL: ${ADMIN_EMAIL}
      F2B_SENDER: fail2ban@${DOMAIN}
      CF_API_TOKEN_FILE: /run/secrets/fail2ban_cloudflare_firewall_token
      CF_ZONE_ID: ${CLOUDFLARE_ZONE_ID}
    secrets:
      - fail2ban_cloudflare_firewall_token
    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro
    cap_add:
      - NET_ADMIN
      - NET_RAW
    depends_on:
      - vaultwarden
      - caddy
      - postfix
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "fail2ban-client", "status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '0.2'
        reservations:
          memory: 256M
          cpus: '0.05'

secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token
  fail2ban_cloudflare_firewall_token:
    file: ./secrets/.docker_secrets/fail2ban_cloudflare_firewall_token

networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge

# Production deployment notes:
# - Uses pinned versions for stability (override with environment variables)
# - All secrets managed via Docker secrets for enhanced security
# - Comprehensive health checks for all services  
# - Proper dependency management and startup ordering
# - Cloudflare integration for DNS and global IP blocking
# - High-fidelity VaultWarden log parsing for accurate Fail2Ban detection
# - ENHANCED: Email notifications via bokysan/docker-postfix (replaces msmtpd)
# - Enhanced security with no-new-privileges and capability restrictions
# - Clean configuration focused on core functionality
# - FIXED: OCI/Oracle Linux SSH log compatibility
# - FIXED: Caddy Cloudflare API token read from Docker secret into environment variable
# - FIXED: Caddy health check now tests service availability (not config validation)
# - FIXED: Init container handles secrets directory permissions for Docker access
# - FIXED: postfix using standard port 587 for SMTP relay
# 
# ENHANCED FEATURES:
# - Resource limits prevent container resource exhaustion on 6GB system
# - Timezone consistency across all containers for proper log correlation
# - Balanced resource allocation: VaultWarden (2G), Caddy (1G), Fail2Ban (1G), postfix (128M)
# - CPU limits ensure fair scheduling and prevent single container monopolization
# - Memory reservations guarantee minimum resources for stable operation
# - Platform-specific SSH log detection for multi-distro compatibility
# - Containerized email solution eliminates host dependencies
# - Secure token handling: Read from Docker secrets into container memory only
# - Automatic permissions fixing on every startup for set-and-forget operation
# - Non-root container execution following security best practices
# 
# RESOURCE ALLOCATION STRATEGY (for 6GB system):
# - Total container limits: ~4GB (leaves 2GB for host OS and overhead)
# - VaultWarden: 2GB limit (main application, database operations)
# - Caddy: 1GB limit (SSL termination, reverse proxy, log processing)
# - Fail2Ban: 1GB limit (log parsing, rule processing)
# - postfix: 128MB limit (SMTP relay with full postfix features)
# - Remaining ~2GB: Host OS, kernel, Docker daemon, buffers/cache
#
# PLATFORM COMPATIBILITY:
# - SSH_LOG_PATH automatically detects correct SSH log location
# - Debian/Ubuntu: /var/log/auth.log (default fallback)
# - RHEL/CentOS/OCI: /var/log/secure (detected by setup script)
# - Universal container mount point: /var/log/ssh-auth.log
# - Email functionality completely containerized (no host dependencies)
# - Automatic secrets permissions fixing ensures Docker can access secrets
# - postfix provides full SMTP server functionality with relay support
#
# POSTFIX CONFIGURATION:
# - Uses bokysan/docker-postfix for reliable email relay
# - Supports TLS encryption for secure email transmission
# - Configurable message size limits and sender domains
# - Healthcheck validates SMTP port 587 availability
# - Integrated with Docker secrets for secure credential management
# - Resource-efficient with 128MB limit and 32MB reservation
