# VaultWarden-OCI production compose
# Service order: init-permissions -> vaultwarden + caddy -> postfix
# Finish .env and secrets setup before starting the stack.
#
# Storage note:
# All persistent bind mounts live under PROJECT_STATE_DIR.
# When DATA_VOLUME_DEVICE is set, PROJECT_STATE_DIR must equal DATA_VOLUME_MOUNT
# and the volume must be mounted before Docker starts. Use startup.sh or the
# installed systemd units so Docker never writes state back to the boot volume.

services:
  # -------------------- Mandatory startup: permissions init --------------------
  init-permissions:
    image: busybox:${BUSYBOX_VERSION:-1.36.1}
    container_name: vaultwarden_init
    restart: "no"
    user: "0:0"  # Required for chown/chmod operations

    cap_drop:
      - ALL
    cap_add:
      - CHOWN       # chown files/dirs to PUID:PGID and root:root
      - FOWNER      # bypass permission checks when process UID != file owner UID for some ops
      - DAC_OVERRIDE  # bypass DAC checks — required to chmod files/dirs after chown transfers
                      # ownership away from root (without this, chmod on ubuntu-owned dirs = EPERM)

    security_opt:
      - no-new-privileges:true

    command:
      - sh
      - -c
      - |
        [ -d /secrets/.docker_secrets ] || {
          echo 'ERROR: /secrets/.docker_secrets not found.' >&2
          echo '       Run: sudo make setup  (or: sudo ./setup.sh --domain <domain> --email <email>)' >&2
          exit 1
        } &&
        [ -f /secrets/.docker_secrets/admin_token ] || {
          echo 'ERROR: /secrets/.docker_secrets/admin_token missing — setup may be incomplete.' >&2
          echo '       Run: sudo make setup' >&2
          exit 1
        } &&

        SENTINEL='/data/.permissions-initialized' &&
        NOW=$$(date +%s) &&
        SENTINEL_AGE=86400 &&
        if [ -f "$$SENTINEL" ] && [ $$(( NOW - $$(stat -c %Y "$$SENTINEL" 2>/dev/null || echo 0) )) -lt $$SENTINEL_AGE ]; then
          echo 'Permissions initialized within 24h, skipping full scan.'
          exit 0
        fi &&

        mkdir -p /data /logs/vaultwarden /logs/caddy /logs/postfix &&

        touch /logs/caddy/access.log /logs/caddy/security.log &&
        chown 0:0 /logs/caddy/access.log /logs/caddy/security.log &&
        chmod 644 /logs/caddy/access.log /logs/caddy/security.log &&

        chown -R ${PUID}:${PGID} /data /logs &&
        find /data -type d -exec chmod 750 {} + 2>/dev/null || true &&
        find /data -type f -exec chmod 640 {} + 2>/dev/null || true &&
        find /logs -type d -exec chmod 750 {} + 2>/dev/null || true &&
        find /logs -path '*/caddy' -prune -o -type f -exec chmod 640 {} + 2>/dev/null || true &&

        chmod 755 /logs/caddy &&

        chown 0:0 /logs/caddy/access.log /logs/caddy/security.log &&
        chmod 644 /logs/caddy/access.log /logs/caddy/security.log &&

        mkdir -p /data/caddy /config/caddy &&
        chown 0:0 /data/caddy /config/caddy &&
        chmod 755 /data/caddy /config/caddy &&

        mkdir -p /data/caddy/certificates /data/caddy/locks /data/caddy/ocsp &&
        chown -R 0:0 /data/caddy &&
        find /data/caddy -type d -exec chmod 755 {} + 2>/dev/null || true &&

        chmod 700 /secrets 2>/dev/null || true &&
        chown 0:${PGID} /secrets/.docker_secrets 2>/dev/null || true &&
        chmod 750 /secrets/.docker_secrets 2>/dev/null || true &&
        find /secrets/.docker_secrets -type f -exec chmod 444 {} + 2>/dev/null || true &&

        touch /secrets/.docker_secrets/push_installation_id &&
        touch /secrets/.docker_secrets/push_installation_key &&
        chown ${PUID}:${PGID} /secrets/.docker_secrets/push_installation_id /secrets/.docker_secrets/push_installation_key &&
        chmod 444 /secrets/.docker_secrets/push_installation_id &&
        chmod 444 /secrets/.docker_secrets/push_installation_key &&

        touch "$$SENTINEL" &&
        echo 'Init container completed - permissions set to ${PUID}:${PGID}'

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs:/logs
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data/caddy
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config/caddy
      - ./secrets:/secrets

  # -------------------- Core service: VaultWarden --------------------
  vaultwarden:
    container_name: vaultwarden_app
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.35.4}
    restart: unless-stopped
    user: "${PUID}:${PGID}"
    # memswap_limit equal to mem_limit disables swap for this container, preventing
    # decrypted secrets and DB content from being paged to disk. Must be a top-level
    # service property — not under deploy.resources.limits — to be applied by
    # docker compose in standalone (non-Swarm) mode.
    mem_limit: 512M
    memswap_limit: 512M

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      DOMAIN: ${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: ${LOG_LEVEL:-warn}
      EXTENDED_LOGGING: ${EXTENDED_LOGGING:-true}
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      WEBSOCKET_ENABLED: ${WEBSOCKET_ENABLED:-true}
      DISABLE_ADMIN_TOKEN: ${DISABLE_ADMIN_TOKEN:-false}
      DISABLE_ICON_DOWNLOAD: ${DISABLE_ICON_DOWNLOAD:-false}
      ICON_CACHE_TTL: ${ICON_CACHE_TTL:-2592000}
      ICON_CACHE_NEGTTL: ${ICON_CACHE_NEGTTL:-259200}
      ORG_CREATION_USERS: ${ORG_CREATION_USERS:-}
      ORG_EVENTS_ENABLED: ${ORG_EVENTS_ENABLED:-false}
      EVENTS_DAYS_RETAIN: ${EVENTS_DAYS_RETAIN:-365}
      TRASH_AUTO_DELETE_DAYS: ${TRASH_AUTO_DELETE_DAYS:-30}
      INCOMPLETE_2FA_TIME_LIMIT: ${INCOMPLETE_2FA_TIME_LIMIT:-3}
      PUSH_ENABLED: ${PUSH_ENABLED:-false}
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-600000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: ${IP_HEADER:-CF-Connecting-IP}
      SMTP_HOST: ${VW_SMTP_HOST:-postfix}
      SMTP_PORT: ${VW_SMTP_PORT:-587}
      SMTP_SECURITY: ${VW_SMTP_SECURITY:-off}
      SMTP_EXPLICIT_TLS: ${VW_SMTP_EXPLICIT_TLS:-false}
      SMTP_AUTH_MECHANISM: ${VW_SMTP_AUTH_MECHANISM:-none}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}
      PUSH_RELAY_URI: ${PUSH_RELAY_URI:-https://push.bitwarden.com}
      PUSH_IDENTITY_URI: ${PUSH_IDENTITY_URI:-https://identity.bitwarden.com}
      # _FILE vars are always set; init-permissions creates placeholder files.
      # VaultWarden ignores them until PUSH_ENABLED=true and both secrets are populated.
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      DATABASE_TIMEOUT: ${DATABASE_TIMEOUT:-30}
      WEB_VAULT_FOLDER: ${WEB_VAULT_FOLDER:-web-vault/}

    secrets:
      - admin_token
      - push_installation_id
      - push_installation_key

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs

    networks:
      - vaultwarden
      - vaultwarden_egress

    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent --max-time 5 http://127.0.0.1:80/alive || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
      - /run:size=16m,mode=0755

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
      nproc:
        soft: 512
        hard: 512

    # NOTE: deploy.resources is evaluated only in Docker Swarm mode.
    # In standalone 'docker compose', cpu and pid limits are silently ignored.
    # Memory enforcement uses the top-level mem_limit / memswap_limit above.
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.3'
          pids: 200
        reservations:
          memory: 128M
          cpus: '0.1'

  # -------------------- Core service: Caddy reverse proxy --------------------
  caddy:
    container_name: vaultwarden_caddy
    build:
      context: ./caddy
      dockerfile: Dockerfile
      args:
        # Passes the pinned version from .env into the Dockerfile ARG.
        # Run: docker compose build --pull --no-cache caddy
        # after changing CADDY_VERSION in .env to rebuild both stages.
        # Do NOT set CADDY_VERSION=latest — xcaddy builds must be pinned.
        CADDY_VERSION: ${CADDY_VERSION:-2.11.4}
    restart: unless-stopped
    user: "2000:2000"

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    entrypoint: /scripts/entrypoint.sh

    environment:
      DOMAIN: ${DOMAIN}
      TZ: ${TZ:-UTC}
      TLS_PROVIDER: ${TLS_PROVIDER:-cloudflare}
      # Default to localhost-only when unset to avoid a silent deny-all on /admin.
      ADMIN_ALLOW_CIDR: ${ADMIN_ALLOW_CIDR:-127.0.0.1/32}
      PUSH_ENABLED: ${PUSH_ENABLED:-false}

    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash

    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy/Caddyfile.degraded:/etc/caddy/Caddyfile.degraded:ro
      - ./caddy/entrypoint.sh:/scripts/entrypoint.sh:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy

    ports:
      - "80:80"
      - "443:443"
      - "127.0.0.1:8080:8080"

    networks:
      - vaultwarden
      - caddy_external

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/alive"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - NET_BIND_SERVICE

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
      nproc:
        soft: 512
        hard: 512

    # NOTE: deploy.resources is evaluated only in Docker Swarm mode.
    # In standalone 'docker compose', cpu and pid limits are silently ignored.
    # Memory enforcement uses the top-level mem_limit / memswap_limit above.
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.25'
          pids: 200
        reservations:
          memory: 128M
          cpus: '0.1'

  # -------------------- Optional sidecar: Postfix relay --------------------
  postfix:
    container_name: vaultwarden_postfix
    image: boky/postfix:${POSTFIX_VERSION:-4.3.0}
    restart: unless-stopped

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      - TZ=${TZ:-UTC}
      - ALLOWED_SENDER_DOMAINS=${ALLOWED_SENDER_DOMAINS:-}
      - "RELAYHOST=${SMTP_HOST}:${SMTP_PORT}"
      - RELAYHOST_USERNAME=${SMTP_USERNAME}
      - RELAYHOST_PASSWORD_FILE=/run/secrets/smtp_password
      - POSTFIX_myhostname=${POSTFIX_MYHOSTNAME:-postfix}
      - POSTFIX_smtp_tls_security_level=${POSTFIX_SMTP_TLS_SECURITY_LEVEL:-encrypt}
      - POSTFIX_message_size_limit=${POSTFIX_MESSAGE_SIZE_LIMIT:-10240000}
      - POSTFIX_alias_maps=
      - POSTFIX_alias_database=

    secrets:
      - smtp_password

    ports:
      - "127.0.0.1:587:587"

    networks:
      # VaultWarden reaches the relay sidecar at hostname `postfix` on this network.
      - vaultwarden
      - postfix_relay

    healthcheck:
      # Confirm both the Postfix process and the upstream relay socket respond.
      # Use `echo QUIT | nc` because the BusyBox nc in this image does not support `-q`.
      test: ["CMD-SHELL", "postfix status 2>/dev/null && (echo QUIT | nc -w 3 ${SMTP_HOST:-localhost} ${SMTP_PORT:-587} 2>/dev/null | grep -q '^2') || exit 1"]
      interval: 120s
      timeout: 15s
      retries: 5
      start_period: 60s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
      - DAC_OVERRIDE
      - FOWNER

    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    # NOTE: deploy.resources is evaluated only in Docker Swarm mode.
    # In standalone 'docker compose', cpu and pid limits are silently ignored.
    # Memory enforcement uses the top-level mem_limit / memswap_limit above.
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.1'
          pids: 50
        reservations:
          memory: 64M
          cpus: '0.02'

# =============================================================================
# Docker Secrets
# =============================================================================
secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token

# =============================================================================
# Networks
# =============================================================================
networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge
    internal: true

  # vaultwarden_egress — outbound-only internet path for the vaultwarden_app container.
  # Named *_egress to signal one-directional purpose: app → internet (HIBP, push/identity).
  # Caddy does NOT join this network; it uses caddy_external for its own outbound needs.
  # Keeping them separate enforces the security boundary: if Caddy is compromised, it
  # cannot reach VaultWarden's egress path and vice-versa.
  vaultwarden_egress:
    name: vaultwarden_egress_network
    driver: bridge
    internal: false  # explicit: outbound-only internet path for vaultwarden_app
    ipam:
      config:
        - subnet: 172.21.0.0/16

  # caddy_external — inbound + outbound path for the Caddy reverse proxy.
  # Named *_external (not *_egress) because traffic is bidirectional: inbound
  # public requests arrive on ports 80/443, and Caddy also makes outbound calls
  # (ACME/Let's Encrypt, Cloudflare DNS-01). Intentionally separate from
  # vaultwarden_egress so the two services' internet paths remain air-gapped.
  # Pinned subnet keeps this network deterministic and within RFC1918 space
  # already allowed by the DOCKER-USER catch-all in setup-iptables.sh.
  caddy_external:
    name: caddy_external_network
    driver: bridge
    internal: false  # explicit: inbound (80/443) + outbound (ACME, CF DNS) for Caddy
    ipam:
      config:
        - subnet: 172.22.0.0/16

  # Dedicated non-internal bridge for postfix host port-binding.
  postfix_relay:
    name: postfix_relay_network
    driver: bridge
    internal: false
    ipam:
      config:
        - subnet: 172.23.0.0/16
