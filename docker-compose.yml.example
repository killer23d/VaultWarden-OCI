# VaultWarden-OCI - Production Docker Compose Configuration (SECURITY HARDENED)
#
# SECURITY ENHANCEMENTS APPLIED:
# ✅ Cloudflare token loaded via entrypoint (no command-line exposure)
# ✅ Reduced container capabilities (minimal privilege)
# ✅ Optimized resource limits (appropriate for <10 users)
# ✅ Enhanced security headers and modern isolation
# ✅ Cloudflare WAF rate limiting (edge protection)
# ✅ Fail2Ban SSH protection via host networking (FIXED)
# ✅ Postfix capabilities hardened (CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER only — KILL and others dropped)
# ✅ Log rotation limits on all runtime services (disk-fill prevention)

services:
  # =============================================================================
  # Init Container - Permissions Setup
  # =============================================================================
  # SECURITY NOTE: This container runs as root (user: "0:0") but only during
  # startup to fix ownership. Consider moving to one-time setup.sh operation
  # for enhanced security (see docs/SECURITY.md).
  init-permissions:
    image: busybox:latest
    container_name: vaultwarden_init
    restart: "no"
    user: "0:0"  # Required for chown operations

    # SECURITY: Restrict capabilities even for root user
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - FOWNER

    # SECURITY: No new privileges
    security_opt:
      - no-new-privileges:true

    command: sh -c "
      mkdir -p /logs &&
      chown ${PUID}:${PGID} /logs &&
      mkdir -p /logs/vaultwarden /logs/caddy /logs/fail2ban /logs/postfix &&
      chown -R ${PUID}:${PGID} /data /logs /fail2ban 2>/dev/null || true &&
      find /caddy_data -type d -exec chown ${PUID}:${PGID} {} + 2>/dev/null || true &&
      find /caddy_config -type d -exec chown ${PUID}:${PGID} {} + 2>/dev/null || true &&
      chmod -R 755 /data /logs /caddy_data /caddy_config /fail2ban 2>/dev/null || true &&
      chmod 755 /secrets /secrets/.docker_secrets 2>/dev/null || true &&
      chmod 644 /secrets/.docker_secrets/* 2>/dev/null || true &&
      echo 'Init container completed - permissions set to ${PUID}:${PGID}'
      "

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs:/logs
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/caddy_data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/caddy_config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/fail2ban
      - ${PWD}/secrets:/secrets

  # =============================================================================
  # VaultWarden - Main Application
  # =============================================================================
  vaultwarden:
    container_name: vaultwarden_app
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.30.5}
    restart: unless-stopped
    user: "${PUID}:${PGID}"

    environment:
      DOMAIN: ${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: warn
      EXTENDED_LOGGING: true
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      WEBSOCKET_ENABLED: ${WEBSOCKET_ENABLED:-true}
      PUSH_ENABLED: ${PUSH_ENABLED:-false}
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-350000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: CF-Connecting-IP

      # Email configuration (via Postfix relay)
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_SECURITY: ${SMTP_SECURITY:-starttls}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD_FILE: /run/secrets/smtp_password
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}

      # Push notifications (optional)
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key

      # Database configuration
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      WEB_VAULT_FOLDER: web-vault/

    secrets:
      - admin_token
      - smtp_password
      - push_installation_id
      - push_installation_key

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs

    depends_on:
      caddy:
        condition: service_started

    networks:
      - vaultwarden

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/alive"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    tmpfs:
      - /tmp

    # LOG ROTATION: Cap Docker json-file driver to prevent disk fill.
    # VaultWarden logs at warn-level only; 10m x 5 = 50MB worst-case.
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

    # OPTIMIZED: Resource limits for <10 users
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.3'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Caddy - Reverse Proxy with SSL Termination
  # =============================================================================
  caddy:
    container_name: vaultwarden_caddy
    image: ghcr.io/caddybuilds/caddy-cloudflare:${CADDY_VERSION:-2.10.2}
    restart: unless-stopped
    user: "${PUID}:${PGID}"

    # Use custom entrypoint script for secret loading
    entrypoint: /scripts/entrypoint.sh

    environment:
      DOMAIN_NAME: ${DOMAIN_NAME}
      TZ: ${TZ:-UTC}
      # Note: CLOUDFLARE_API_TOKEN and ADMIN_BASIC_AUTH_HASH
      # are set by entrypoint.sh from Docker secrets

    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash

    volumes:
      - ${PWD}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${PWD}/caddy/entrypoint.sh:/scripts/entrypoint.sh:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy

    ports:
      - "80:80"
      - "443:443"
      - "127.0.0.1:8080:8080"

    networks:
      - vaultwarden

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/alive"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - NET_BIND_SERVICE

    # LOG ROTATION: Caddy writes one access-log line per request; give it the
    # largest budget. 20m x 5 = 100MB worst-case. Caddy also writes structured
    # logs to /var/log/caddy (volume-mounted); this caps the Docker stdout copy.
    logging:
      driver: "json-file"
      options:
        max-size: "20m"
        max-file: "5"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.25'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Postfix - Email Relay (HARDENED - Minimal Capabilities)
  # =============================================================================
  postfix:
    container_name: vaultwarden_postfix
    image: boky/postfix:${POSTFIX_VERSION:-latest}
    restart: unless-stopped

    environment:
      - TZ=${TZ:-UTC}
      - ALLOWED_SENDER_DOMAINS=${ALLOWED_SENDER_DOMAINS:-}
      - RELAYHOST=${SMTP_HOST}:${SMTP_PORT}
      - RELAYHOST_USERNAME=${SMTP_USERNAME}
      - RELAYHOST_PASSWORD_FILE=/run/secrets/smtp_password
      - POSTFIX_myhostname=${POSTFIX_MYHOSTNAME:-postfix}
      - POSTFIX_smtp_tls_security_level=${POSTFIX_SMTP_TLS_SECURITY_LEVEL:-encrypt}
      - POSTFIX_message_size_limit=${POSTFIX_MESSAGE_SIZE_LIMIT:-10240000}

    secrets:
      - smtp_password

    ports:
      - "127.0.0.1:587:587"

    networks:
      - vaultwarden

    healthcheck:
      test: ["CMD", "sh", "-c", "nc -z localhost 587 2>/dev/null"]
      interval: 120s
      timeout: 10s
      retries: 5
      start_period: 60s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - CHOWN              # Mail queue ownership
      - SETUID             # User switching
      - SETGID             # Group switching
      - NET_BIND_SERVICE   # Port 587
      - DAC_OVERRIDE       # Spool permission overrides (REQUIRED)
      - FOWNER             # Spool file ownership (REQUIRED)

    # LOG ROTATION: Postfix is low-volume (alert emails only).
    # 5m x 3 = 15MB worst-case.
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.1'
          pids: 50
        reservations:
          memory: 64M
          cpus: '0.02'

  # =============================================================================
  # Fail2Ban - Intrusion Prevention (HOST NETWORKING for SSH Protection)
  # =============================================================================
  fail2ban:
    container_name: vaultwarden_fail2ban
    image: crazymax/fail2ban:${FAIL2BAN_VERSION:-1.1.0}
    restart: unless-stopped

    # FIXED: Host networking mode to allow SSH iptables manipulation
    network_mode: host

    environment:
      TZ: ${TZ:-UTC}
      F2B_LOG_TARGET: STDOUT
      F2B_LOG_LEVEL: INFO
      F2B_DB_PURGE_AGE: 1d
      PACKAGES: whois
      F2B_DEST_MAIL: ${ADMIN_EMAIL}
      F2B_SENDER: fail2ban@${DOMAIN_NAME}
      CF_API_TOKEN_FILE: /run/secrets/fail2ban_cloudflare_firewall_token
      CF_ZONE_ID: ${CLOUDFLARE_ZONE_ID}

    secrets:
      - fail2ban_cloudflare_firewall_token

    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro

    cap_add:
      - NET_ADMIN  # Required for iptables manipulation
      - NET_RAW    # Required for raw socket access

    depends_on:
      - vaultwarden
      - caddy
      - postfix

    healthcheck:
      test: ["CMD", "fail2ban-client", "status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

    security_opt:
      - no-new-privileges:true

    # LOG ROTATION: Fail2Ban is low-volume (ban/unban events only).
    # 5m x 3 = 15MB worst-case.
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.15'
        reservations:
          memory: 128M
          cpus: '0.05'

# =============================================================================
# Docker Secrets Configuration
# =============================================================================
secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token
  fail2ban_cloudflare_firewall_token:
    file: ./secrets/.docker_secrets/fail2ban_cloudflare_firewall_token

# =============================================================================
# Network Configuration
# =============================================================================
networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge

# =============================================================================
# DEPLOYMENT NOTES - SECURITY HARDENED EDITION
# =============================================================================
#
# SECURITY ENHANCEMENTS APPLIED:
# ✅ Command injection protection (awk-based substitution in setup.sh)
# ✅ Docker secrets loaded via entrypoint (not exposed in command args)
# ✅ Reduced container capabilities (minimal privilege principle)
# ✅ Optimized resource limits (appropriate for <10 users on 6GB system)
# ✅ Enhanced security headers (CORS, COOP, CORP, COEP)
# ✅ Cloudflare WAF rate limiting (edge-based attack mitigation)
# ✅ Modern isolation headers (Spectre mitigation)
# ✅ Malicious user-agent blocking (scanner detection)
# ✅ Init container capability restriction (CHOWN + FOWNER only)
# ✅ Fail2Ban host networking for SSH protection (FIXED)
# ✅ Postfix capabilities hardened (6 caps: CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER — all others dropped)
# ✅ WebSocket support enabled by default
# ✅ Log rotation limits on all runtime services (disk-fill prevention)
#
# CRITICAL FIXES APPLIED:
# 1. Fail2Ban SSH Protection (FIXED):
#    - Moved to network_mode: host to enable SSH iptables manipulation
#    - SMTP action already configured for 127.0.0.1:587 (host-mode compatible)
#    - SSH jail can now properly ban attackers on host port 22
#
# 2. WebSocket Support (ENABLED):
#    - WEBSOCKET_ENABLED now defaults to true
#    - Caddy routing for /notifications/hub must be configured
#    - Enables real-time sync for VaultWarden clients
#
# 3. Postfix Capabilities (HARDENED):
#    - All capabilities dropped by default (cap_drop: ALL)
#    - Only required caps granted: CHOWN, SETUID, SETGID, NET_BIND_SERVICE,
#      DAC_OVERRIDE (spool permission overrides), FOWNER (spool file ownership)
#    - DAC_OVERRIDE and FOWNER are REQUIRED for correct mail spool operation
#    - KILL and all other capabilities remain dropped
#
# 4. Log Rotation (HARDENED):
#    - All runtime services now cap Docker json-file logs natively
#    - Worst-case total Docker log footprint: ~200MB on the 40GB SSD
#    - Sizing rationale:
#        caddy:       20m x 5 = 100MB  (one line per request - highest volume)
#        vaultwarden: 10m x 5 =  50MB  (warn-level only - low volume)
#        postfix:      5m x 3 =  15MB  (alert emails only - very low volume)
#        fail2ban:     5m x 3 =  15MB  (ban/unban events only - very low volume)
#    - bash maintenance.sh --comprehensive also rotates volume-mounted logs
#      as a secondary layer of defense
#
# CLOUDFLARE RATE LIMITING (REQUIRED):
# You MUST configure these WAF rules in Cloudflare Dashboard:
#
# Rule #1: Authentication Endpoint Protection
#   - Path: /identity/connect/token*, /api/accounts/prelogin*
#   - Limit: 10 requests per 1 minute per IP
#   - Action: Block (429 response)
#
# Rule #2: Admin Panel Protection
#   - Path: /admin*
#   - Limit: 5 requests per 1 minute per IP
#   - Action: Block (429 response)
#
# Rule #3: General API Protection (Optional)
#   - Path: /api/*
#   - Limit: 100 requests per 1 minute per IP
#   - Action: Managed Challenge (CAPTCHA)
#
# RESOURCE ALLOCATION (OPTIMIZED for <10 users on 6GB system):
# - VaultWarden: 512M limit / 128M reservation
# - Caddy: 512M limit / 128M reservation
# - Fail2Ban: 512M limit / 128M reservation
# - Postfix: 256M limit / 64M reservation (+ pids: 50)
# - Total limits: ~1.8GB (leaves 4.2GB for host OS and overhead)
# - Total reservations: ~448MB (ensures stable operation)
#
# FAIL2BAN HOST NETWORKING IMPLICATIONS:
# - Fail2Ban now shares host network namespace
# - Can directly manipulate host iptables for SSH protection
# - SMTP configured for 127.0.0.1:587 (already compatible)
# - Loses Docker DNS service resolution (not needed for this setup)
# - Cannot use networks: directive (mutually exclusive with network_mode: host)
#
# TESTING CHECKLIST:
# □ Verify Caddy starts without errors: docker compose logs caddy
# □ Test basic auth works: curl -u admin:password https://vault.domain.com/admin
# □ Verify secrets not in docker inspect: docker inspect vaultwarden_caddy | grep CLOUDFLARE
# □ Test Postfix mail delivery: ./maintenance.sh --test-email --verbose
# □ Test SSH ban works: Trigger 3 failed SSH attempts, verify iptables ban
# □ Verify Fail2Ban can send email via 127.0.0.1:587
# □ Test WebSocket sync: Enable in client, verify real-time notifications
# □ Verify Cloudflare rate limiting: Run 15 auth requests in 1 minute (should see 429)
# □ Check resource usage: docker stats (should be under limits)
# □ No init-permissions warnings: docker compose up -d (should be clean)
# □ Verify log caps active: docker inspect vaultwarden_app | grep -A5 LogConfig
#
# PLATFORM COMPATIBILITY:
# - SSH_LOG_PATH automatically detected by setup.sh
# - Debian/Ubuntu: /var/log/auth.log (default)
# - RHEL/CentOS/OCI: /var/log/secure (auto-detected)
# - Email: Fully containerized (no host dependencies)
#
# BACKUP ENCRYPTION KEY RECOVERY (CRITICAL):
# ⚠️  MANDATORY: Backup secrets/keys/age-key.txt to offline storage
# ⚠️  If lost, ALL encrypted backups are permanently unrecoverable
# ⚠️  Test key recovery quarterly (see docs/RECOVERY.md)
#
# POSTFIX CAPABILITY NOTES:
# The postfix service grants exactly 6 capabilities (all others dropped):
#   CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER
# DAC_OVERRIDE and FOWNER are required for mail spool access and must
# not be removed. If mail delivery fails, verify these are present:
#   docker inspect vaultwarden_postfix | grep -A20 CapAdd
# Expected hex value includes bits for all six capabilities above.
#
# =============================================================================
