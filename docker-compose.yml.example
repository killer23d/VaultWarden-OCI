# VaultWarden-OCI - Production Docker Compose Configuration (SECURITY HARDENED)
#
# D-05: Set project name to avoid conflicts with other Compose stacks on the same host.
# Override in .env: COMPOSE_PROJECT_NAME=vaultwarden
#
# SECURITY ENHANCEMENTS APPLIED:
# ✅ Cloudflare token loaded via entrypoint (no command-line exposure)
# ✅ Reduced container capabilities (minimal privilege)
# ✅ Optimized resource limits (appropriate for <10 users)
# ✅ Enhanced security headers and modern isolation
# ✅ Cloudflare WAF rate limiting (edge protection)
# ✅ Fail2Ban SSH protection via host networking (FIXED)
# ✅ Postfix capabilities hardened (CHOWN, SETUID, SETGID, NET_BIND_SERVICE, DAC_OVERRIDE, FOWNER only)
# ✅ Log rotation limits on all runtime services (disk-fill prevention)
# ✅ Init container uses find -exec chmod (glob-safe, no silent no-op on empty dirs)
# ✅ vaultwarden network marked internal: true (no unnecessary outbound access)
# ✅ caddy_external network for Caddy ACME + Cloudflare API egress only
# ✅ Secret files mode 444 inside mode-700 directory (all Docker Engine versions)
# ✅ fail2ban db directory root:root 755 (crazymax/fail2ban runs as root)
# ✅ BUG-EM1: SMTP_AUTH_MECHANISM empty + SMTP_EXPLICIT_TLS=false added to vaultwarden env
# ✅ BUG-EM2: Postfix host port restored as 127.0.0.1:587 loopback-only (host scripts use it)
# ✅ BUG-EM3: WEBSOCKET_ENABLED default hardened to true (was undefined → empty → disabled)
# ✅ BUG-EM4: Postfix added to caddy_external network (DNS + relay egress restored)
# ✅ BUG-EM5: SMTP_AUTH_MECHANISM set to empty string (not 'none' — invalid for VaultWarden)
# ✅ BUG-2:   caddy log dir chmod 755 (Caddy runs as root; 750 blocks write for non-owner)
# ✅ BUG-3A:  init container mkdir before chown (prevents Permission denied on /logs subdirs)
# ✅ BUG-3B:  caddy/entrypoint.sh committed with execute bit 0755 (fixes exec permission denied)
# ✅ BUG-caddy-perms-2: chmod 755 /logs/caddy set correctly
# ✅ BUG-caddy-logfile-perms: access.log + security.log pre-created root:root 644
# ✅ BUG-init-exit1: all caddy log file ops use || true so init never exits 1
# ✅ BUG-caddy-data-perms: removed find /caddy_data + /caddy_config chown PUID:PGID from init.
#              Caddy runs as user: root — chowning its data/config to PUID:PGID made Caddy
#              a non-owner on its own dirs, causing cert key permission denied.
# ✅ BUG-entrypoint-exec: entrypoint.sh must be mode 0755; a blanket 'find -exec chmod 644'
#              on the repo working tree strips the execute bit → runc EPERM at container init.
# ✅ BUG-caddy-log-order: logs/caddy setup runs BEFORE find /logs sweep.
# ✅ BUG-init-dac-override: init container was missing DAC_OVERRIDE capability.
#              Without DAC_OVERRIDE, chmod() on a file/dir not owned by the calling process
#              fails EPERM unconditionally. After `chown -R PUID:PGID /logs` transferred
#              /logs/caddy to ubuntu:ubuntu, container root could no longer chmod it.
#              The `|| true` swallowed the error → caddy dir stayed 750 → touch failed
#              in entrypoint → caddy restart loop. Fix: add DAC_OVERRIDE to cap_add.
# ✅ FIX-busybox-version: init container image tag driven by BUSYBOX_VERSION in .env
#              (previously hardcoded busybox:1.36.1 — bypassed the version-pin system).
# ✅ FIX-push-secrets-optional: push_installation_id / push_installation_key marked
#              required: false — Compose skips mounting absent secret files instead of
#              aborting; eliminates 'secret not found' log noise on deployments where
#              PUSH_ENABLED=false (the default for ~95% of installs).
# ✅ FIX-domain-single-source: caddy service passes DOMAIN (not DOMAIN_NAME); the
#              entrypoint derives DOMAIN_NAME=${DOMAIN#https://} at runtime so operators
#              only set one variable. fail2ban F2B_SENDER uses ${F2B_SENDER} (literal
#              value in .env) — Docker Compose does not expand ${VAR} in .env files.

services:
  # =============================================================================
  # Init Container - Permissions Setup
  # =============================================================================
  init-permissions:
    image: busybox:${BUSYBOX_VERSION:-1.36.1}
    container_name: vaultwarden_init
    restart: "no"
    user: "0:0"  # Required for chown/chmod operations

    cap_drop:
      - ALL
    cap_add:
      - CHOWN       # chown files/dirs to PUID:PGID and root:root
      - FOWNER      # bypass permission checks when process UID != file owner UID for some ops
      - DAC_OVERRIDE  # bypass DAC checks — required to chmod files/dirs after chown transfers
                      # ownership away from root (without this, chmod on ubuntu-owned dirs = EPERM)

    security_opt:
      - no-new-privileges:true

    # ---------------------------------------------------------------------------
    # OWNERSHIP MODEL
    # ---------------------------------------------------------------------------
    #
    # No userns-remap on this host: container UID 0 = host UID 0 = real root.
    # Verified via: cat /proc/self/uid_map  =>  0  0  4294967295
    #
    # Each service runs as a specific UID; that UID must own its writable dirs:
    #
    #   /data, /logs/*          → PUID:PGID mode 750/640  (vaultwarden app user)
    #   /logs/caddy             → dir: mode 755 (Caddy=root needs execute+write as 'other')
    #                             files: root:root mode 644 (Caddy creates and writes these)
    #   /caddy_data, /caddy_config → NOT TOUCHED (Caddy=root owns these on host; host setup.sh
    #                             pre-creates them as root:root 755)
    #   /fail2ban_db            → root:root 755  (fail2ban runs as root)
    #   /secrets                → mode 700/444   (secrets hardening)
    #
    # WHY DAC_OVERRIDE IS REQUIRED:
    #   The init command does: chown -R PUID:PGID /logs
    #   After this, /logs/caddy is owned by ubuntu:ubuntu.
    #   chmod 755 /logs/caddy then fails EPERM without DAC_OVERRIDE
    #   because the calling process (UID 0) is not the file owner (ubuntu).
    #   DAC_OVERRIDE grants bypass of all DAC permission checks, making
    #   chmod work regardless of ownership. This is a minimal, scoped grant
    #   on a short-lived init-only container with no network access.
    # ---------------------------------------------------------------------------
    command: sh -c "
      mkdir -p /data /logs/vaultwarden /logs/caddy /logs/fail2ban /logs/postfix &&

      touch /logs/caddy/access.log /logs/caddy/security.log &&
      chown 0:0 /logs/caddy/access.log /logs/caddy/security.log &&
      chmod 644 /logs/caddy/access.log /logs/caddy/security.log &&

      chown -R ${PUID}:${PGID} /data /logs &&
      find /data -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /data -type f -exec chmod 640 {} + 2>/dev/null || true &&
      find /logs -type d -exec chmod 750 {} + 2>/dev/null || true &&
      find /logs -path '*/caddy' -prune -o -type f -exec chmod 640 {} + 2>/dev/null || true &&

      chmod 755 /logs/caddy &&
      chown 0:0 /logs/caddy/access.log /logs/caddy/security.log &&
      chmod 644 /logs/caddy/access.log /logs/caddy/security.log &&

      mkdir -p /fail2ban_db &&
      chown 0:0 /fail2ban_db &&
      chmod 755 /fail2ban_db &&
      chmod 700 /secrets /secrets/.docker_secrets 2>/dev/null || true &&
      find /secrets/.docker_secrets -type f -exec chmod 444 {} + 2>/dev/null || true &&
      echo 'Init container completed - permissions set to ${PUID}:${PGID}'
      "

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs:/logs
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/caddy_data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/caddy_config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/fail2ban_db
      - ${PWD}/secrets:/secrets

  # =============================================================================
  # VaultWarden - Main Application
  # =============================================================================
  vaultwarden:
    container_name: vaultwarden_app
    image: ghcr.io/dani-garcia/vaultwarden:${VAULTWARDEN_VERSION:-1.35.4}
    restart: unless-stopped
    user: "${PUID}:${PGID}"

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      DOMAIN: ${DOMAIN}
      ADMIN_TOKEN_FILE: /run/secrets/admin_token
      TZ: ${TZ:-UTC}
      LOG_FILE: /logs/vaultwarden.log
      LOG_LEVEL: warn
      EXTENDED_LOGGING: true
      SIGNUPS_ALLOWED: ${SIGNUPS_ALLOWED:-false}
      INVITATIONS_ALLOWED: ${INVITATIONS_ALLOWED:-true}
      EMERGENCY_ACCESS_ALLOWED: ${EMERGENCY_ACCESS_ALLOWED:-true}
      SENDS_ALLOWED: ${SENDS_ALLOWED:-true}
      WEB_VAULT_ENABLED: ${WEB_VAULT_ENABLED:-true}
      WEBSOCKET_ENABLED: "true"
      PUSH_ENABLED: ${PUSH_ENABLED:-false}
      PASSWORD_ITERATIONS: ${PASSWORD_ITERATIONS:-600000}
      PASSWORD_HINTS_ALLOWED: ${PASSWORD_HINTS_ALLOWED:-false}
      SHOW_PASSWORD_HINT: ${SHOW_PASSWORD_HINT:-false}
      IP_HEADER: CF-Connecting-IP
      SMTP_HOST: ${VW_SMTP_HOST:-postfix}
      SMTP_PORT: ${VW_SMTP_PORT:-587}
      SMTP_SECURITY: ${VW_SMTP_SECURITY:-off}
      SMTP_EXPLICIT_TLS: ${VW_SMTP_EXPLICIT_TLS:-false}
      SMTP_AUTH_MECHANISM:
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_FROM_NAME: ${SMTP_FROM_NAME:-VaultWarden}
      SMTP_TIMEOUT: ${SMTP_TIMEOUT:-15}
      PUSH_RELAY_URI: ${PUSH_RELAY_URI:-https://push.bitwarden.com}
      PUSH_IDENTITY_URI: ${PUSH_IDENTITY_URI:-https://identity.bitwarden.com}
      PUSH_INSTALLATION_ID_FILE: /run/secrets/push_installation_id
      PUSH_INSTALLATION_KEY_FILE: /run/secrets/push_installation_key
      DATABASE_MAX_CONNS: ${DATABASE_MAX_CONNS:-10}
      WEB_VAULT_FOLDER: web-vault/

    secrets:
      - admin_token
      - push_installation_id
      - push_installation_key

    volumes:
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/logs

    networks:
      - vaultwarden
      - caddy_external

    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1/alive"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
      - /run:size=16m,mode=0755

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
      nproc:
        soft: 512
        hard: 512

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.3'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Caddy - Reverse Proxy with SSL Termination
  # =============================================================================
  caddy:
    container_name: vaultwarden_caddy
    image: ghcr.io/caddybuilds/caddy-cloudflare:${CADDY_VERSION:-2.11.1}
    restart: unless-stopped
    user: root

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    entrypoint: /scripts/entrypoint.sh

    environment:
      # DOMAIN_NAME is derived from DOMAIN inside caddy/entrypoint.sh
      # (strips the https:// prefix). Pass DOMAIN as the canonical source.
      DOMAIN: ${DOMAIN}
      TZ: ${TZ:-UTC}

    # ---------------------------------------------------------------------------
    # DNS-01 ACME token — REQUIRED for TLS certificate issuance
    # ---------------------------------------------------------------------------
    # caddy_cloudflare_dns_token is the Cloudflare API token Caddy uses to
    # complete DNS-01 ACME challenges and obtain/renew TLS certificates for
    # DOMAIN. Without it, Caddy cannot issue a certificate and will either
    # fail to start or enter a restart loop with no obvious error message.
    #
    # The token is NOT an environment variable — it is injected as a Docker
    # secret at runtime (see the secrets: block at the bottom of this file).
    # Do NOT paste the token value anywhere in this file or in .env.
    #
    # To provision:  make edit-secrets  (or: ./edit-secrets.sh --rotate cloudflare_dns_token)
    #
    # Required Cloudflare API token permissions:
    #   Zone → DNS → Edit     (for the zone containing DOMAIN)
    #   Zone → Zone → Read    (zone listing, required by the ACME DNS plugin)
    #
    # See also: CADDY_CF_DNS_TOKEN comment in .env.example
    # ---------------------------------------------------------------------------
    secrets:
      - caddy_cloudflare_dns_token
      - admin_basic_auth_hash

    volumes:
      - ${PWD}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${PWD}/caddy/entrypoint.sh:/scripts/entrypoint.sh:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/data:/data
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/caddy/config:/config
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy

    ports:
      - "80:80"
      - "443:443"
      - "127.0.0.1:8080:8080"

    networks:
      - vaultwarden
      - caddy_external

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/alive"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - NET_BIND_SERVICE

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
      nproc:
        soft: 512
        hard: 512

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.25'
        reservations:
          memory: 128M
          cpus: '0.1'

  # =============================================================================
  # Postfix - Email Relay
  # =============================================================================
  postfix:
    container_name: vaultwarden_postfix
    image: boky/postfix:${POSTFIX_VERSION:-4.3.0}
    restart: unless-stopped

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      - TZ=${TZ:-UTC}
      - ALLOWED_SENDER_DOMAINS=${ALLOWED_SENDER_DOMAINS:-}
      - RELAYHOST=${SMTP_HOST}:${SMTP_PORT}
      - RELAYHOST_USERNAME=${SMTP_USERNAME}
      - RELAYHOST_PASSWORD_FILE=/run/secrets/smtp_password
      - POSTFIX_myhostname=${POSTFIX_MYHOSTNAME:-postfix}
      - POSTFIX_smtp_tls_security_level=${POSTFIX_SMTP_TLS_SECURITY_LEVEL:-encrypt}
      - POSTFIX_message_size_limit=${POSTFIX_MESSAGE_SIZE_LIMIT:-10240000}

    secrets:
      - smtp_password

    ports:
      - "127.0.0.1:587:587"

    networks:
      - vaultwarden
      - caddy_external

    healthcheck:
      test: ["CMD", "sh", "-c", "nc -z localhost 587 2>/dev/null"]
      interval: 120s
      timeout: 10s
      retries: 5
      start_period: 60s

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - NET_BIND_SERVICE
      - DAC_OVERRIDE
      - FOWNER

    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.1'
          pids: 50
        reservations:
          memory: 64M
          cpus: '0.02'

  # =============================================================================
  # Fail2Ban - Intrusion Prevention
  # =============================================================================
  fail2ban:
    container_name: vaultwarden_fail2ban
    image: crazymax/fail2ban:${FAIL2BAN_VERSION:-1.1.0-r3}
    restart: unless-stopped
    network_mode: host

    depends_on:
      init-permissions:
        condition: service_completed_successfully

    environment:
      TZ: ${TZ:-UTC}
      F2B_LOG_TARGET: STDOUT
      F2B_LOG_LEVEL: INFO
      F2B_DB_PURGE_AGE: 1d
      PACKAGES: whois
      F2B_DEST_MAIL: ${ADMIN_EMAIL}
      # F2B_SENDER is a literal value set in .env — Docker Compose does not
      # expand ${VAR} in .env files, so it must be an explicit literal there.
      # Example: F2B_SENDER=fail2ban@vault.example.com
      F2B_SENDER: ${F2B_SENDER}
      CF_API_TOKEN_FILE: /run/secrets/fail2ban_cloudflare_firewall_token
      CF_ZONE_ID: ${CLOUDFLARE_ZONE_ID}

    secrets:
      - fail2ban_cloudflare_firewall_token

    volumes:
      - ${PWD}/fail2ban:/data/fail2ban:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/fail2ban:/data/db
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/fail2ban:/var/log/fail2ban
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/vaultwarden:/var/log/vaultwarden:ro
      - ${PROJECT_STATE_DIR:-/var/lib/vaultwarden}/logs/caddy:/var/log/caddy:ro
      - ${SSH_LOG_PATH:-/var/log/secure}:/var/log/ssh-auth.log:ro

    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
      - NET_RAW

    healthcheck:
      test: ["CMD-SHELL", "fail2ban-client ping 2>/dev/null | grep -q pong || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

    security_opt:
      - no-new-privileges:true

    logging:
      driver: "json-file"
      options:
        max-size: "5m"
        max-file: "3"

    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.15'
        reservations:
          memory: 64M
          cpus: '0.05'

# =============================================================================
# Docker Secrets
# =============================================================================
secrets:
  admin_token:
    file: ./secrets/.docker_secrets/admin_token
  admin_basic_auth_hash:
    file: ./secrets/.docker_secrets/admin_basic_auth_hash
  smtp_password:
    file: ./secrets/.docker_secrets/smtp_password
  push_installation_id:
    file: ./secrets/.docker_secrets/push_installation_id
    required: false  # absent by default; Compose skips mount when PUSH_ENABLED=false
  push_installation_key:
    file: ./secrets/.docker_secrets/push_installation_key
    required: false  # absent by default; Compose skips mount when PUSH_ENABLED=false
  caddy_cloudflare_dns_token:
    file: ./secrets/.docker_secrets/caddy_cloudflare_dns_token
  fail2ban_cloudflare_firewall_token:
    file: ./secrets/.docker_secrets/fail2ban_cloudflare_firewall_token

# =============================================================================
# Networks
# =============================================================================
networks:
  vaultwarden:
    name: vaultwarden_network
    driver: bridge
    internal: true

  caddy_external:
    name: caddy_external_network
    driver: bridge
